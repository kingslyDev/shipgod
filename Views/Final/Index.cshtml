@model ShipmentFinishGood.DTOs.FinalTableDto
@{
    ViewData["Title"] = "Final Table - " + Model.FileName;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-success">
            <i class="fas fa-table me-2"></i>Final Table - @Model.FileName
        </h2>
        <div class="btn-group">
            @if (!Model.HasQRGenerated)
            {
                <form asp-action="GenerateQR" method="post" class="d-inline">
                    <input type="hidden" name="sessionId" value="@Model.SessionId" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-qrcode me-2"></i>Generate QR Identity
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="QR" asp-action="Manage" asp-route-id="@Model.SessionId" class="btn btn-info">
                    <i class="fas fa-qrcode me-2"></i>Manage QR Codes
                </a>
            }
            <a asp-controller="PO" asp-action="Preview" asp-route-id="@Model.SessionId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Preview
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Session Info -->
    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Session Information</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <small class="text-muted">File Name:</small>
                            <div class="fw-bold">@Model.FileName</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Shipment Type:</small>
                            <div class="fw-bold">
                                <span class="badge bg-primary">@Model.ShipmentType</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-sm-6">
                            <small class="text-muted">Shipment Date:</small>
                            <div class="fw-bold">@(Model.ShipmentDate?.ToString("dd/MM/yyyy") ?? "Not set")</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Status:</small>
                            <div class="fw-bold">
                                <span class="badge bg-success">@Model.Status</span>
                            </div>
                        </div>
                    </div>
                    @if (Model.HasQRGenerated)
                    {
                        <div class="row mt-2">
                            <div class="col-12">
                                <small class="text-muted">QR Identity:</small>
                                <div class="fw-bold text-primary">@Model.QRIdentity</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Summary</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-3">
                            <h4 class="text-primary mb-1" id="totalRows">@Model.FinalData.Count</h4>
                            <small class="text-muted">Total Rows</small>
                        </div>
                        <div class="col-3">
                            <h4 class="text-success mb-1" id="totalPallets">@Model.FinalData.Sum(f => f.QtyPallet)</h4>
                            <small class="text-muted">Pallets</small>
                        </div>
                        <div class="col-3">
                            <h4 class="text-warning mb-1" id="totalBoxes">@Model.FinalData.Sum(f => f.QtyBox)</h4>
                            <small class="text-muted">Boxes</small>
                        </div>
                        <div class="col-3">
                            <h4 class="text-info mb-1" id="totalPcs">@Model.FinalData.Sum(f => f.QtyPcs)</h4>
                            <small class="text-muted">PCS</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Row Modal -->
    <div class="modal fade" id="addRowModal" tabindex="-1" aria-labelledby="addRowModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRowModalLabel">
                        <i class="fas fa-plus me-2"></i>Add New Row
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addRowForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newNoPO" class="form-label">No PO</label>
                                    <input type="text" class="form-control" id="newNoPO" placeholder="Enter PO Number" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newModel" class="form-label">Model</label>
                                    <input type="text" class="form-control" id="newModel" placeholder="Enter Model" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newTotalQty" class="form-label">Total Qty</label>
                                    <input type="number" class="form-control" id="newTotalQty" min="1" placeholder="Enter Quantity" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newContainer" class="form-label">Container</label>
                                    <input type="text" class="form-control" id="newContainer" placeholder="Container Info">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newNoInvoice" class="form-label">Invoice</label>
                                    <input type="text" class="form-control" id="newNoInvoice" placeholder="Invoice Number">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="newShipmentDetail" class="form-label">Shipment Detail</label>
                                    <input type="text" class="form-control" id="newShipmentDetail" placeholder="Shipment Details">
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Auto Generate:</strong> Barcode will be automatically generated based on SmartBarcode pattern when you add this row.
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="addNewRow()">
                        <i class="fas fa-plus me-2"></i>Add Row & Generate Barcode
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Final Data Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Final Processed Data</h5>
            <div>
                <button type="button" class="btn btn-sm btn-primary me-2" onclick="showAddRowModal()">
                    <i class="fas fa-plus me-2"></i>Add Row
                </button>
                <button type="button" class="btn btn-sm btn-success me-2" onclick="saveAllMetadata()">
                    <i class="fas fa-save me-2"></i>Save All Metadata
                </button>
                <button type="button" class="btn btn-sm btn-info" onclick="debugBarcodes()">
                    <i class="fas fa-bug me-2"></i>Debug Barcodes
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="finalTable">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;">No PO</th>
                            <th style="width: 130px;">Model</th>
                            <th style="width: 90px;">Total Qty</th>
                            <th style="width: 70px;">Pallet</th>
                            <th style="width: 70px;">Box</th>
                            <th style="width: 70px;">PCS</th>
                            <th style="width: 120px;">Invoice</th>
                            <th style="width: 120px;">Container</th>
                            <th style="width: 150px;">Shipment Detail</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="finalTableBody">
                        @for (int i = 0; i < Model.FinalData.Count; i++)
                        {
                            var row = Model.FinalData[i];
                            <tr data-row-index="@row.RowIndex" class="@(row.IsEditable ? "editable-row" : "")">
                                <td>
                                    <span class="fw-bold">@row.NoPO</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@row.Model</span>
                                </td>
                                <td>
                                    @if (row.IsEditable)
                                    {
                                        <input type="number" class="form-control form-control-sm qty-input" 
                                               value="@row.TotalQty" min="0" data-field="totalQty" 
                                               onchange="smartUpdateRow(@row.RowIndex)" />
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-primary">@row.TotalQty.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success qty-pallet">@row.QtyPallet</span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark qty-box">@row.QtyBox</span>
                                </td>
                                <td>
                                    <span class="badge bg-info qty-pcs">@row.QtyPcs</span>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm metadata-input" 
                                           value="@row.NoInvoice" placeholder="Invoice..." data-field="noInvoice" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm metadata-input" 
                                           value="@row.Container" placeholder="Container..." data-field="container" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm metadata-input" 
                                           value="@row.ShipmentDetail" placeholder="Detail..." data-field="shipmentDetail" />
                                </td>
                                <td>
                                    @if (row.IsEditable)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary update-row-btn" 
                                                onclick="updateRow(@row.RowIndex)">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-lock"></i>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        const sessionId = @Model.SessionId;
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // 🧠 SMART AUTO-CALCULATION ENGINE
        async function smartUpdateRow(rowIndex) {
            const row = document.querySelector(`tr[data-row-index="${rowIndex}"]`);
            const totalQtyInput = row.querySelector('[data-field="totalQty"]');
            
            // Get values
            const newTotalQty = parseInt(totalQtyInput.value) || 0;
            const container = row.querySelector('[data-field="container"]').value;
            const noInvoice = row.querySelector('[data-field="noInvoice"]').value;
            const shipmentDetail = row.querySelector('[data-field="shipmentDetail"]').value;

            // Show smart loading
            showSmartLoading(rowIndex, true);

            try {
                const response = await fetch('/Final/SmartUpdate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        rowIndex: rowIndex,
                        request: {
                            newTotalQty: newTotalQty,
                            container: container,
                            noInvoice: noInvoice,
                            shipmentDetail: shipmentDetail
                        }
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    // ✅ SMART UPDATE SUCCESS
                    updateRowDisplay(row, result.data);
                    showSmartNotifications(result.notifications);
                    updateSummary();
                    
                    // 📦 BARCODE CHANGE NOTIFICATIONS
                    if (result.barcodeChanges.added > 0) {
                        showBarcodeAlert(`🆕 Added ${result.barcodeChanges.added} new barcodes`, 'info');
                    }
                    if (result.barcodeChanges.removed > 0) {
                        showBarcodeAlert(`🗑️ Removed ${result.barcodeChanges.removed} barcodes (highest numbers)`, 'warning');
                    }
                    
                    // 🧠 CALCULATION STRATEGY INFO
                    console.log(`Smart Engine: ${result.metadata.calculationStrategy}`);
                    
                } else {
                    showAlert(result.message || 'Failed to update row', 'danger');
                }
            } catch (error) {
                showAlert('Smart Engine Error: ' + error.message, 'danger');
            } finally {
                showSmartLoading(rowIndex, false);
            }
        }

        // 📱 SMART UI FUNCTIONS
        function updateRowDisplay(row, data) {
            // Update breakdown displays with animation
            const palletBadge = row.querySelector('.qty-pallet');
            const boxBadge = row.querySelector('.qty-box');
            const pcsBadge = row.querySelector('.qty-pcs');
            
            animateValueChange(palletBadge, data.qtyPallet);
            animateValueChange(boxBadge, data.qtyBox);
            animateValueChange(pcsBadge, data.qtyPcs);
        }

        function animateValueChange(element, newValue) {
            element.style.transition = 'all 0.3s ease';
            element.style.transform = 'scale(1.1)';
            element.textContent = newValue;
            
            setTimeout(() => {
                element.style.transform = 'scale(1)';
            }, 300);
        }

        function showSmartLoading(rowIndex, isLoading) {
            const row = document.querySelector(`tr[data-row-index="${rowIndex}"]`);
            const qtyInput = row.querySelector('[data-field="totalQty"]');
            
            if (isLoading) {
                qtyInput.style.borderColor = '#007bff';
                qtyInput.style.background = 'linear-gradient(45deg, #f8f9fa, #e9ecef)';
                qtyInput.disabled = true;
            } else {
                qtyInput.style.borderColor = '#28a745';
                qtyInput.style.background = '#ffffff';
                qtyInput.disabled = false;
                
                setTimeout(() => {
                    qtyInput.style.borderColor = '#ced4da';
                }, 2000);
            }
        }

        function showSmartNotifications(notifications) {
            notifications.forEach((notification, index) => {
                setTimeout(() => {
                    showAlert(notification, 'success', 4000);
                }, index * 500);
            });
        }

        function showBarcodeAlert(message, type, duration = 3000) {
            const alertContainer = document.querySelector('.container-fluid');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show smart-alert`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-qrcode me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, duration);
        }

        // 🔄 LEGACY SUPPORT (Fallback to old method)
        async function updateRow(rowIndex) {
            console.warn('Using legacy update method. Consider using smartUpdateRow for better performance.');
            
            const row = document.querySelector(`tr[data-row-index="${rowIndex}"]`);
            const updateBtn = row.querySelector('.update-row-btn');
            
            // Get values
            const totalQty = parseInt(row.querySelector('[data-field="totalQty"]').value) || 0;
            const container = row.querySelector('[data-field="container"]').value;
            const noInvoice = row.querySelector('[data-field="noInvoice"]').value;
            const shipmentDetail = row.querySelector('[data-field="shipmentDetail"]').value;

            // Show loading
            updateBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            updateBtn.disabled = true;

            try {
                const response = await fetch('/Final/UpdateRow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        rowIndex: rowIndex,
                        request: {
                            totalQty: totalQty,
                            container: container,
                            noInvoice: noInvoice,
                            shipmentDetail: shipmentDetail
                        }
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    // Update breakdown displays
                    row.querySelector('.qty-pallet').textContent = result.data.qtyPallet;
                    row.querySelector('.qty-box').textContent = result.data.qtyBox;
                    row.querySelector('.qty-pcs').textContent = result.data.qtyPcs;
                    
                    // Update summary
                    updateSummary();
                    
                    // Show success feedback
                    showAlert('Row updated successfully!', 'success');
                } else {
                    showAlert(result.message || 'Failed to update row', 'danger');
                }
            } catch (error) {
                showAlert('Error updating row: ' + error.message, 'danger');
            } finally {
                // Reset button
                updateBtn.innerHTML = '<i class="fas fa-sync-alt"></i>';
                updateBtn.disabled = false;
            }
        }

        async function saveAllMetadata() {
            const metadata = [];
            const rows = document.querySelectorAll('#finalTableBody tr');

            rows.forEach((row, index) => {
                const rowIndex = parseInt(row.getAttribute('data-row-index'));
                metadata.push({
                    rowIndex: rowIndex,
                    container: row.querySelector('[data-field="container"]').value,
                    noInvoice: row.querySelector('[data-field="noInvoice"]').value,
                    shipmentDetail: row.querySelector('[data-field="shipmentDetail"]').value
                });
            });

            try {
                const response = await fetch('/Final/SaveMetadata', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        metadata: metadata
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    showAlert('All metadata saved successfully!', 'success');
                } else {
                    showAlert(result.message || 'Failed to save metadata', 'danger');
                }
            } catch (error) {
                showAlert('Error saving metadata: ' + error.message, 'danger');
            }
        }

        function updateSummary() {
            let totalPallets = 0, totalBoxes = 0, totalPcs = 0;
            
            document.querySelectorAll('#finalTableBody tr').forEach(row => {
                totalPallets += parseInt(row.querySelector('.qty-pallet').textContent) || 0;
                totalBoxes += parseInt(row.querySelector('.qty-box').textContent) || 0;
                totalPcs += parseInt(row.querySelector('.qty-pcs').textContent) || 0;
            });

            document.getElementById('totalPallets').textContent = totalPallets.toLocaleString();
            document.getElementById('totalBoxes').textContent = totalBoxes.toLocaleString();
            document.getElementById('totalPcs').textContent = totalPcs.toLocaleString();
        }

        function showAlert(message, type, duration = 5000) {
            const alertContainer = document.querySelector('.container-fluid');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, duration);
        }

        // Add input validation and auto-format
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.qty-input').forEach(input => {
                input.addEventListener('change', function() {
                    if (this.value < 0) this.value = 0;
                });
            });
        });

        // 🔍 DEBUG FUNCTION
        async function debugBarcodes() {
            try {
                // Get first model from table
                const firstRow = document.querySelector('#finalTableBody tr');
                if (!firstRow) {
                    alert('No data found');
                    return;
                }
                
                const modelName = firstRow.querySelector('.badge.bg-primary').textContent;
                
                const response = await fetch(`/Final/DebugBarcodes?sessionId=${sessionId}&modelName=${encodeURIComponent(modelName)}`);
                const result = await response.json();
                
                if (result.success) {
                    console.log('🔍 BARCODE DEBUG INFO:');
                    console.log(result.debugInfo);
                    alert('Debug info logged to console. Check browser developer tools.');
                } else {
                    alert('Debug failed: ' + result.message);
                }
            } catch (error) {
                alert('Debug error: ' + error.message);
            }
        }

        // 🆕 ADD ROW FUNCTIONALITY
        function showAddRowModal() {
            // Reset form
            document.getElementById('addRowForm').reset();
            
            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('addRowModal'));
            modal.show();
        }

        async function addNewRow() {
            // Get form values
            const noPO = document.getElementById('newNoPO').value.trim();
            const model = document.getElementById('newModel').value.trim();
            const totalQty = parseInt(document.getElementById('newTotalQty').value) || 0;
            const container = document.getElementById('newContainer').value.trim();
            const noInvoice = document.getElementById('newNoInvoice').value.trim();
            const shipmentDetail = document.getElementById('newShipmentDetail').value.trim();

            // Validation
            if (!noPO || !model || totalQty <= 0) {
                showAlert('Please fill in required fields: No PO, Model, and Total Qty', 'warning');
                return;
            }

            // Show loading
            const addButton = document.querySelector('#addRowModal .btn-primary');
            const originalText = addButton.innerHTML;
            addButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding...';
            addButton.disabled = true;

            try {
                const response = await fetch('/Final/AddRow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        request: {
                            totalQty: totalQty,
                            container: noPO, // Pass PO via container field temporarily
                            noInvoice: noInvoice || noPO,
                            shipmentDetail: model // Pass model via shipmentDetail field temporarily
                        }
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    // ✅ SUCCESS - Add new row to table
                    addRowToTable(result.data, noPO, model);
                    
                    // Update summary
                    updateSummary();
                    
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addRowModal'));
                    modal.hide();
                    
                    // Show success with barcode info
                    showAlert(`Row added successfully! Barcode automatically generated with SmartBarcode pattern.`, 'success');
                    
                } else {
                    showAlert(result.message || 'Failed to add row', 'danger');
                }
            } catch (error) {
                showAlert('Error adding row: ' + error.message, 'danger');
            } finally {
                // Reset button
                addButton.innerHTML = originalText;
                addButton.disabled = false;
            }
        }

        function addRowToTable(rowData, noPO, model) {
            const tableBody = document.getElementById('finalTableBody');
            const newRow = document.createElement('tr');
            newRow.setAttribute('data-row-index', rowData.rowIndex);
            newRow.className = rowData.isEditable ? 'editable-row' : '';
            
            // Get original form values for display
            const originalContainer = document.getElementById('newContainer').value.trim();
            const originalShipmentDetail = document.getElementById('newShipmentDetail').value.trim();
            
            newRow.innerHTML = `
                <td>
                    <span class="fw-bold">${noPO}</span>
                </td>
                <td>
                    <span class="badge bg-primary">${model}</span>
                </td>
                <td>
                    ${rowData.isEditable ? 
                        `<input type="number" class="form-control form-control-sm qty-input" 
                                value="${rowData.totalQty}" min="0" data-field="totalQty" 
                                onchange="smartUpdateRow(${rowData.rowIndex})" />` :
                        `<span class="fw-bold text-primary">${rowData.totalQty.toLocaleString()}</span>`
                    }
                </td>
                <td>
                    <span class="badge bg-success qty-pallet">${rowData.qtyPallet}</span>
                </td>
                <td>
                    <span class="badge bg-warning text-dark qty-box">${rowData.qtyBox}</span>
                </td>
                <td>
                    <span class="badge bg-info qty-pcs">${rowData.qtyPcs}</span>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm metadata-input" 
                           value="${rowData.noInvoice || ''}" placeholder="Invoice..." data-field="noInvoice" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm metadata-input" 
                           value="${originalContainer || ''}" placeholder="Container..." data-field="container" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm metadata-input" 
                           value="${originalShipmentDetail || ''}" placeholder="Detail..." data-field="shipmentDetail" />
                </td>
                <td>
                    ${rowData.isEditable ? 
                        `<button type="button" class="btn btn-sm btn-outline-primary update-row-btn" 
                                onclick="updateRow(${rowData.rowIndex})">
                            <i class="fas fa-sync-alt"></i>
                        </button>` :
                        `<span class="text-muted">
                            <i class="fas fa-lock"></i>
                        </span>`
                    }
                </td>
            `;
            
            // Add to table
            tableBody.appendChild(newRow);
            
            // Animate new row
            newRow.style.backgroundColor = '#d1ecf1';
            setTimeout(() => {
                newRow.style.backgroundColor = '';
            }, 2000);
        }
    </script>
}
