<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sistem Informasi Pengiriman Barang" />
    <meta name="author" content="ShipmentFinishGood" />
    <title>@ViewData["Title"] - Sistem Informasi Pengiriman</title>
    
    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"  />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShipmentFinishGood.styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-shipping-fast me-2"></i>
                    <span>Finish Good Systems</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home me-1"></i>Dashboard
                                </a>
                            </li>
                            
                            @if (User.IsInRole("Manajemen"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Shipping" asp-action="Dashboard">
                                        <i class="fas fa-ship me-1"></i>Shipping
                                    </a>
                                </li>
                            }
                            
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PO" asp-action="Index">
                                    <i class="fas fa-list me-1"></i>Purchase Orders
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="QR" asp-action="Index">
                                    <i class="fas fa-qrcode me-1"></i>QR Management
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Scan" asp-action="Index">
                                    <i class="fas fa-barcode me-1"></i>Scanning
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i>
                                    <span class="d-none d-md-inline">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">@User.Identity.Name</h6></li>
                                    <li><small class="dropdown-item-text text-muted">Role: @User.Claims.FirstOrDefault(c=>c.Type==System.Security.Claims.ClaimTypes.Role)?.Value</small></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <!-- Removed Profil and Pengaturan per user request -->
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container-fluid py-3">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                <p class="mb-0 fw-semibold text-light">
                    &copy; 2025 - PT. Panasonic Manufacturing Indonesia
                </p>
            </div>
        </div>
    </div>
</footer>


    <!-- Core JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
