@model ShipmentFinishGood.Models.ModelConfiguration
@{
    ViewData["Title"] = "Detail Model";
}
<div class="container py-4">
    <h2 class="mb-4 text-info"><i class="fas fa-eye me-2"></i>Detail Model Konfigurasi</h2>
    <dl class="row">
        <dt class="col-sm-3">Model</dt>
        <dd class="col-sm-9">@Model.ModelName</dd>
        <dt class="col-sm-3">Pcs/Pallet</dt>
        <dd class="col-sm-9">@Model.PcsPerPallet</dd>
        <dt class="col-sm-3">Pcs/Box</dt>
        <dd class="col-sm-9">@Model.PcsPerBox</dd>
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9"><span class="badge bg-@((Model.Type=="PALLET"?"primary":"secondary"))">@Model.Type</span></dd>
        <dt class="col-sm-3">Deskripsi</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.ConfigId" class="btn btn-warning me-2"><i class="fas fa-edit"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Kembali</a>
</div>
