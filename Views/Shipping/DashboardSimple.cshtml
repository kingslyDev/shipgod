@model ShipmentFinishGood.DTOs.ShippingDashboardDto

@{
    ViewBag.Title = "Executive Outbound Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Clean Executive Dashboard */
    .dashboard-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 10px;
        text-align: center;
    }

    .dashboard-title {
        font-size: 2.5rem;
        font-weight: 300;
        margin: 0;
    }

    .dashboard-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-top: 0.5rem;
    }

    /* Primary KPIs */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .kpi-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

    .kpi-card:hover {
        transform: translateY(-5px);
    }

    .kpi-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #667eea;
    }

    .kpi-value {
        font-size: 3rem;
        font-weight: 700;
        color: #2c3e50;
        margin: 0.5rem 0;
        line-height: 1;
    }

    .kpi-label {
        font-size: 1rem;
        color: #6c757d;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .kpi-trend {
        font-size: 0.9rem;
        margin-top: 0.5rem;
        font-weight: 600;
    }

    .trend-up { color: #28a745; }
    .trend-down { color: #dc3545; }

    /* Analytics Grid */
    .analytics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .chart-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        height: 400px;
    }

    .chart-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 1rem;
        text-align: center;
    }

    .chart-wrapper {
        height: 320px;
        position: relative;
    }

    /* Filters */
    .filters-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        align-items: end;
    }

    .filter-group label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: 0.5rem 0.75rem;
    }

    .btn {
        border-radius: 8px;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    /* Country Statistics */
    .stats-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .stats-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 1rem;
    }

    .table th {
        background-color: #f8f9fa;
        border-top: none;
        font-weight: 600;
        color: #495057;
        padding: 1rem 0.75rem;
    }

    .table td {
        padding: 0.75rem;
        vertical-align: middle;
    }

    .country-flag {
        width: 24px;
        height: 16px;
        margin-right: 8px;
        border-radius: 2px;
    }

    .progress-bar-container {
        background-color: #e9ecef;
        border-radius: 4px;
        height: 8px;
        overflow: hidden;
    }

    .progress-bar-fill {
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        height: 100%;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-title { font-size: 2rem; }
        .kpi-grid { grid-template-columns: 1fr; }
        .analytics-grid { grid-template-columns: 1fr; }
        .filters-grid { grid-template-columns: 1fr; }
        .chart-card { height: 300px; }
        .chart-wrapper { height: 220px; }
    }
</style>

<div class="container-fluid">
    <!-- Executive Header -->
    <div class="dashboard-header">
        <h1 class="dashboard-title">📊 Executive Outbound Dashboard</h1>
        <p class="dashboard-subtitle">Real-time shipping performance & analytics</p>
    </div>

    <!-- Date Range Filter -->
    <div class="filters-card">
        <form id="filterForm" method="get">
            <div class="filters-grid">
                <div class="filter-group">
                    <label>Start Date:</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="filter-group">
                    <label>End Date:</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <div class="filter-group">
                    <label>Model:</label>
                    <select name="selectedModel" class="form-control">
                        <option value="">All Models</option>
                        @if (Model?.AvailableModels != null)
                        {
                            @foreach (var modelName in Model.AvailableModels)
                            {
                                <option value="@modelName" selected="@(ViewBag.SelectedModel == modelName)">@modelName</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter"></i> Apply Filter
                    </button>
                </div>
                <div class="filter-group">
                    <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">
                        <i class="fas fa-times"></i> Clear
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Primary KPIs (Big Numbers) -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="fas fa-percentage"></i>
            </div>
            <div class="kpi-value" data-target="@((int)Model.TodayCompletionRate)">0</div>
            <div class="kpi-label">Today's Completion Rate</div>
            <div class="kpi-trend trend-up">+5% vs yesterday</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="fas fa-shipping-fast"></i>
            </div>
            <div class="kpi-value" data-target="@Model.TotalItemsShipped">0</div>
            <div class="kpi-label">Items Shipped Today</div>
            <div class="kpi-trend trend-up">+12% vs yesterday</div>
        </div>

    <!-- Active Scanners KPI removed as requested -->

        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="kpi-value">@Model.AverageLeadTime.ToString("F1")</div>
            <div class="kpi-label">Avg Lead Time (hrs)</div>
            <div class="kpi-trend trend-down">-0.3hrs vs target</div>
        </div>
    </div>

    <!-- Visual Analytics -->
    <div class="analytics-grid">
        <!-- Country Distribution -->
        <div class="chart-card">
            <div class="chart-title">🌍 Country Distribution</div>
            <div class="chart-wrapper">
                <canvas id="countryChart"></canvas>
            </div>
        </div>

        <!-- Hourly Progress -->
        <div class="chart-card">
            <div class="chart-title">📈 Hourly Scan Progress</div>
            <div class="chart-wrapper">
                <canvas id="hourlyChart"></canvas>
            </div>
        </div>

    <!-- Top Performing Scanners and Process Bottlenecks removed as requested -->
    </div>

    <!-- Country Statistics per Model -->
    <div class="stats-card">
        <div class="stats-title">📦 Shipping Statistics per Country & Model</div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Country</th>
                        <th>Model</th>
                        <th>Shipment Date</th>
                        <th>Total Shipped</th>
                        <th>Completion %</th>
                        <th>Avg Lead Time</th>
                        <th>Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.CountryModelStats != null && Model.CountryModelStats.Any())
                    {
                        @foreach (var stat in Model.CountryModelStats)
                        {
                            <tr>
                                <td>
                                    <span class="country-flag">🏳️</span>
                                    @stat.Country
                                </td>
                                <td>@stat.Model</td>
                                <td>@(stat.ShipmentDate.HasValue ? stat.ShipmentDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>@stat.TotalShipped.ToString("N0")</td>
                                <td>@stat.CompletionRate.ToString("F1")%</td>
                                <td>@stat.AvgLeadTime.ToString("F1")h</td>
                                <td>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill" style="width: @stat.CompletionRate%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No data available for selected period</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Executive Dashboard JavaScript
class ExecutiveDashboard {
    constructor() {
        this.charts = {};
        this.init();
    }

    init() {
        this.initKpiCounters();
        this.initCharts();
        this.initAutoRefresh();
    }

    // Animate KPI numbers (impressive for executives)
    initKpiCounters() {
        document.querySelectorAll('.kpi-value[data-target]').forEach(counter => {
            const target = parseInt(counter.getAttribute('data-target'));
            const duration = 2000;
            const step = target / (duration / 16);
            let current = 0;
            
            const updateCounter = () => {
                current += step;
                if (current < target) {
                    counter.textContent = Math.floor(current).toLocaleString();
                    requestAnimationFrame(updateCounter);
                } else {
                    counter.textContent = target.toLocaleString();
                }
            };
            
            updateCounter();
        });
    }

    // Initialize executive charts
    async initCharts() {
        await this.loadCountryChart();
        await this.loadHourlyChart();
        await this.loadScannersChart();
        await this.loadBottleneckChart();
    }

    async loadCountryChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=country');
            const data = await response.json();
            
            const ctx = document.getElementById('countryChart').getContext('2d');
            this.charts.country = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.data,
                        backgroundColor: [
                            '#667eea', '#764ba2', '#f093fb', '#f5576c',
                            '#4facfe', '#00f2fe', '#43e97b', '#38f9d7'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                font: { size: 12 }
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading country chart:', error);
        }
    }

    async loadHourlyChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=hourly');
            const data = await response.json();
            
            const ctx = document.getElementById('hourlyChart').getContext('2d');
            this.charts.hourly = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Scans per Hour',
                        data: data.data,
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#667eea',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading hourly chart:', error);
        }
    }

    async loadScannersChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=scanners');
            const data = await response.json();
            
            const ctx = document.getElementById('scannersChart').getContext('2d');
            this.charts.scanners = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.data,
                        backgroundColor: [
                            '#28a745', '#17a2b8', '#ffc107', '#fd7e14', '#6f42c1'
                        ],
                        borderWidth: 1,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading scanners chart:', error);
        }
    }

    async loadBottleneckChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=bottleneck');
            const data = await response.json();
            
            const ctx = document.getElementById('bottleneckChart').getContext('2d');
            this.charts.bottleneck = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Processing Time (min)',
                        data: data.data,
                        backgroundColor: data.data.map(value => 
                            value > 30 ? '#dc3545' : value > 15 ? '#ffc107' : '#28a745'
                        ),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Minutes'
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading bottleneck chart:', error);
        }
    }

    initAutoRefresh() {
        // Auto-refresh every 5 minutes
        setInterval(() => {
            this.refreshDashboard();
        }, 300000);
    }

    async refreshDashboard() {
        try {
            await this.initCharts();
            this.initKpiCounters();
        } catch (error) {
            console.error('Error refreshing dashboard:', error);
        }
    }
}

// Global functions
function clearFilters() {
    document.getElementById('filterForm').reset();
    window.location.href = '/Shipping/Dashboard';
}

// Initialize dashboard
document.addEventListener('DOMContentLoaded', () => {
    new ExecutiveDashboard();
});
</script>

<script>
// Client-side pagination for shipping statistics table
(() => {
    const pageSize = 7;
    const table = document.querySelector('.stats-card table');
    if (!table) return;

    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    if (rows.length <= pageSize) return; // no pagination needed

    // Create pagination controls
    const pager = document.createElement('div');
    pager.className = 'd-flex justify-content-center mt-3';
    const ul = document.createElement('ul');
    ul.className = 'pagination';
    pager.appendChild(ul);

    const container = document.querySelector('.stats-card');
    container.appendChild(pager);

    const pageCount = Math.ceil(rows.length / pageSize);
    let currentPage = 1;

    function renderPage(page) {
        currentPage = page;
        const start = (page - 1) * pageSize;
        const end = start + pageSize;
        rows.forEach((r, idx) => r.style.display = (idx >= start && idx < end) ? '' : 'none');
        // update active class
        Array.from(ul.children).forEach((li, i) => {
            li.classList.toggle('active', i + 1 === page);
        });
    }

    for (let i = 1; i <= pageCount; i++) {
        const li = document.createElement('li');
        li.className = 'page-item' + (i === 1 ? ' active' : '');
        const a = document.createElement('a');
        a.className = 'page-link';
        a.href = '#';
        a.textContent = i;
        a.addEventListener('click', (e) => { e.preventDefault(); renderPage(i); });
        li.appendChild(a);
        ul.appendChild(li);
    }

    renderPage(1);
})();
</script>
