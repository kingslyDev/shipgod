@model ShipmentFinishGood.ViewModels.ShippingMonitoringViewModel
@{
    ViewData["Title"] = "Shipping Dashboard";
    Layout = "_Layout";
}

<style>
    .dashboard-simple {
        font-family: Arial, sans-serif;
        font-size: 14px;
    }
    
    .header-simple {
        background: #42a5f5;
        color: white;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }
    
    .summary-boxes {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .summary-box {
        background: white;
        border: 2px solid #42a5f5;
        padding: 15px;
        text-align: center;
        border-radius: 5px;
    }
    
    .summary-box h4 {
        margin: 0 0 5px 0;
        color: #42a5f5;
        font-size: 24px;
        font-weight: bold;
    }
    
    .summary-box small {
        color: #666;
        font-size: 12px;
    }
    
    .filter-box {
        background: #f5f5f5;
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }
    
    .filter-row {
        display: grid;
        grid-template-columns: 200px 150px 150px 120px;
        gap: 15px;
        align-items: end;
    }
    
    .filter-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #333;
    }
    
    .filter-group select,
    .filter-group input {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 3px;
        font-size: 14px;
    }
    
    .btn-apply {
        background: #42a5f5;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 3px;
        cursor: pointer;
        font-weight: bold;
    }
    
    .btn-apply:hover {
        background: #1976d2;
    }
    
    .btn-refresh {
        background: #666;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 3px;
        cursor: pointer;
        margin-left: 10px;
    }
    
    .btn-refresh:hover {
        background: #333;
    }
    
    .table-container {
        background: white;
        border: 1px solid #ddd;
        border-radius: 5px;
        overflow: hidden;
    }
    
    .table-header {
        background: #42a5f5;
        color: white;
        padding: 12px;
        font-weight: bold;
        font-size: 16px;
    }
    
    .table-simple {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }
    
    .table-simple th {
        background: #e3f2fd;
        padding: 12px 8px;
        text-align: left;
        border: 1px solid #42a5f5;
        font-weight: bold;
        color: #1976d2;
    }
    
    .table-simple td {
        padding: 12px 8px;
        border: 1px solid #ddd;
        vertical-align: top;
    }
    
    .table-simple tbody tr:nth-child(even) {
        background: #f9f9f9;
    }
    
    .table-simple tbody tr:hover {
        background: #e3f2fd;
    }
    
    .country-tag {
        background: #42a5f5;
        color: white;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: bold;
    }
    
    .progress-simple {
        background: #f0f0f0;
        height: 18px;
        border-radius: 3px;
        position: relative;
        border: 1px solid #ddd;
    }
    
    .progress-fill {
        background: #42a5f5;
        height: 100%;
        border-radius: 2px;
        transition: width 0.3s ease;
    }
    
    .progress-text {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        font-size: 12px;
        line-height: 18px;
        font-weight: bold;
        color: #333;
    }
    
    .total-row {
        background: #e3f2fd;
        font-weight: bold;
        color: #1976d2;
    }
    
    .file-info {
        line-height: 1.4;
    }
    
    .file-name {
        font-weight: bold;
        color: #333;
        margin-bottom: 3px;
    }
    
    .file-date {
        color: #666;
        font-size: 12px;
    }
    
    .qty-number {
        font-weight: bold;
        font-size: 15px;
    }
    
    .qty-scanned {
        color: #4caf50;
    }
    
    .qty-remaining {
        color: #ff9800;
    }
    
    .no-data {
        text-align: center;
        padding: 40px;
        color: #666;
        font-style: italic;
    }
    
    /* Simple responsive */
    @@media (max-width: 768px) {
        .summary-boxes {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .filter-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        
        .table-simple {
            font-size: 12px;
        }
        
        .table-simple th,
        .table-simple td {
            padding: 8px 4px;
        }
    }
</style>

<div class="dashboard-simple">
    <div class="header-simple">
        <h3 style="margin: 0;">📊 Shipping Monitoring Dashboard</h3>
        <small>Real-time tracking with ModelConfig conversion</small>
        <button class="btn-refresh" onclick="manualRefresh()" style="float: right;">
            🔄 Refresh
        </button>
    </div>
    
    <!-- Summary Boxes -->
    <div class="summary-boxes">
        <div class="summary-box">
            <h4>@Model.TotalSessions</h4>
            <small>Total Files</small>
        </div>
        <div class="summary-box">
            <h4>@Model.TotalQtyTarget.ToString("N0")</h4>
            <small>Total QTY Target</small>
        </div>
        <div class="summary-box">
            <h4>@Model.TotalQtyScanned.ToString("N0")</h4>
            <small>Scanned QTY</small>
        </div>
        <div class="summary-box">
            <h4>@Model.TotalQtyRemaining.ToString("N0")</h4>
            <small>Remaining QTY</small>
        </div>
    </div>

    <!-- Filter -->
    <form method="get" class="filter-box">
        <div class="filter-row">
            <div class="filter-group">
                <label>Country Filter:</label>
                <select name="country">
                    <option value="">All Countries</option>
                    @foreach (var country in Model.AvailableCountries)
                    {
                        <option value="@country" selected="@(country == Model.SelectedCountry)">@country</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Start Date:</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")">
            </div>
            <div class="filter-group">
                <label>End Date:</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")">
            </div>
            <div class="filter-group">
                <label>&nbsp;</label>
                <button type="submit" class="btn-apply">Apply Filter</button>
            </div>
        </div>
    </form>

    <!-- Main Table -->
    @if (Model.SessionDetails?.Any() == true)
    {
        <div class="table-container">
            <div class="table-header">
                📋 File Details (@Model.SessionDetails.Count files found)
            </div>
            <table class="table-simple">
                <thead>
                    <tr>
                        <th style="width: 25%;">File Name</th>
                        <th style="width: 12%;">Country</th>
                        <th style="width: 12%;">Total QTY</th>
                        <th style="width: 12%;">Scanned QTY</th>
                        <th style="width: 12%;">Remaining QTY</th>
                        <th style="width: 27%;">Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.SessionDetails)
                    {
                        <tr>
                            <td>
                                <div class="file-info">
                                    <div class="file-name">@session.FileName</div>
                                    <div class="file-date">Created: @session.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (session.LastScanDate.HasValue)
                                    {
                                        <div class="file-date">Last scan: @session.LastScanDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="country-tag">@session.Country</span>
                            </td>
                            <td>
                                <span class="qty-number">@session.TotalQtyTarget.ToString("N0")</span>
                            </td>
                            <td>
                                <span class="qty-number qty-scanned">@session.TotalQtyScanned.ToString("N0")</span>
                            </td>
                            <td>
                                <span class="qty-number qty-remaining">@session.TotalQtyRemaining.ToString("N0")</span>
                            </td>
                            <td>
                                <div class="progress-simple">
                                    <div class="progress-fill" style="width: @session.ProgressPercentage%"></div>
                                    <div class="progress-text">@session.ProgressPercentage% Complete</div>
                                </div>
                                <small style="color: #666; margin-top: 3px; display: block;">
                                    @session.TotalQtyScanned.ToString("N0") of @session.TotalQtyTarget.ToString("N0") items
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <th colspan="2">📊 TOTAL SUMMARY:</th>
                        <th>@Model.TotalQtyTarget.ToString("N0")</th>
                        <th>@Model.TotalQtyScanned.ToString("N0")</th>
                        <th>@Model.TotalQtyRemaining.ToString("N0")</th>
                        <th>
                            @{
                                var overallProgress = Model.TotalQtyTarget > 0 ? (double)Model.TotalQtyScanned / Model.TotalQtyTarget * 100 : 0;
                            }
                            <div class="progress-simple">
                                <div class="progress-fill" style="width: @overallProgress%"></div>
                                <div class="progress-text">@overallProgress.ToString("F1")% Overall</div>
                            </div>
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="no-data">
                <h4>📭 No Data Found</h4>
                <p>No shipping sessions found for the selected filters.<br>
                Please check your date range or country filter.</p>
            </div>
        </div>
    }
</div>

<script>
    // 🚀 REAL-TIME DASHBOARD UPDATES - Inspired by QR Manage
    let refreshInterval;
    let currentFilters = {
        country: '@Model.SelectedCountry',
        startDate: '@Model.StartDate?.ToString("yyyy-MM-dd")',
        endDate: '@Model.EndDate?.ToString("yyyy-MM-dd")'
    };
    
    // Auto refresh every 15 seconds (faster than QR Manage for dashboard)
    function startAutoRefresh() {
        refreshInterval = setInterval(function() {
            refreshDashboardStats();
        }, 15000); // 15 seconds
        
        console.log('🔄 Auto-refresh started for Shipping Dashboard');
    }
    
    function stopAutoRefresh() {
        if (refreshInterval) {
            clearInterval(refreshInterval);
            console.log('⏹️ Auto-refresh stopped');
        }
    }
    
    // Manual refresh function
    function refreshDashboardStats() {
        const refreshBtn = document.querySelector('.btn-refresh');
        if (refreshBtn) {
            refreshBtn.innerHTML = '🔄 Refreshing...';
            refreshBtn.disabled = true;
        }
        
        // Build query parameters
        const params = new URLSearchParams();
        if (currentFilters.country) params.append('country', currentFilters.country);
        if (currentFilters.startDate) params.append('startDate', currentFilters.startDate);
        if (currentFilters.endDate) params.append('endDate', currentFilters.endDate);
        
        fetch(`/Shipping/GetDashboardStats?${params.toString()}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateDashboardUI(data);
                    showUpdateNotification('Dashboard updated successfully!', 'success');
                } else {
                    showUpdateNotification('Failed to update dashboard: ' + data.error, 'error');
                }
            })
            .catch(error => {
                console.error('Dashboard refresh error:', error);
                showUpdateNotification('Network error during refresh', 'error');
            })
            .finally(() => {
                if (refreshBtn) {
                    refreshBtn.innerHTML = '🔄 Refresh';
                    refreshBtn.disabled = false;
                }
            });
    }
    
    // Update UI with new data
    function updateDashboardUI(data) {
        // Update summary boxes
        updateSummaryBox(0, data.totalSessions);
        updateSummaryBox(1, data.totalQtyTarget.toLocaleString());
        updateSummaryBox(2, data.totalQtyScanned.toLocaleString());
        updateSummaryBox(3, data.totalQtyRemaining.toLocaleString());
        
        // Update table rows
        updateTableRows(data.sessionDetails);
        
        // Update overall progress in footer
        updateOverallProgress(data.overallProgress, data.totalQtyScanned, data.totalQtyTarget);
        
        // Update last updated time
        updateLastUpdatedTime(data.lastUpdated);
        
        console.log('✅ Dashboard UI updated with real-time data');
    }
    
    function updateSummaryBox(index, value) {
        const summaryBoxes = document.querySelectorAll('.summary-box h4');
        if (summaryBoxes[index]) {
            // Add animation effect
            summaryBoxes[index].style.transform = 'scale(1.1)';
            summaryBoxes[index].style.color = '#42a5f5';
            
            setTimeout(() => {
                summaryBoxes[index].textContent = value;
                summaryBoxes[index].style.transform = 'scale(1)';
            }, 150);
        }
    }
    
    function updateTableRows(sessionDetails) {
        const tbody = document.querySelector('.table-simple tbody');
        if (!tbody || !sessionDetails) return;
        
        // Get current rows
        const currentRows = tbody.querySelectorAll('tr');
        
        sessionDetails.forEach((session, index) => {
            const row = currentRows[index];
            if (row) {
                // Update scanned QTY (column 4)
                const scannedCell = row.cells[3];
                if (scannedCell) {
                    const currentValue = scannedCell.textContent.replace(/,/g, '');
                    const newValue = session.totalQtyScanned.toLocaleString();
                    
                    if (currentValue !== newValue) {
                        // Highlight changes
                        scannedCell.style.backgroundColor = '#e3f2fd';
                        scannedCell.querySelector('.qty-number').textContent = newValue;
                        
                        setTimeout(() => {
                            scannedCell.style.backgroundColor = '';
                        }, 2000);
                    }
                }
                
                // Update remaining QTY (column 5)
                const remainingCell = row.cells[4];
                if (remainingCell) {
                    remainingCell.querySelector('.qty-number').textContent = session.totalQtyRemaining.toLocaleString();
                }
                
                // Update progress bar (column 6)
                const progressCell = row.cells[5];
                if (progressCell) {
                    const progressFill = progressCell.querySelector('.progress-fill');
                    const progressText = progressCell.querySelector('.progress-text');
                    const progressInfo = progressCell.querySelector('small');
                    
                    if (progressFill && progressText) {
                        progressFill.style.width = session.progressPercentage + '%';
                        progressText.textContent = session.progressPercentage + '% Complete';
                        
                        if (progressInfo) {
                            progressInfo.textContent = `${session.totalQtyScanned.toLocaleString()} of ${session.totalQtyTarget.toLocaleString()} items`;
                        }
                    }
                }
                
                // Update last scan date if available
                if (session.lastScanDate) {
                    const fileInfo = row.cells[0].querySelector('.file-info');
                    if (fileInfo) {
                        let lastScanDiv = fileInfo.querySelector('.last-scan-date');
                        if (!lastScanDiv) {
                            lastScanDiv = document.createElement('div');
                            lastScanDiv.className = 'file-date last-scan-date';
                            fileInfo.appendChild(lastScanDiv);
                        }
                        lastScanDiv.textContent = `Last scan: ${session.lastScanDate}`;
                    }
                }
            }
        });
    }
    
    function updateOverallProgress(progressPercentage, scanned, target) {
        const footerProgress = document.querySelector('tfoot .progress-fill');
        const footerText = document.querySelector('tfoot .progress-text');
        const scannedCell = document.querySelector('tfoot tr th:nth-child(4)');
        const remainingCell = document.querySelector('tfoot tr th:nth-child(5)');
        
        if (footerProgress && footerText) {
            footerProgress.style.width = progressPercentage + '%';
            footerText.textContent = progressPercentage.toFixed(1) + '% Overall';
        }
        
        if (scannedCell) {
            scannedCell.textContent = scanned.toLocaleString();
        }
        
        if (remainingCell) {
            remainingCell.textContent = (target - scanned).toLocaleString();
        }
    }
    
    function updateLastUpdatedTime(timestamp) {
        let updateInfo = document.querySelector('.last-updated-info');
        if (!updateInfo) {
            updateInfo = document.createElement('small');
            updateInfo.className = 'last-updated-info';
            updateInfo.style.cssText = 'position: fixed; bottom: 10px; right: 10px; background: #42a5f5; color: white; padding: 5px 10px; border-radius: 3px; font-size: 11px; z-index: 1000;';
            document.body.appendChild(updateInfo);
        }
        updateInfo.textContent = `Last updated: ${timestamp}`;
        
        // Fade out after 3 seconds
        setTimeout(() => {
            updateInfo.style.opacity = '0.7';
        }, 3000);
    }
    
    function showUpdateNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed; 
            top: 20px; 
            right: 20px; 
            background: ${type === 'success' ? '#4caf50' : '#f44336'}; 
            color: white; 
            padding: 10px 15px; 
            border-radius: 5px; 
            font-size: 14px; 
            z-index: 1001;
            animation: slideIn 0.3s ease-out;
        `;
        notification.textContent = message;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.remove();
        }, 3000);
    }
    
    // Add CSS animation for notifications
    const style = document.createElement('style');
    style.textContent = `
        @@keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    `;
    document.head.appendChild(style);
    
    // Initialize auto-refresh when page loads
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Shipping Dashboard Real-time Updates Initialized');
        startAutoRefresh();
        
        // Stop auto-refresh when user leaves the page
        window.addEventListener('beforeunload', function() {
            stopAutoRefresh();
        });
        
        // Pause auto-refresh when tab is not visible
        document.addEventListener('visibilitychange', function() {
            if (document.hidden) {
                stopAutoRefresh();
            } else {
                startAutoRefresh();
            }
        });
    });
    
    // Manual refresh button click
    function manualRefresh() {
        refreshDashboardStats();
    }
    
    // Update current filters when form is submitted
    document.addEventListener('submit', function(e) {
        const form = e.target;
        if (form.method.toLowerCase() === 'get') {
            currentFilters = {
                country: form.querySelector('[name="country"]')?.value || '',
                startDate: form.querySelector('[name="startDate"]')?.value || '',
                endDate: form.querySelector('[name="endDate"]')?.value || ''
            };
        }
    });
</script>
