@model ShipmentFinishGood.DTOs.ShippingDashboardDto

@{
    ViewData["Title"] = "Executive Shipping Dashboard";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/shipping-dashboard.css" />

<div class="dashboard-container">
    <!-- Executive Header -->
    <div class="dashboard-header">
        <h1><i class="fas fa-chart-line"></i> Executive Shipping Dashboard</h1>
        <p>Real-time insights for outbound operations & business intelligence</p>
        <div class="last-updated">
            <i class="fas fa-clock"></i> Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
        </div>
    </div>

    <!-- Key Performance Indicators (Big Numbers for Executives) -->
    <div class="kpi-section">
        <div class="kpi-grid">
            <div class="kpi-card primary">
                <div class="kpi-icon">
                    <i class="fas fa-boxes"></i>
                </div>
                <div class="kpi-content">
                    <h3 class="kpi-value" data-target="@Model.TotalItemsGenerated">0</h3>
                    <p class="kpi-label">Total Items Generated</p>
                    <span class="kpi-sublabel">Ready for processing</span>
                </div>
            </div>
            
            <div class="kpi-card success">
                <div class="kpi-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-content">
                    <h3 class="kpi-value" data-target="@Model.TotalItemsScanned">0</h3>
                    <p class="kpi-label">Items Scanned</p>
                    <div class="kpi-progress">
                        <div class="progress-bar" style="width: @(Model.OverallEfficiency)%"></div>
                    </div>
                    <span class="kpi-sublabel">@Model.OverallEfficiency.ToString("F1")% completion rate</span>
                </div>
            </div>
            
            <div class="kpi-card warning">
                <div class="kpi-icon">
                    <i class="fas fa-shipping-fast"></i>
                </div>
                <div class="kpi-content">
                    <h3 class="kpi-value" data-target="@Model.TotalItemsShipped">0</h3>
                    <p class="kpi-label">Ready to Ship</p>
                    <span class="kpi-sublabel">Awaiting dispatch</span>
                </div>
            </div>
            
            <div class="kpi-card info">
                <div class="kpi-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="kpi-content">
                    <h3 class="kpi-value" data-target="@Model.TotalItemsPending">0</h3>
                    <p class="kpi-label">Pending Scan</p>
                    <span class="kpi-sublabel">In queue</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Performance Snapshot -->
    <div class="performance-section">
        <div class="section-header">
            <h2><i class="fas fa-calendar-day"></i> Today's Performance</h2>
        </div>
        <div class="today-metrics">
            <div class="metric-item">
                <div class="metric-value">@Model.TodayGenerated</div>
                <div class="metric-label">Generated Today</div>
            </div>
            <div class="metric-item">
                <div class="metric-value">@Model.TodayScanned</div>
                <div class="metric-label">Scanned Today</div>
            </div>
            <div class="metric-item">
                <div class="metric-value">@Model.TodayCompletionRate.ToString("F1")%</div>
                <div class="metric-label">Today's Rate</div>
            </div>
            <div class="metric-item">
                <div class="metric-value">@Model.ActiveSessions</div>
                <div class="metric-label">Active Sessions</div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <form id="filterForm" class="filter-form">
            <div class="filter-group">
                <label for="countryFilter"><i class="fas fa-globe"></i> Country Destination</label>
                <select id="countryFilter" name="countryFilter" class="filter-select">
                    <option value="">All Countries</option>
                    @foreach (var country in Model.AvailableCountries)
                    {
                        @if (ViewBag.SelectedCountry?.ToString() == country)
                        {
                            <option value="@country" selected>@country</option>
                        }
                        else
                        {
                            <option value="@country">@country</option>
                        }
                    }
                </select>
            </div>
            
            <div class="filter-group">
                <label for="dateFromFilter"><i class="fas fa-calendar-alt"></i> From Date</label>
                <input type="date" id="dateFromFilter" name="dateFromFilter" value="@ViewBag.DateFrom" class="filter-input" />
            </div>
            
            <div class="filter-group">
                <label for="dateToFilter"><i class="fas fa-calendar-alt"></i> To Date</label>
                <input type="date" id="dateToFilter" name="dateToFilter" value="@ViewBag.DateTo" class="filter-input" />
            </div>
            
            <div class="filter-group">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" name="statusFilter" class="filter-select">
                    <option value="">All Status</option>
                    @{
                        var selectedStatus = ViewBag.SelectedStatus?.ToString();
                    }
                    @if (selectedStatus == "SCAN_COMPLETED")
                    {
                        <option value="SCAN_COMPLETED" selected>Completed</option>
                    }
                    else
                    {
                        <option value="SCAN_COMPLETED">Completed</option>
                    }
                    
                    @if (selectedStatus == "IN_PROGRESS")
                    {
                        <option value="IN_PROGRESS" selected>In Progress</option>
                    }
                    else
                    {
                        <option value="IN_PROGRESS">In Progress</option>
                    }
                    
                    @if (selectedStatus == "VALIDATED")
                    {
                        <option value="VALIDATED" selected>Validated</option>
                    }
                    else
                    {
                        <option value="VALIDATED">Validated</option>
                    }
                    
                    @if (selectedStatus == "QR_GENERATED")
                    {
                        <option value="QR_GENERATED" selected>QR Generated</option>
                    }
                    else
                    {
                        <option value="QR_GENERATED">QR Generated</option>
                    }
                </select>
            </div>
            
            <div class="filter-actions">
                <button type="submit" class="btn-apply">Apply Filters</button>
                <button type="button" id="clearFilters" class="btn-clear">Clear</button>
                <button type="button" id="refreshData" class="btn-refresh">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </form>
    </div>

    <!-- Executive Analytics & Charts -->
    <div class="analytics-section">
        <div class="charts-grid">
            <!-- Business Intelligence Chart -->
            <div class="chart-container large">
                <div class="chart-header">
                    <h3><i class="fas fa-globe-americas"></i> Country Distribution</h3>
                    <span class="chart-subtitle">Shipment destinations breakdown</span>
                </div>
                <div class="chart-wrapper">
                    <canvas id="countryChart"></canvas>
                </div>
            </div>
            
            <!-- Operational Status Chart -->
            <div class="chart-container medium">
                <div class="chart-header">
                    <h3><i class="fas fa-chart-pie"></i> Status Overview</h3>
                    <span class="chart-subtitle">Current pipeline status</span>
                </div>
                <div class="chart-wrapper">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
            
            <!-- Hourly Trends Chart -->
            <div class="chart-container wide">
                <div class="chart-header">
                    <h3><i class="fas fa-chart-line"></i> Today's Scanning Activity</h3>
                    <span class="chart-subtitle">Hourly progress tracking</span>
                </div>
                <div class="chart-wrapper">
                    <canvas id="hourlyChart"></canvas>
                </div>
            </div>
            
            <!-- Top Products Chart -->
            <div class="chart-container medium">
                <div class="chart-header">
                    <h3><i class="fas fa-cubes"></i> Top Products</h3>
                    <span class="chart-subtitle">High-volume models</span>
                </div>
                <div class="chart-wrapper">
                    <canvas id="modelsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Session Performance Table -->
    <div class="sessions-section">
        <div class="section-header">
            <h2><i class="fas fa-tasks"></i> Session Performance</h2>
            <div class="header-actions">
                <button class="btn-export" onclick="exportSessionData()">
                    <i class="fas fa-download"></i> Export
                </button>
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th>Session ID</th>
                        <th>File Name</th>
                        <th>Country</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.SessionMetrics.Take(20))
                    {
                        <tr>
                            <td><span class="session-id">#@session.SessionId</span></td>
                            <td>@session.FileName</td>
                            <td>
                                <span class="country-badge">@session.Country</span>
                            </td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress-bar-container">
                                        <div class="progress-bar @session.ProgressClass" style="width: @session.CompletionRate%"></div>
                                    </div>
                                    <span class="progress-text">@session.CompletionRate.ToString("F1")%</span>
                                    <small>(@session.ScannedItems/@session.TotalItems)</small>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @session.StatusClass">@session.Status</span>
                            </td>
                            <td>@session.CreatedDate.ToString("MMM dd, HH:mm")</td>
                            <td>
                                <button class="btn-detail" onclick="viewSessionDetail(@session.SessionId)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
                <p>Pending Shipments</p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Status Distribution</h3>
                <div class="chart-controls">
                    <button class="chart-refresh" data-chart="status">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="statusPieChart"></canvas>
                <div id="statusChartLoading" class="chart-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading chart data...</p>
                </div>
            </div>
        </div>
        
        <div class="chart-card">
            <div class="chart-header">
                <h3>Shipments by Country</h3>
                <div class="chart-controls">
                    <button class="chart-refresh" data-chart="country">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="countryBarChart"></canvas>
                <div id="countryChartLoading" class="chart-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading chart data...</p>
                </div>
            </div>
        </div>
        
        <div class="chart-card full-width">
            <div class="chart-header">
                <h3>Monthly Shipping Trends</h3>
                <div class="chart-controls">
                    <button class="chart-refresh" data-chart="trend">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="trendLineChart"></canvas>
                <div id="trendChartLoading" class="chart-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading chart data...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Shipments Table -->
    <div class="table-section">
        <div class="table-header">
            <h3>Recent Shipments</h3>
            <div class="table-actions">
                <button id="exportData" class="btn-export">
                    <i class="fas fa-download"></i> Export
                </button>
            </div>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Session ID</th>
                        <th>File Name</th>
                        <th>Status</th>
                        <th>Total Boxes</th>
                        <th>Ship Date</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody id="shipmentsTableBody">
                    @if (Model?.RecentShipments != null && Model.RecentShipments.Any())
                    {
                        @foreach (var item in Model.RecentShipments)
                        {
                            <tr>
                                <td>@item.SessionId</td>
                                <td>@item.FileName</td>
                                <td>
                                    <span class="status-badge @(item.Status == "SCAN_COMPLETED" ? "completed" : item.Status == "IN_PROGRESS" ? "in-process" : "pending")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.TotalBoxes</td>
                                <td>@(item.ShipmentDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                <td>@item.CreatedDate.ToString("MM/dd/yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="no-data">No data available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Include Chart.js and FontAwesome -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>

<script>
// Executive Dashboard JavaScript
class ExecutiveDashboard {
    constructor() {
        this.charts = {};
        this.init();
    }

    init() {
        this.initKpiCounters();
        this.initCharts();
        this.initFilters();
        this.initAutoRefresh();
    }

    // Animate KPI numbers (impressive for executives)
    initKpiCounters() {
        document.querySelectorAll('.kpi-value[data-target]').forEach(counter => {
            const target = parseInt(counter.getAttribute('data-target'));
            const duration = 2000;
            const step = target / (duration / 16);
            let current = 0;
            
            const updateCounter = () => {
                current += step;
                if (current < target) {
                    counter.textContent = Math.floor(current).toLocaleString();
                    requestAnimationFrame(updateCounter);
                } else {
                    counter.textContent = target.toLocaleString();
                }
            };
            
            updateCounter();
        });
    }

    // Initialize executive charts
    async initCharts() {
        await this.loadCountryChart();
        await this.loadStatusChart();
        await this.loadHourlyChart();
        await this.loadModelsChart();
    }

    async loadCountryChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=country');
            const data = await response.json();
            
            const ctx = document.getElementById('countryChart').getContext('2d');
            this.charts.country = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.data,
                        backgroundColor: data.backgroundColor,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                font: { size: 12 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((context.parsed * 100) / total).toFixed(1);
                                    return `${context.label}: ${context.parsed.toLocaleString()} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading country chart:', error);
        }
    }

    async loadStatusChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=status');
            const data = await response.json();
            
            const ctx = document.getElementById('statusChart').getContext('2d');
            this.charts.status = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.data,
                        backgroundColor: data.backgroundColor,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 15,
                                usePointStyle: true,
                                font: { size: 11 }
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading status chart:', error);
        }
    }

    async loadHourlyChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=hourly');
            const data = await response.json();
            
            const ctx = document.getElementById('hourlyChart').getContext('2d');
            this.charts.hourly = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Scans per Hour',
                        data: data.data,
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#007bff',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0,0,0,0.1)'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0,0,0,0.1)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading hourly chart:', error);
        }
    }

    async loadModelsChart() {
        try {
            const response = await fetch('/Shipping/legacy-chart-data?chartType=models');
            const data = await response.json();
            
            const ctx = document.getElementById('modelsChart').getContext('2d');
            this.charts.models = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.data,
                        backgroundColor: data.backgroundColor,
                        borderWidth: 1,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0,0,0,0.1)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        }
                    }
                }
            });
        } catch (error) {
            console.error('Error loading models chart:', error);
        }
    }

    initFilters() {
        const filterForm = document.getElementById('filterForm');
        if (filterForm) {
            filterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                this.applyFilters();
            });
        }

        const clearButton = document.getElementById('clearFilters');
        if (clearButton) {
            clearButton.addEventListener('click', () => {
                filterForm.reset();
                this.applyFilters();
            });
        }

        const refreshButton = document.getElementById('refreshData');
        if (refreshButton) {
            refreshButton.addEventListener('click', () => {
                this.refreshDashboard();
            });
        }
    }

    applyFilters() {
        const formData = new FormData(document.getElementById('filterForm'));
        const params = new URLSearchParams();
        
        for (let [key, value] of formData.entries()) {
            if (value) params.append(key, value);
        }
        
        window.location.href = `/Shipping/Dashboard?${params.toString()}`;
    }

    async refreshDashboard() {
        // Add loading states
        this.showLoading();
        
        try {
            // Refresh all charts
            await this.initCharts();
            this.initKpiCounters();
            
            // Show success notification
            this.showNotification('Dashboard refreshed successfully', 'success');
        } catch (error) {
            this.showNotification('Error refreshing dashboard', 'error');
        } finally {
            this.hideLoading();
        }
    }

    initAutoRefresh() {
        // Auto-refresh every 5 minutes (300000ms)
        setInterval(() => {
            this.refreshDashboard();
        }, 300000);
    }

    showLoading() {
        document.querySelectorAll('.chart-wrapper').forEach(wrapper => {
            wrapper.style.opacity = '0.5';
        });
    }

    hideLoading() {
        document.querySelectorAll('.chart-wrapper').forEach(wrapper => {
            wrapper.style.opacity = '1';
        });
    }

    showNotification(message, type = 'info') {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `notification notification-${type}`;
        notification.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
            <span>${message}</span>
        `;
        
        document.body.appendChild(notification);
        
        // Auto-remove after 3 seconds
        setTimeout(() => {
            notification.remove();
        }, 3000);
    }
}

// Global functions for template
function viewSessionDetail(sessionId) {
    window.location.href = `/Scan/SessionDetail/${sessionId}`;
}

function exportSessionData() {
    // Implement CSV export functionality
    const csvData = this.generateCSVData();
    this.downloadCSV(csvData, 'session_performance.csv');
}

// Initialize dashboard when DOM is loaded
document.addEventListener('DOMContentLoaded', () => {
    new ExecutiveDashboard();
});
</script>