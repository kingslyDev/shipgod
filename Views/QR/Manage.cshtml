w@model ShipmentFinishGood.DTOs.QRManagementDto
@{
    ViewData["Title"] = "QR Code Management - " + Model.FileName;
}
@section Styles {<link rel="stylesheet" href="~/css/qr.css" asp-append-version="true" />}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-info">
            <i class="fas fa-qrcode me-2"></i>QR Code Management - @Model.SheetName
        </h2>
        <div class="btn-group">
            <a asp-controller="Final" asp-action="Index" asp-route-id="@Model.SessionId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Final Table
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- QR Identity Card -->
        <div class="col-lg-8">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-qrcode me-2"></i>QR Identity Code</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.QRImageBase64))
                                {
                                    <img src="data:image/png;base64,@Model.QRImageBase64" 
                                         alt="QR Code" class="img-fluid border" style="max-width: 200px;" />
                                }
                                else
                                {
                                    <div class="bg-light border d-flex align-items-center justify-content-center" 
                                         style="width: 200px; height: 200px; margin: 0 auto;">
                                        <i class="fas fa-qrcode fa-3x text-muted"></i>
                                    </div>
                                }
                                <div class="mt-3">
                                    <a asp-action="PrintQR" asp-route-sessionId="@Model.SessionId" 
                                       class="btn btn-outline-primary btn-sm" target="_blank">
                                        <i class="fas fa-print me-2"></i>Print QR Identity
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="text-primary mb-3">QR Identity Information</h6>
                                
                                <div class="mb-3">
                                    <small class="text-muted">QR Identity:</small>
                                    <div class="fw-bold fs-6 text-primary" id="qrIdentity">@Model.QRIdentity</div>
                                    <button class="btn btn-link btn-sm p-0" onclick="copyToClipboard('qrIdentity')">
                                        <i class="fas fa-copy"></i> Copy
                                    </button>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">File Name:</small>
                                    <div class="fw-bold">@Model.FileName</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Generated Date:</small>
                                    <div class="fw-bold">@Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Generated By:</small>
                                    <div class="fw-bold">@Model.GeneratedBy</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Status:</small>
                                    <div>
                                        <span class="badge bg-success fs-6">
                                            <i class="fas fa-check-circle me-1"></i>@Model.Status
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Total Summary:</small>
                                    <div class="row text-center mt-2">
                                        <div class="col-3">
                                            <div class="fw-bold text-primary fs-5">@Model.TotalPallets.ToString("N0")</div>
                                            <small class="text-muted">Pallets</small>
                                        </div>
                                        <div class="col-3">
                                            <div class="fw-bold text-warning fs-5">@Model.TotalBoxes.ToString("N0")</div>
                                            <small class="text-muted">Boxes</small>
                                        </div>
                                        <div class="col-3">
                                            <div class="fw-bold text-success fs-5">@Model.TotalPcs.ToString("N0")</div>
                                            <small class="text-muted">Pieces</small>
                                        </div>
                                        <div class="col-3">
                                            <div class="fw-bold text-info fs-5">@Model.TotalQty.ToString("N0")</div>
                                            <small class="text-muted">Total Qty</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Scanning Progress (All Items):</small>
                                    <div class="d-flex align-items-center mt-2">
                                        <div class="progress flex-grow-1 me-3" style="height: 20px;">
                                            <div class="progress-bar bg-success" role="progressbar" 
                                                 style="width: @Model.ScanPercentage%" 
                                                 aria-valuenow="@Model.ScanPercentage" 
                                                 aria-valuemin="0" aria-valuemax="100">
                                                @Model.ScanPercentage%
                                            </div>
                                        </div>
                                        <span class="fw-bold text-success">@Model.TotalScanned/@(Model.TotalBoxes + Model.TotalPallets + Model.TotalPcs)</span>
                                    </div>
                                    
                                    <!-- Detailed breakdown -->
                                    <div class="row mt-2 small">
                                        <div class="col-4 text-center">
                                            <div class="text-warning fw-bold">@Model.ScannedBoxes/@Model.TotalBoxes</div>
                                            <small class="text-muted">Boxes</small>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="text-primary fw-bold">@Model.ScannedPallets/@Model.TotalPallets</div>
                                            <small class="text-muted">Pallets</small>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="text-info fw-bold">@Model.ScannedPcs/@Model.TotalPcs</div>
                                            <small class="text-muted">Pieces</small>
                                        </div>
                                    </div>
                                    
                                    <small class="text-muted mt-2">
                                        @if (Model.LastScannedDate.HasValue)
                                        {
                                            <span>Last scan: @Model.LastScannedDate.Value.ToString("dd/MM HH:mm")</span>
                                            @if (!string.IsNullOrEmpty(Model.LastScannedBy))
                                            {
                                                <span> by @Model.LastScannedBy</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>No scans recorded yet</span>
                                        }
                                        
                                        @if (Model.CanComplete)
                                        {
                                            <br><span class="text-success"><i class="fas fa-check-circle me-1"></i>Ready to complete!</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="col-lg-4">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h6 class="mb-0"><i class="fas fa-cogs me-2"></i>QR Management Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="DownloadPDF" asp-route-sessionId="@Model.SessionId" 
                           class="btn btn-success">
                            <i class="fas fa-download me-2"></i>Download PDF Barcodes
                        </a>

                        <a asp-action="GetQRImage" asp-route-sessionId="@Model.SessionId" 
                           class="btn btn-info" download="QR_@(Model.SessionId).png">
                            <i class="fas fa-image me-2"></i>Download QR Image
                        </a>

                        <hr />

                        <button type="button" class="btn btn-outline-primary" onclick="showBarcodeModal()">
                            <i class="fas fa-list me-2"></i>View All Barcodes
                        </button>

                        <button type="button" class="btn btn-outline-secondary" onclick="shareQR()">
                            <i class="fas fa-share-alt me-2"></i>Share QR Code
                        </button>

                        <hr />

                        <button type="button" class="btn btn-outline-info btn-sm" onclick="refreshScanningStats()">
                            <i class="fas fa-sync-alt me-2"></i>Refresh Stats
                        </button>
                    </div>
                </div>
            </div>

            <!-- Scanning Statistics Card -->
            <div class="card border-info mt-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Scanning Statistics</h6>
                </div>
                <div class="card-body">
                    <div class="small">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Overall Progress:</span>
                            <span class="fw-bold">@Model.ScanPercentage%</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Total Scanned:</span>
                            <span class="fw-bold text-success">@Model.TotalScanned / @(Model.TotalBoxes + Model.TotalPallets + Model.TotalPcs)</span>
                        </div>
                        
                        <!-- Breakdown by type -->
                        <hr class="my-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">📦 Boxes:</span>
                            <span class="fw-bold text-warning">@Model.ScannedBoxes/@Model.TotalBoxes</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">📋 Pallets:</span>
                            <span class="fw-bold text-primary">@Model.ScannedPallets/@Model.TotalPallets</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">🔢 Pieces:</span>
                            <span class="fw-bold text-info">@Model.ScannedPcs/@Model.TotalPcs</span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Status:</span>
                            <span class="badge bg-@(Model.ScanPercentage == 100 ? "success" : Model.ScanPercentage > 0 ? "warning" : "secondary")">
                                @if (Model.CanComplete)
                                {
                                    <text>✅ Ready to Complete</text>
                                }
                                else if (Model.ScanPercentage == 100)
                                {
                                    <text>Completed</text>
                                }
                                else if (Model.ScanPercentage > 0)
                                {
                                    <text>In Progress</text>
                                }
                                else
                                {
                                    <text>Not Started</text>
                                }
                            </span>
                        </div>
                        @if (Model.LastScannedDate.HasValue)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Last Scan:</span>
                                <span class="fw-bold">@Model.LastScannedDate.Value.ToString("dd/MM HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PO Details Breakdown -->
    @if (Model.POSummaries?.Any() == true)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-secondary">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>PO Details Breakdown (@Model.POSummaries.Count POs)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover po-breakdown-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>PO Number</th>
                                        <th>Model Product</th>
                                        <th class="text-center">Total Qty</th>
                                        <th class="text-center">Pallets</th>
                                        <th class="text-center">Boxes</th>
                                        <th class="text-center">Pieces</th>
                                        <th class="text-center">Scanned</th>
                                        <th class="text-center">Progress</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var po in Model.POSummaries)
                                    {
                                        <tr>
                                            <td class="fw-bold">@po.PONumber</td>
                                            <td>@po.ModelProduct</td>
                                            <td class="text-center">@po.QtyTotal.ToString("N0")</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@po.QtyPallet</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning text-dark">@po.QtyBox</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success">@po.QtyPcs.ToString("N0")</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-bold text-info">@po.ScannedCount/@po.QtyBox</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="progress" style="height: 20px; min-width: 80px;">
                                                    <div class="progress-bar bg-@(po.ScannedPercentage == 100 ? "success" : po.ScannedPercentage > 0 ? "warning" : "secondary")" 
                                                         role="progressbar" 
                                                         style="width: @po.ScannedPercentage%" 
                                                         aria-valuenow="@po.ScannedPercentage" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @po.ScannedPercentage.ToString("0.0")%
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-@(po.Status == "COMPLETED" ? "success" : po.Status == "SCANNING" ? "warning" : "secondary")">
                                                    @po.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="2">Total</th>
                                        <th class="text-center">@Model.TotalQty.ToString("N0")</th>
                                        <th class="text-center">
                                            <span class="badge bg-primary fs-6">@Model.TotalPallets</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="badge bg-warning text-dark fs-6">@Model.TotalBoxes</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="badge bg-success fs-6">@Model.TotalPcs.ToString("N0")</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="fw-bold text-info fs-6">@Model.TotalScanned/@Model.TotalBoxes</span>
                                        </th>
                                        <th class="text-center">
                                            <div class="progress" style="height: 22px; min-width: 80px;">
                                                <div class="progress-bar bg-@(Model.ScanPercentage == 100 ? "success" : Model.ScanPercentage > 0 ? "warning" : "secondary")" 
                                                     role="progressbar" 
                                                     style="width: @Model.ScanPercentage%" 
                                                     aria-valuenow="@Model.ScanPercentage" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    @Model.ScanPercentage%
                                                </div>
                                            </div>
                                        </th>
                                        <th class="text-center">
                                            <span class="badge bg-@(Model.ScanPercentage == 100 ? "success" : Model.ScanPercentage > 0 ? "warning" : "secondary") fs-6">
                                                @(Model.ScanPercentage == 100 ? "COMPLETED" : Model.ScanPercentage > 0 ? "IN PROGRESS" : "PENDING")
                                            </span>
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>No PO Details Available</strong><br>
                    PO breakdown will be displayed once the data is properly linked to this session.
                </div>
            </div>
        </div>
    }
</div>

<!-- Barcode List Modal -->
<div class="modal fade" id="barcodeModal" tabindex="-1" aria-labelledby="barcodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="barcodeModalLabel">
                    <i class="fas fa-barcode me-2"></i>All Box Barcodes (@Model.TotalBoxes)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @foreach (var barcode in Model.BarcodeList)
                    {
                        <div class="col-md-6 mb-2">
                            <div class="card card-body bg-light">
                                <small class="text-muted">Box Barcode:</small>
                                <code class="small">@barcode</code>
                                <button class="btn btn-link btn-sm p-0" onclick="copyToClipboard('barcode-@barcode.GetHashCode()')">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                                <span id="barcode-@barcode.GetHashCode()" style="display: none;">@barcode</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="copyAllBarcodes()">
                    <i class="fas fa-copy me-2"></i>Copy All Barcodes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/qr.js" asp-append-version="true"></script>
    <script>
        function showBarcodeModal() {
            const modal = new bootstrap.Modal(document.getElementById('barcodeModal'));
            modal.show();
        }

        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent || element.innerText;
            
            navigator.clipboard.writeText(text).then(function() {
                showAlert('Copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function copyAllBarcodes() {
            const barcodes = @Html.Raw(Json.Serialize(Model.BarcodeList));
            const barcodeText = barcodes.join('\n');
            
            navigator.clipboard.writeText(barcodeText).then(function() {
                showAlert('All barcodes copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy barcodes: ', err);
                showAlert('Failed to copy barcodes to clipboard', 'danger');
            });
        }

        function shareQR() {
            if (navigator.share) {
                navigator.share({
                    title: 'QR Identity Code',
                    text: 'QR Identity: @Model.QRIdentity',
                    url: window.location.href
                }).then(() => {
                    console.log('QR shared successfully');
                }).catch((error) => {
                    console.log('Error sharing QR:', error);
                    fallbackShare();
                });
            } else {
                fallbackShare();
            }
        }

        function fallbackShare() {
            const shareData = `QR Identity: @Model.QRIdentity\nGenerated: @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")\nTotal Boxes: @Model.TotalBoxes\nLink: ${window.location.href}`;
            
            navigator.clipboard.writeText(shareData).then(function() {
                showAlert('QR information copied to clipboard for sharing!', 'info');
            }, function(err) {
                console.error('Could not copy share data: ', err);
                showAlert('Could not prepare share data', 'danger');
            });
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 5000);
        }

        if (window.QR && typeof window.QR.initManage === 'function') {
            window.QR.initManage({ sessionId: @Model.SessionId });
        }

        // Animate progress bars on load
        document.addEventListener('DOMContentLoaded', function() {
            const progressBars = document.querySelectorAll('.progress-bar');
            progressBars.forEach(bar => {
                const width = bar.style.width;
                bar.style.width = '0%';
                setTimeout(() => {
                    bar.style.width = width;
                    bar.style.setProperty('--progress-width', width);
                }, 100);
            });
        });

        // Auto refresh scanning stats every 30 seconds
        setInterval(function() {
            refreshScanningStats();
        }, 30000);

        function refreshScanningStats() {
            fetch(`/QR/GetScanningStats?sessionId=@Model.SessionId`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update main progress
                        const mainProgress = document.querySelector('.progress-bar[aria-valuenow="@Model.ScanPercentage"]');
                        if (mainProgress) {
                            mainProgress.style.width = data.scanPercentage + '%';
                            mainProgress.setAttribute('aria-valuenow', data.scanPercentage);
                            mainProgress.textContent = data.scanPercentage + '%';
                        }

                        // Update individual progress bars
                        const boxProgress = document.querySelector('.progress-bar-box');
                        if (boxProgress && data.totalBoxes > 0) {
                            const boxPercentage = Math.round((data.scannedBoxes / data.totalBoxes) * 100);
                            boxProgress.style.width = boxPercentage + '%';
                            boxProgress.textContent = boxPercentage + '%';
                        }

                        const palletProgress = document.querySelector('.progress-bar-pallet');
                        if (palletProgress && data.totalPallets > 0) {
                            const palletPercentage = Math.round((data.scannedPallets / data.totalPallets) * 100);
                            palletProgress.style.width = palletPercentage + '%';
                            palletProgress.textContent = palletPercentage + '%';
                        }

                        const pcsProgress = document.querySelector('.progress-bar-pcs');
                        if (pcsProgress && data.totalPcs > 0) {
                            const pcsPercentage = Math.round((data.scannedPcs / data.totalPcs) * 100);
                            pcsProgress.style.width = pcsPercentage + '%';
                            pcsProgress.textContent = pcsPercentage + '%';
                        }

                        // Update scan count texts
                        const boxCountElement = document.querySelector('#box-count');
                        if (boxCountElement) {
                            boxCountElement.textContent = `${data.scannedBoxes}/${data.totalBoxes}`;
                        }

                        const palletCountElement = document.querySelector('#pallet-count');
                        if (palletCountElement) {
                            palletCountElement.textContent = `${data.scannedPallets}/${data.totalPallets}`;
                        }

                        const pcsCountElement = document.querySelector('#pcs-count');
                        if (pcsCountElement) {
                            pcsCountElement.textContent = `${data.scannedPcs}/${data.totalPcs}`;
                        }

                        const totalCountElement = document.querySelector('#total-count');
                        if (totalCountElement) {
                            totalCountElement.textContent = `${data.totalScanned}/${data.totalItems}`;
                        }

                        // Update completion status
                        const statusElement = document.querySelector('.scan-status');
                        if (statusElement) {
                            if (data.canComplete) {
                                statusElement.innerHTML = '<i class="fas fa-check-circle text-success me-2"></i>Ready to Complete';
                                statusElement.className = 'scan-status badge bg-success';
                            } else {
                                statusElement.innerHTML = '<i class="fas fa-clock text-warning me-2"></i>In Progress';
                                statusElement.className = 'scan-status badge bg-warning';
                            }
                        }

                        // Update last scan info
                        if (data.lastScannedDate) {
                            const lastScanElements = document.querySelectorAll('small.text-muted');
                            lastScanElements.forEach(el => {
                                if (el.textContent.includes('Last scan:')) {
                                    el.innerHTML = `Last scan: ${data.lastScannedDate}${data.lastScannedBy ? ` by ${data.lastScannedBy}` : ''}`;
                                }
                            });
                        }

                        console.log('Scanning stats updated:', data);
                    }
                })
                .catch(error => console.error('Error refreshing stats:', error));
        }
    </script>
}
