@model ShipmentFinishGood.DTOs.QRManagementDto
@{
    ViewData["Title"] = "QR Code Management - " + Model.FileName;
}
@section Styles {<link rel="stylesheet" href="~/css/qr.css" asp-append-version="true" />}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-info">
            <i class="fas fa-qrcode me-2"></i>QR Code Management - @Model.SheetName
        </h2>
        <div class="btn-group">
            <a asp-controller="Final" asp-action="Index" asp-route-id="@Model.SessionId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Final Table
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- QR Identity Card -->
        <div class="col-lg-8">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-qrcode me-2"></i>QR Identity Code</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.QRImageBase64))
                                {
                                    <img src="data:image/png;base64,@Model.QRImageBase64" 
                                         alt="QR Code" class="img-fluid border" style="max-width: 200px;" />
                                }
                                else
                                {
                                    <div class="bg-light border d-flex align-items-center justify-content-center" 
                                         style="width: 200px; height: 200px; margin: 0 auto;">
                                        <i class="fas fa-qrcode fa-3x text-muted"></i>
                                    </div>
                                }
                                <div class="mt-3">
                                    <a asp-action="PrintQR" asp-route-sessionId="@Model.SessionId" 
                                       class="btn btn-outline-primary btn-sm" target="_blank">
                                        <i class="fas fa-print me-2"></i>Print QR Identity
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="text-primary mb-3">QR Identity Information</h6>
                                
                                <div class="mb-3">
                                    <small class="text-muted">QR Identity:</small>
                                    <div class="fw-bold fs-6 text-primary" id="qrIdentity">@Model.QRIdentity</div>
                                    <button class="btn btn-link btn-sm p-0" onclick="copyToClipboard('qrIdentity')">
                                        <i class="fas fa-copy"></i> Copy
                                    </button>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">File Name:</small>
                                    <div class="fw-bold">@Model.FileName</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Generated Date:</small>
                                    <div class="fw-bold">@Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Generated By:</small>
                                    <div class="fw-bold">@Model.GeneratedBy</div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Status:</small>
                                    <div>
                                        <span class="badge bg-success fs-6">
                                            <i class="fas fa-check-circle me-1"></i>@Model.Status
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Total Boxes:</small>
                                    <div class="fw-bold text-warning fs-5">@Model.TotalBoxes.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="col-lg-4">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h6 class="mb-0"><i class="fas fa-cogs me-2"></i>QR Management Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="DownloadPDF" asp-route-sessionId="@Model.SessionId" 
                           class="btn btn-success">
                            <i class="fas fa-download me-2"></i>Download PDF Barcodes
                        </a>

                        <a asp-action="GetQRImage" asp-route-sessionId="@Model.SessionId" 
                           class="btn btn-info" download="QR_@(Model.SessionId).png">
                            <i class="fas fa-image me-2"></i>Download QR Image
                        </a>

                        <hr />

                        <button type="button" class="btn btn-outline-primary" onclick="showBarcodeModal()">
                            <i class="fas fa-list me-2"></i>View All Barcodes
                        </button>

                        <button type="button" class="btn btn-outline-secondary" onclick="shareQR()">
                            <i class="fas fa-share-alt me-2"></i>Share QR Code
                        </button>
                    </div>
                </div>
            </div>

            <!-- QR History Card -->
            <div class="card border-info mt-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-history me-2"></i>QR History</h6>
                </div>
                <div class="card-body">
                    <div class="small">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Last Generated:</span>
                            <span class="fw-bold">@Model.GeneratedDate.ToString("dd/MM HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Status:</span>
                            <span class="badge bg-success">Active</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Scan Count:</span>
                            <span class="fw-bold">0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barcode List Modal -->
<div class="modal fade" id="barcodeModal" tabindex="-1" aria-labelledby="barcodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="barcodeModalLabel">
                    <i class="fas fa-barcode me-2"></i>All Box Barcodes (@Model.TotalBoxes)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @foreach (var barcode in Model.BarcodeList)
                    {
                        <div class="col-md-6 mb-2">
                            <div class="card card-body bg-light">
                                <small class="text-muted">Box Barcode:</small>
                                <code class="small">@barcode</code>
                                <button class="btn btn-link btn-sm p-0" onclick="copyToClipboard('barcode-@barcode.GetHashCode()')">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                                <span id="barcode-@barcode.GetHashCode()" style="display: none;">@barcode</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="copyAllBarcodes()">
                    <i class="fas fa-copy me-2"></i>Copy All Barcodes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/qr.js" asp-append-version="true"></script>
    <script>
        function showBarcodeModal() {
            const modal = new bootstrap.Modal(document.getElementById('barcodeModal'));
            modal.show();
        }

        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent || element.innerText;
            
            navigator.clipboard.writeText(text).then(function() {
                showAlert('Copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function copyAllBarcodes() {
            const barcodes = @Html.Raw(Json.Serialize(Model.BarcodeList));
            const barcodeText = barcodes.join('\n');
            
            navigator.clipboard.writeText(barcodeText).then(function() {
                showAlert('All barcodes copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy barcodes: ', err);
                showAlert('Failed to copy barcodes to clipboard', 'danger');
            });
        }

        function shareQR() {
            if (navigator.share) {
                navigator.share({
                    title: 'QR Identity Code',
                    text: 'QR Identity: @Model.QRIdentity',
                    url: window.location.href
                }).then(() => {
                    console.log('QR shared successfully');
                }).catch((error) => {
                    console.log('Error sharing QR:', error);
                    fallbackShare();
                });
            } else {
                fallbackShare();
            }
        }

        function fallbackShare() {
            const shareData = `QR Identity: @Model.QRIdentity\nGenerated: @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")\nTotal Boxes: @Model.TotalBoxes\nLink: ${window.location.href}`;
            
            navigator.clipboard.writeText(shareData).then(function() {
                showAlert('QR information copied to clipboard for sharing!', 'info');
            }, function(err) {
                console.error('Could not copy share data: ', err);
                showAlert('Could not prepare share data', 'danger');
            });
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 5000);
        }

        if (window.QR && typeof window.QR.initManage === 'function') {
            window.QR.initManage({ sessionId: @Model.SessionId });
        }
    </script>
}
