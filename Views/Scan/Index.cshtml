@model List<ShipmentFinishGood.DTOs.ScanSessionSummaryDto>
@{
    ViewData["Title"] = "Scanner Dashboard";
}
@section Styles {<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">
            <i class="fas fa-barcode me-2"></i>Scanner Dashboard
        </h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="refreshSessions()">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
            <a asp-action="History" class="btn btn-outline-info">
                <i class="fas fa-history me-1"></i>Scan History
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model?.Any() == true)
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count</div>
                                <div class="small">Available Sessions</div>
                            </div>
                            <i class="fas fa-layer-group fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count(s => s.Status == "Ready")</div>
                                <div class="small">Ready to Scan</div>
                            </div>
                            <i class="fas fa-play-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count(s => s.Status == "In Progress")</div>
                                <div class="small">In Progress</div>
                            </div>
                            <i class="fas fa-spinner fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Sum(s => s.TotalBoxes)</div>
                                <div class="small">Total Boxes</div>
                            </div>
                            <i class="fas fa-boxes fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sessions List -->
        <div class="row">
            @foreach (var session in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100 border-left-@(GetStatusColor(session.Status))">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 text-primary">
                                    <i class="fas fa-file-excel me-2"></i>@session.FileName
                                </h6>
                                <span class="badge bg-@GetStatusColor(session.Status)">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Session Info -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Shipment Type:</small>
                                    <div class="fw-bold">@session.ShipmentType</div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Total Boxes:</small>
                                    <div class="fw-bold text-primary">@session.TotalBoxes</div>
                                </div>
                            </div>

                            <!-- QR Identity -->
                            <div class="mb-3">
                                <small class="text-muted">QR Identity:</small>
                                <div class="font-monospace small bg-light p-2 rounded">
                                    @session.QRIdentity
                                    <button class="btn btn-outline-secondary btn-sm ms-2" onclick="copyToClipboard('@session.QRIdentity')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Assigned Area -->
                            @if (!string.IsNullOrEmpty(session.AssignedArea))
                            {
                                <div class="mb-3">
                                    <small class="text-muted">Assigned Area:</small>
                                    <div>
                                        <span class="badge bg-info">Area @session.AssignedArea</span>
                                    </div>
                                </div>
                            }

                            <!-- Session Details -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Created:</small>
                                    <div class="small">@session.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Created By:</small>
                                    <div class="small">@session.CreatedBy</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="StartScan" asp-route-sessionId="@session.SessionId" 
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-qrcode me-1"></i>Start Scanning
                                </a>
                                <a asp-action="SessionDetail" asp-route-sessionId="@session.SessionId" 
                                   class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-eye me-1"></i>View Detail
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-center py-5">
                            <i class="fas fa-barcode fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Sessions Available</h4>
                            <p class="text-muted">There are no scanning sessions available at the moment. Please check back later or contact administrator.</p>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showAlert('QR Identity copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function refreshSessions() {
            location.reload();
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 3000);
        }

        // Auto-refresh every 30 seconds
        setInterval(refreshSessions, 30000);
    </script>
}

@functions {
    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Ready" => "success",
            "In Progress" => "warning", 
            "Completed" => "info",
            "Pending" => "secondary",
            _ => "secondary"
        };
    }
}
