@model List<ShipmentFinishGood.DTOs.ScanSessionSummaryDto>
@{
    ViewData["Title"] = "Scanner Dashboard - Hierarchical Lock System";
}
@section Styles {
<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/recent-scans.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/scanner-card.css" asp-append-version="true" />
}

<div class="container py-4">
    <!-- Clean Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-dark fw-bold">
            <i class="fas fa-qrcode me-2 text-primary"></i>Hierarchical Lock Scanner
        </h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" onclick="refreshHierarchicalState()">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
            <a asp-action="History" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-history me-1"></i>History
            </a>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    <form id="afToken" class="d-none">@Html.AntiForgeryToken()</form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ===== CLEAN HIERARCHICAL LOCK UI ===== -->
    
    <!-- Status and Session Selection Row -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div id="hierarchical-lock-status"></div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h6 class="mb-0 text-dark fw-semibold">
                        <i class="fas fa-database me-2 text-primary"></i>Session Selection
                    </h6>
                </div>
                <div class="card-body">
                    <select class="form-select mb-3" id="sessionSelectEnhanced">
                        <option value="">-- Select Session to Lock --</option>
                    </select>
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" id="initializeSessionBtn" disabled>
                            <i class="fas fa-play me-2"></i>Initialize Session
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="refreshSessionList()">
                            <i class="fas fa-sync-alt me-2"></i>Refresh Sessions
                        </button>
                    </div>
                    <div class="mt-3" id="sessionPreview" style="display: none;">
                        <!-- Session details will be shown here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Clean Main Scanning Interface -->
    <div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 shadow" id="scannerCard">
            <div class="card-header bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-dark fw-semibold">
                            <i class="fas fa-qrcode me-2 text-primary"></i>Scanner Interface
                        </h6>
                        <small class="text-muted" id="scanHelpText">Initialize session to begin scanning</small>
                    </div>
                            <span id="headerLockStatus" class="ms-2"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-1 scanner-controls">
                        <button class="btn btn-outline-light btn-sm scanner-control-btn" id="selectPOButton" 
                                onclick="showPOSelector()" title="Select PO for scanning" style="display: none;">
                            <i class="fas fa-list-check"></i>
                        </button>
                        <button class="btn btn-outline-light btn-sm scanner-control-btn" onclick="refreshHierarchicalState()" 
                                title="Refresh hierarchical state">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button class="btn btn-outline-warning btn-sm scanner-control-btn" onclick="resetHierarchicalLock()" 
                                title="Reset hierarchical lock" style="display: none;" id="resetLockBtn">
                            <i class="fas fa-unlock"></i>
                        </button>
                        <button class="btn btn-outline-info btn-sm scanner-control-btn" onclick="logCurrentState()" 
                                title="Debug: Show current state" id="debugStateBtn">
                            <i class="fas fa-bug"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body py-3 scanner-body">
                <div class="row align-items-center main-scanner-section">
                    <!-- Enhanced Input Section -->
                    <div class="col-xl-6 col-lg-7 col-md-12 mb-3">
                        <div class="scanner-input-group">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text scanner-icon-bg">
                                    <i class="fas fa-crosshairs scanner-crosshair"></i>
                                </span>
                                <input type="text" 
                                       id="mainScanInput" 
                                       class="form-control scanner-input" 
                                       placeholder="� Initialize session first..." 
                                       autocomplete="off" 
                                       spellcheck="false"
                                       inputmode="text"
                                       aria-label="Scan input"
                                       aria-describedby="scanHelp"
                                       disabled>
                                <button class="btn btn-primary scan-submit-btn" type="button" onclick="processHierarchicalScan()" 
                                        aria-label="Process scan" disabled id="scanSubmitBtn">
                                    <i class="fas fa-check scan-check-icon"></i>
                                    <span class="scan-button-text d-none d-lg-inline">Scan</span>
                                </button>
                            </div>
                            <div id="scanHelp" class="form-text scanner-help">
                                <i class="fas fa-info-circle me-1"></i>
                                <span id="scanHelpText">Initialize session → Scan Master QR → Select PO → Scan Items</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Enhanced Status Panel -->
                    <div class="col-xl-6 col-lg-5 col-md-12 mb-3">
                        <div id="scanStatus" class="scanner-status-panel hierarchical-enhanced" role="status" aria-live="polite">
                            <div class="status-header-hierarchical">
                                <div class="status-icon-section">
                                    <i class="fas fa-shield-alt status-icon-large text-primary"></i>
                                </div>
                                <div class="status-content-section">
                                    <div class="status-label-large">Lock Status</div>
                                    <div class="status-badge-container-large">
                                        <span class="badge status-badge-large bg-secondary" id="statusBadge">Not Initialized</span>
                                    </div>
                                </div>
                            </div>
                            <div class="status-details-hierarchical" id="statusDetail">
                                <div id="lockStatusIndicator" class="lock-status-large">
                                    Select session to initialize hierarchical lock system
                                </div>
                                <div id="poStatusIndicator" class="po-status-large" style="display: none;">
                                    <!-- PO status will be shown here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Hierarchical Progress Bar -->
                <div class="hierarchical-progress-container" id="hierarchicalProgress" style="display: none;">
                    <div class="progress-header">
                        <span class="progress-title">
                            <i class="fas fa-chart-line me-2"></i>Scanning Progress
                        </span>
                        <span class="progress-percentage" id="overallProgressPercentage">0%</span>
                    </div>
                    <div class="progress-bar-hierarchical">
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" 
                                 style="width: 0%" id="overallProgressBar"></div>
                        </div>
                    </div>
                    <div class="progress-details mt-2" id="progressBreakdown">
                        <!-- Progress breakdown will be shown here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- PO Selector Modal Container -->
    <div id="po-selector-container"></div>

    <!-- Enhanced Recent Scans with PO Filtering -->
    <div class="row mb-4">
        <div class="col-12">
            <div id="enhanced-recent-scans"></div>
        </div>
    </div>

    @if (Model?.Any() == true)
    {

    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-center py-5">
                            <i class="fas fa-barcode fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Sessions Available</h4>
                            <p class="text-muted">There are no scanning sessions available at the moment. Please check for sessions that need QR generation.</p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <button class="btn btn-primary" onclick="checkForValidatedSessions()">
                                    <i class="fas fa-search me-2"></i>Check for Sessions
                                </button>
                                <a asp-controller="PO" asp-action="Index" class="btn btn-outline-primary">
                                    <i class="fas fa-upload me-2"></i>Upload New PO
                                </a>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-home me-2"></i>Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- SignalR for real-time updates (CDN with local fallback via onerror) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" 
            onerror="(function(){var s=document.createElement('script');s.src='/lib/microsoft/signalr/dist/browser/signalr.js';s.defer=true;document.head.appendChild(s);})();"></script>
    
    <!-- Hierarchical Lock System Components -->
    <script src="~/js/hierarchical-lock-manager.js" asp-append-version="true"></script>
    <script src="~/js/po-selector-component.js" asp-append-version="true"></script>
    <script src="~/js/enhanced-recent-scans-component.js" asp-append-version="true"></script>
    <script src="~/js/hierarchical-lock-status-component.js" asp-append-version="true"></script>

    <script>
        // ===== PHASE 4: HIERARCHICAL LOCK SYSTEM INTEGRATION =====
        
        // Global instances
        let lockManager;
        let poSelector;
        let recentScansComponent;
        let statusComponent;
        let recentScansManager; // Add missing declaration
        
        // Session data from server
        let activeSessions = [
            @foreach (var session in Model)
            {
                @Html.Raw($"{{ sessionId: {session.SessionId}, qrIdentity: '{session.QRIdentity}', status: '{session.Status}', totalPOs: {session.TotalPOs}, completedPOs: {session.CompletedPOs} }},")
            }
        ];

        // Application state
        let currentSessionId = null;
        let currentPOId = null;
        let currentUserLock = null; // Add missing declaration
        let scanningEnabled = false;
        let resolvedBarcodes = new Map(); // Cache for barcode resolution to improve performance
        
        // Debug mode for development
        let debugMode = true; // Set to false in production
        
        // Enhanced debug logging
        function debugLog(message, data = null) {
            if (debugMode) {
                console.log(`🔧 [DEBUG] ${message}`, data || '');
            }
        }
        
        // State monitoring function with UI feedback
        function logCurrentState() {
            const state = {
                sessionId: currentSessionId,
                poId: currentPOId,
                userLock: currentUserLock,
                scanningEnabled: scanningEnabled,
                lockManagerAvailable: !!lockManager,
                poSelectorAvailable: !!poSelector,
                activeSessions: activeSessions.length,
                inputDisabled: document.getElementById('mainScanInput')?.disabled,
                submitDisabled: document.getElementById('scanSubmitBtn')?.disabled
            };
            
            console.log('📊 CURRENT STATE:', state);
            
            // Show state in UI alert
            const stateInfo = Object.entries(state)
                .map(([key, value]) => `${key}: ${value}`)
                .join('\n');
            
            showHierarchicalAlert(`Current State:\n${stateInfo}`, 'info');
            
            return state;
        }

        // ===== INITIALIZATION =====
        $(document).ready(function() {
            console.log('🚀 Initializing Hierarchical Lock System...');
            
            // Check if user is already locked to a session
            checkExistingUserLock();
            
            // Wait for hierarchical-lock-manager to be available
            function waitForLockManager() {
                if (typeof window.hierarchicalLockManager !== 'undefined') {
                    initializeHierarchicalLockSystem();
                    populateSessionSelector();
                    bindEventHandlers();
                    console.log('✅ Hierarchical Lock System initialized');
                } else {
                    console.log('⏳ Waiting for hierarchical-lock-manager...');
                    setTimeout(waitForLockManager, 100);
                }
            }
            
            waitForLockManager();
        });

        /**
         * Check if user is already locked to a session
         */
        async function checkExistingUserLock() {
            try {
                const response = await $.ajax({
                    url: '@Url.Action("GetUserLockedSession", "Scan")',
                    type: 'GET'
                });
                
                if (response.success && response.data) {
                    console.log('🔒 User already locked to session:', response.data);
                    
                    // Find the session
                    const lockedSession = activeSessions.find(s => s.qrIdentity === response.data);
                    if (lockedSession) {
                        currentUserLock = response.data;
                        currentSessionId = lockedSession.sessionId;
                        
                        // Update UI to show locked state
                        updateUIForExistingLock(lockedSession);
                        
                        // Enable scanning interface
                        enableScanningInterface();
                        
                        showHierarchicalAlert(`You are already locked to session ${response.data}. You can continue scanning.`, 'info');
                    }
                }
            } catch (error) {
                console.log('ℹ️ No existing lock found or error checking:', error);
            }
        }

        /**
         * Update UI for existing lock
         */
        function updateUIForExistingLock(session) {
            // Update session selector to show locked session
            const selector = document.getElementById('sessionSelectEnhanced');
            selector.value = session.sessionId;
            selector.disabled = true;
            
            // Update initialize button
            const initBtn = document.getElementById('initializeSessionBtn');
            initBtn.innerHTML = '🔒 Session Locked';
            initBtn.disabled = true;
            initBtn.classList.remove('btn-primary');
            initBtn.classList.add('btn-success');
            
            // Update status
            updateScanStatus('Session Locked', 'bg-success', `Locked to: ${session.qrIdentity}`);
        }

        /**
         * Enable scanning interface
         */
        function enableScanningInterface() {
            const scanInput = document.getElementById('mainScanInput');
            const scanBtn = document.getElementById('scanSubmitBtn');
            
            scanInput.disabled = false;
            scanInput.placeholder = '📱 Scan Master QR or continue with items...';
            scanInput.focus();
            scanBtn.disabled = false;
            
            // Update help text
            document.getElementById('scanHelpText').textContent = 'Ready to scan! Scan Master QR → Select PO → Scan Items';
            
            // Show controls
            document.getElementById('selectPOButton').style.display = 'inline-block';
            document.getElementById('resetLockBtn').style.display = 'inline-block';
            
            // Show progress container
            document.getElementById('hierarchicalProgress').style.display = 'block';
        }

        /**
         * Initialize all hierarchical lock components
         */
        function initializeHierarchicalLockSystem() {
            try {
                // Check if hierarchical lock manager is available
                if (!window.hierarchicalLockManager) {
                    console.warn('⚠️ HierarchicalLockManager not yet available, retrying...');
                    setTimeout(initializeHierarchicalLockSystem, 100);
                    return;
                }
                
                // Initialize lock manager
                lockManager = window.hierarchicalLockManager;
                
                // Initialize PO selector
                poSelector = new POSelectorComponent('po-selector-container', lockManager);
                
                // Initialize recent scans component
                recentScansComponent = new EnhancedRecentScansComponent('enhanced-recent-scans', lockManager);
                
                // Initialize status component
                statusComponent = new HierarchicalLockStatusComponent('hierarchical-lock-status', lockManager);
                
                // Make components globally available
                window.poSelector = poSelector;
                window.recentScansComponent = recentScansComponent;
                window.statusComponent = statusComponent;
                
                // Bind PO selector events
                poSelector.onPOSelected((po) => {
                    onPOSelected(po);
                });
                
                // Bind lock manager events
                lockManager.onStateChange((event, data) => {
                    onLockManagerStateChange(event, data);
                });
                
                lockManager.onError((type, message) => {
                    showHierarchicalAlert(message, 'danger');
                });
                
                console.log('🔧 All components initialized successfully');
                
            } catch (error) {
                console.error('❌ Failed to initialize hierarchical lock system:', error);
                showHierarchicalAlert(`Initialization failed: ${error.message}`, 'danger');
                
                // Retry after delay
                setTimeout(() => {
                    console.log('🔄 Retrying hierarchical lock system initialization...');
                    initializeHierarchicalLockSystem();
                }, 1000);
            }
        }

        /**
         * Populate session selector dropdown
         */
        function populateSessionSelector() {
            const selector = document.getElementById('sessionSelectEnhanced');
            
            selector.innerHTML = '<option value="">-- Select Session to Lock --</option>' +
                activeSessions.map(session => `
                    <option value="${session.sessionId}">
                        Session ${session.sessionId} - ${session.qrIdentity} (${session.totalPOs} POs)
                    </option>
                `).join('');
        }

        /**
         * Bind event handlers
         */
        function bindEventHandlers() {
            // Session selection
            document.getElementById('sessionSelectEnhanced').addEventListener('change', onSessionSelectionChange);
            document.getElementById('initializeSessionBtn').addEventListener('click', initializeSelectedSession);
            
            // Main scan input
            document.getElementById('mainScanInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    processHierarchicalScan();
                }
            });
            
            // Anti-forgery token for AJAX
            $.ajaxSetup({
                beforeSend: function(xhr, settings) {
                    if (!settings.crossDomain) {
                        xhr.setRequestHeader("RequestVerificationToken", 
                            $('input[name="__RequestVerificationToken"]').val());
                    }
                }
            });
        }

        // ===== SESSION MANAGEMENT =====

        /**
         * Handle session selection change
         */
        function onSessionSelectionChange() {
            const selector = document.getElementById('sessionSelectEnhanced');
            const initBtn = document.getElementById('initializeSessionBtn');
            const preview = document.getElementById('sessionPreview');
            
            if (selector.value) {
                const sessionId = parseInt(selector.value);
                const session = activeSessions.find(s => s.sessionId === sessionId);
                
                if (session) {
                    // Show session preview
                    preview.innerHTML = `
                        <div class="alert alert-info">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>QR Identity:</strong> ${session.qrIdentity}<br>
                                    <strong>Status:</strong> ${session.status}<br>
                                    <strong>POs:</strong> ${session.completedPOs}/${session.totalPOs} completed
                                </div>
                                <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('${session.qrIdentity}')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    preview.style.display = 'block';
                    initBtn.disabled = false;
                } else {
                    preview.style.display = 'none';
                    initBtn.disabled = true;
                }
            } else {
                preview.style.display = 'none';
                initBtn.disabled = true;
            }
        }

        /**
         * Initialize selected session
         */
        async function initializeSelectedSession() {
            const selector = document.getElementById('sessionSelectEnhanced');
            const sessionId = parseInt(selector.value);
            
            if (!sessionId) {
                showHierarchicalAlert('Please select a session first', 'warning');
                return;
            }
            
            // Check if lock manager is available
            if (!lockManager) {
                showHierarchicalAlert('System not ready. Please wait and try again.', 'warning');
                return;
            }
            
            try {
                showHierarchicalAlert('Initializing session...', 'info');
                
                const result = await lockManager.initializeSession(sessionId);
                if (result.success) {
                    currentSessionId = sessionId;
                    updateUIForSessionInitialized();
                    showHierarchicalAlert('Session initialized successfully! You can now scan Master QR.', 'success');
                } else {
                    throw new Error(result.error || 'Failed to initialize session');
                }
                
            } catch (error) {
                console.error('❌ Session initialization failed:', error);
                showHierarchicalAlert(`Failed to initialize session: ${error.message}`, 'danger');
            }
        }

        /**
         * Update UI when session is initialized
         */
        function updateUIForSessionInitialized() {
            // Enable scanning input
            const scanInput = document.getElementById('mainScanInput');
            const scanBtn = document.getElementById('scanSubmitBtn');
            
            scanInput.disabled = false;
            scanInput.placeholder = '📱 Scan Master QR to lock session...';
            scanBtn.disabled = false;
            
            // Focus and select all for better UX
            setTimeout(() => {
                scanInput.focus();
                scanInput.select();
            }, 100);
            
            // Update help text
            document.getElementById('scanHelpText').textContent = 'Scan Master QR → Select PO → Scan BOX/PALLET/PCS items';
            
            // Update status
            updateScanStatus('Session Initialized', 'bg-info', 'Scan Master QR to continue');
            
            // Show controls
            document.getElementById('selectPOButton').style.display = 'none'; // Will show after master scan
            document.getElementById('resetLockBtn').style.display = 'inline-block';
            
            // Show progress container
            document.getElementById('hierarchicalProgress').style.display = 'block';
            
            console.log('✅ UI updated for session initialization');
        }

        // ===== SCANNING LOGIC =====

        /**
         * Process hierarchical scan
         */
        async function processHierarchicalScan() {
            const input = document.getElementById('mainScanInput');
            const scannedValue = input.value.trim();
            
            console.log(`🔍 processHierarchicalScan called with: "${scannedValue}"`);
            console.log(`📊 Current state - SessionId: ${currentSessionId}, POId: ${currentPOId}, UserLock: ${currentUserLock}`);
            
            if (!scannedValue) {
                showHierarchicalAlert('Please scan or enter a barcode', 'warning');
                return;
            }
            
            // If no session but user is locked, try to recover session
            if (!currentSessionId && currentUserLock) {
                const lockedSession = activeSessions.find(s => s.qrIdentity === currentUserLock);
                if (lockedSession) {
                    currentSessionId = lockedSession.sessionId;
                    console.log('🔄 Recovered session ID from user lock:', currentSessionId);
                }
            }
            
            if (!currentSessionId) {
                showHierarchicalAlert('Please initialize a session first', 'warning');
                return;
            }
            
            try {
                console.log(`🔍 Processing scan: ${scannedValue}`);
                
                // Show processing indicator
                const scanBtn = document.getElementById('scanSubmitBtn');
                const originalText = scanBtn.innerHTML;
                scanBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                scanBtn.disabled = true;
                
                // Determine scan type and process accordingly
                if (isMasterQR(scannedValue)) {
                    console.log('🎯 Detected Master QR');
                    await processMasterQRScan(scannedValue);
                } else if (isBoxBarcode(scannedValue)) {
                    console.log('📦 Detected BOX barcode');
                    await processBoxScan(scannedValue);
                } else {
                    // For PALLET/PCS, check if PO is selected
                    if (!currentPOId) {
                        console.log('❌ No PO selected for PALLET/PCS scan');
                        showHierarchicalAlert('Please select a PO before scanning PALLET or PCS items', 'warning');
                        showPOSelector();
                        return;
                    }
                    
                    if (isPalletBarcode(scannedValue)) {
                        console.log('🚛 Detected PALLET barcode');
                        await processPalletScan(scannedValue);
                    } else if (isPCSBarcode(scannedValue)) {
                        console.log('🔢 Detected PCS barcode');
                        await processPCSScan(scannedValue);
                    } else {
                        console.log('❓ Unknown barcode format');
                        showHierarchicalAlert('Unknown barcode format. Please scan a valid QR or barcode.', 'warning');
                    }
                }
                
                // Restore scan button
                scanBtn.innerHTML = originalText;
                scanBtn.disabled = false;
                
            } catch (error) {
                console.error('❌ Scan processing failed:', error);
                showHierarchicalAlert(`Scan failed: ${error.message}`, 'danger');
                
                // Restore scan button
                const scanBtn = document.getElementById('scanSubmitBtn');
                scanBtn.innerHTML = '<i class="fas fa-check scan-check-icon"></i><span class="scan-button-text d-none d-lg-inline">Scan</span>';
                scanBtn.disabled = false;
            } finally {
                // Clear input for next scan
                input.value = '';
                input.focus();
            }
        }

        /**
         * Process Master QR scan with enhanced state management
         */
        async function processMasterQRScan(qrCode) {
            try {
                console.log(`🎯 Processing Master QR: ${qrCode}`);
                
                const response = await $.post('@Url.Action("ScanMasterQR", "Scan")', {
                    sessionId: currentSessionId,
                    qrCode: qrCode
                });
                
                console.log('🔍 Master QR Response:', response);
                
                if (response.success) {
