        // ===== UTILITY FUNCTIONS =====

        /**
         * Enhanced barcode validation functions with cache support
         */
        function isMasterQR(value) {
            return activeSessions.some(session => session.qrIdentity === value);
        }

        function isBoxBarcode(value) {
            if (!value || !value.includes('BOX')) return false;
            
            // If cache has it, it's valid
            if (resolvedBarcodes.has(value)) {
                console.log('✅ Box barcode found in cache');
                return true;
            }
            
            // If user is locked and barcode starts with locked QR, it's likely valid
            if (currentUserLock && value.includes('_BOX_')) {
                console.log('✅ Box barcode matches current lock pattern');
                return true;
            }
            
            return false;
        }

        function isPalletBarcode(value) {
            if (!value) return false;
            const upperValue = value.toUpperCase();
            return upperValue.includes('PALLET') || upperValue.includes('PLT');
        }

        function isPCSBarcode(value) {
            if (!value) return false;
            const upperValue = value.toUpperCase();
            return upperValue.startsWith('%Q') || upperValue.includes('PCS') || upperValue.includes('PC');
        }

        /**
         * Reset hierarchical lock system
         */
        function resetHierarchicalLock() {
            if (confirm('Are you sure you want to reset the hierarchical lock? All progress will be lost.')) {
                // Call backend to unlock user
                $.ajax({
                    url: '@Url.Action("UnlockUser", "Scan")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            console.log('✅ Server unlock successful');
                            performClientSideReset();
                        } else {
                            console.warn('⚠️ Server unlock failed, performing local reset anyway');
                            performClientSideReset();
                            showHierarchicalAlert('Server unlock failed, but local state reset. You may need to refresh the page.', 'warning');
                        }
                    },
                    error: function() {
                        console.warn('❌ Server unlock error, performing local reset');
                        performClientSideReset();
                        showHierarchicalAlert('Server unlock failed, but local state reset. You may need to refresh the page.', 'warning');
                    }
                });
            }
        }

        function performClientSideReset() {
            // Reset state
            currentSessionId = null;
            currentPOId = null;
            scanningEnabled = false;
            
            // Reset lock manager
            if (lockManager) {
                lockManager.resetSession();
            }
            
            // Reset UI
            const scanInput = document.getElementById('mainScanInput');
            const scanBtn = document.getElementById('scanSubmitBtn');
            
            scanInput.disabled = true;
            scanInput.placeholder = '🔒 Initialize session first...';
            scanBtn.disabled = true;
            
            updateScanStatus('Not Initialized', 'bg-secondary', 'Select session to initialize hierarchical lock system');
            
            document.getElementById('selectPOButton').style.display = 'none';
            document.getElementById('resetLockBtn').style.display = 'none';
            document.getElementById('hierarchicalProgress').style.display = 'none';
            document.getElementById('poStatusIndicator').style.display = 'none';
            
            // Reset session selector
            document.getElementById('sessionSelectEnhanced').value = '';
            document.getElementById('sessionPreview').style.display = 'none';
            document.getElementById('initializeSessionBtn').disabled = true;
            
            showHierarchicalAlert('Hierarchical lock system reset successfully', 'info');
        }

        /**
         * Copy to clipboard utility
         */
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showHierarchicalAlert('Text copied to clipboard! 📋', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showHierarchicalAlert('Failed to copy to clipboard', 'danger');
            });
        }

        /**
         * Show hierarchical alert with enhanced debugging
         */
        function showHierarchicalAlert(message, type) {
            console.log(`🔔 Alert [${type.toUpperCase()}]: ${message}`);
            
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                if (alertElement.parentNode) {
                    alertElement.remove();
                }
            }, 5000);
        }

