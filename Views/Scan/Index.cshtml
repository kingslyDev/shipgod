        function updateScannerStatusLine() {
            const statusLine = $('#scannerStatusLine');
            const now = new Date();
            
            if (currentUserLock) {
                const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                if (session) {
                    statusLine.text(`Active: ${session.fileName}`);
                } else {
                    statusLine.text(`Active: ${currentUserLock}`);
                }
            } else {
                const timeString = now.toLocaleTimeString('en-US', { 
                    hour12: false, 
                    hour: '2-digit', 
                    minute: '2-digit' 
                });
                statusLine.text(`Ready to scan • ${timeString}`);
            }
        }

        // Interactive feedback functions
        function playFeedbackSound(type) {
            // Create audio context for sound feedback
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                switch(type) {
                    case 'success':
                        oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
                        oscillator.frequency.exponentialRampToValueAtTime(1200, audioContext.currentTime + 0.1);
                        gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                        oscillator.start(audioContext.currentTime);
                        oscillator.stop(audioContext.currentTime + 0.2);
                        break;
                    case 'error':
                        oscillator.frequency.setValueAtTime(400, audioContext.currentTime);
                        oscillator.frequency.exponentialRampToValueAtTime(200, audioContext.currentTime + 0.2);
                        gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                        oscillator.start(audioContext.currentTime);
                        oscillator.stop(audioContext.currentTime + 0.3);
                        break;
                    case 'scan':
                        oscillator.frequency.setValueAtTime(600, audioContext.currentTime);
                        gainNode.gain.setValueAtTime(0.05, audioContext.currentTime);
                        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
                        oscillator.start(audioContext.currentTime);
                        oscillator.stop(audioContext.currentTime + 0.1);
                        break;
                }
            } catch (e) {
                // Silent fail if audio not supported
                console.log('Audio feedback not available');
            }
        }

        function triggerHapticFeedback(type) {
            // Haptic feedback for mobile devices
            if ('vibrate' in navigator) {
                switch(type) {
                    case 'success':
                        navigator.vibrate([100, 50, 100]);
                        break;
                    case 'error':
                        navigator.vibrate([200, 100, 200, 100, 200]);
                        break;
                    case 'scan':
                        navigator.vibrate(50);
                        break;
                }
            }
        }

        function showVisualFeedback(type, message) {
            const scannerCard = $('#scannerCard');
            const feedbackOverlay = $('<div class="scanner-feedback-overlay"></div>');
            
            let icon, bgClass, textClass;
            switch(type) {
                case 'success':
                    icon = 'fas fa-check-circle';
                    bgClass = 'bg-success';
                    textClass = 'text-white';
                    break;
                case 'error':
                    icon = 'fas fa-times-circle';
                    bgClass = 'bg-danger';
                    textClass = 'text-white';
                    break;
                case 'warning':
                    icon = 'fas fa-exclamation-triangle';
                    bgClass = 'bg-warning';
                    textClass = 'text-dark';
                    break;
                case 'info':
                    icon = 'fas fa-info-circle';
                    bgClass = 'bg-info';
                    textClass = 'text-white';
                    break;
            }
            
            feedbackOverlay.addClass(`${bgClass} ${textClass}`).html(`
                <div class="feedback-content">
                    <i class="${icon} feedback-icon"></i>
                    <div class="feedback-message">${message}</div>
                </div>
            `);
            
            // Add CSS for overlay
            feedbackOverlay.css({
                position: 'absolute',
                top: 0,
                left: 0,
                right: 0,
                bottom: 0,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                zIndex: 1000,
                borderRadius: '16px',
                opacity: 0,
                transform: 'scale(0.8)'
            });
            
            scannerCard.css('position', 'relative').append(feedbackOverlay);
            
            // Animate in
            feedbackOverlay.animate({
                opacity: 0.95,
                transform: 'scale(1)'
            }, 200, () => {
                // Animate out after delay
                setTimeout(() => {
                    feedbackOverlay.animate({
                        opacity: 0,
                        transform: 'scale(0.8)'
                    }, 200, () => {
                        feedbackOverlay.remove();
                    });
                }, 1500);
            });
        }

        function provideFeedback(type, message) {
            playFeedbackSound(type);
            triggerHapticFeedback(type);
            showVisualFeedback(type, message);
        }

        // Manual lock to session function
        function lockToSession(qrIdentity) {
            const session = activeSessions.find(s => s.qrIdentity === qrIdentity);
            if (!session) {
                showAlert('Session not found', 'danger');
                return;
            }

            // Call backend to lock to session
            $.ajax({
                url: '@Url.Action("ScanMasterQR", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    qrCode: qrIdentity
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        currentUserLock = qrIdentity;
                        currentSessionGroup = session.sessionId;
                        
                        // Save to session storage for persistence
                        saveUserLockState(qrIdentity, session);
                        
                        // Join SignalR session group
                        if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                            joinSessionGroup(session.sessionId);
                        }
                        
                        // Clear barcode cache
                        resolvedBarcodes.clear();
                        
                        // Update UI
                        updateScanStatus('locked', `Locked to: ${session.fileName}`, 'success');
                        updateUIForLockedState(session);
                        updateUILockState(true, session.fileName);
                        updateLockStatusIndicator();
                        
                        // Clear input and focus
                        $('#mainScanInput').val('').focus();
                        
                        // Show recent scans
                        if (recentScansManager) {
                            recentScansManager.show(session.sessionId);
                        }
                        
                        showAlert(`✅ Successfully locked to session: ${session.fileName}`, 'success');
                    } else {
                        showAlert(`❌ Failed to lock to session: ${response.message}`, 'danger');
                    }
                },
                error: function() {
                    showAlert('Error locking to session. Please try again.', 'danger');
                }
            });
        }

        // Manual unlock from session function
        function unlockFromSession() {
            if (!currentUserLock) {
                showAlert('No active session to unlock', 'warning');
                return;
            }

            // Call backend to unlock
            $.ajax({
                url: '@Url.Action("UnlockFromSession", "Scan")',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Clear current lock
                        const previousLock = currentUserLock;
                        currentUserLock = null;
                        
                        // Leave SignalR session group
                        if (currentSessionGroup && signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                            leaveSessionGroup(currentSessionGroup);
                        }
                        currentSessionGroup = null;
                        
                        // Clear session storage
                        clearUserLockState();
                        
                        // Clear barcode cache
                        resolvedBarcodes.clear();
                        
                        // Update UI
                        updateScanStatus('ready', 'Ready to scan QR Identity', 'secondary');
                        updateUILockState(false);
                        updateLockStatusIndicator();
                        
                        // Hide recent scans
                        if (recentScansManager) {
                            recentScansManager.hide();
                        }
                        
