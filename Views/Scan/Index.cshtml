        // Update scan status display
        function updateScanStatus(status, message, badgeClass) {
            const statusBadge = $('#statusBadge');
            const statusDetail = $('#statusDetail');
            
            statusBadge.removeClass('bg-secondary bg-success bg-warning bg-danger')
                      .addClass(`bg-${badgeClass}`);
            
            switch(status) {
                case 'ready':
                    statusBadge.text('Ready to Scan');
                    updateScannerCardState('ready');
                    updateScanHelpText('normal');
                    break;
                case 'locked':
                    statusBadge.text('Session Locked');
                    updateScannerCardState('locked');
                    updateScanHelpText('locked');
                    break;
                case 'scanning':
                    statusBadge.text('Scanning Items');
                    updateScannerCardState('scanning');
                    break;
                case 'loading':
                    statusBadge.text('Loading...');
                    updateScannerCardState('loading');
                    break;
                case 'error':
                    statusBadge.text('Error');
                    updateScannerCardState('error');
                    updateScanHelpText('error');
                    break;
                case 'completed':
                    statusBadge.text('Completed');
                    updateScannerCardState('success');
                    break;
            }
        }

