                        @:{
                        @:    sessionId: @session.SessionId,
                        @:    fileName: '@Html.Raw(session.FileName.Replace("'", "\\'"))',
                        @:    qrIdentity: '@Html.Raw((session.QRIdentity ?? string.Empty).Replace("'", "\\'"))',
                        @:    materialCode: '@Html.Raw(session.FileName.Replace("'", "\\'"))', // Use filename as material code for now
                        @:    supplierName: 'Session @session.SessionId', // Default supplier name
                        @:    uploadDate: '@session.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")',
                        @:    status: '@session.Status',
                        @:    totalBoxes: @session.TotalBoxes,
                        @:    totalPOs: @session.TotalPOs,
                        @:    isCompleted: @session.Status.ToLower().Contains("completed").ToString().ToLower()
                        @:},
