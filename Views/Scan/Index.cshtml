        window.processHierarchicalScan = processHierarchicalScan;
        window.showPOSelector = showPOSelector;
        window.resetHierarchicalLock = resetHierarchicalLock;
        window.copyToClipboard = copyToClipboard;
        
        function populateSessionDropdown() {
            const select = document.getElementById('sessionSelect');
            select.innerHTML = '<option value="">-- Select Session --</option>';
            
            activeSessions.forEach(session => {
                const option = document.createElement('option');
                option.value = session.qrIdentity;
                option.textContent = `${session.materialCode || session.fileName} (${session.qrIdentity})`;
                option.setAttribute('data-session', JSON.stringify(session));
                select.appendChild(option);
            });

            // Update current selection if locked
            if (currentUserLock) {
                select.value = currentUserLock;
                onQuickSessionChange();
            }
        }

        function onQuickSessionChange() {
            const select = document.getElementById('sessionSelect');
            const quickLockBtn = document.getElementById('quickLockBtn');
            const quickUnlockBtn = document.getElementById('quickUnlockBtn');
            const sessionInfoMini = document.getElementById('sessionInfoMini');

            if (select.value) {
                const selectedOption = select.options[select.selectedIndex];
                const sessionData = JSON.parse(selectedOption.getAttribute('data-session') || '{}');
                
                // Show session info
                const createdDate = new Date(sessionData.uploadDate);
                const formattedDate = createdDate.toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                sessionInfoMini.innerHTML = `
                    <strong>${sessionData.materialCode || sessionData.fileName}</strong><br>
                    <small>Created: ${formattedDate} | Status: ${sessionData.status}</small>
                `;
                sessionInfoMini.style.display = 'block';

                // Show appropriate button
                if (currentUserLock === select.value) {
                    quickLockBtn.style.display = 'none';
                    quickUnlockBtn.style.display = 'inline-block';
                } else {
                    quickLockBtn.disabled = false;
                    quickLockBtn.style.display = 'inline-block';
                    quickUnlockBtn.style.display = 'none';
                }
            } else {
                sessionInfoMini.style.display = 'none';
                quickLockBtn.disabled = true;
                quickLockBtn.style.display = 'inline-block';
                quickUnlockBtn.style.display = 'none';
            }

            updateLockStatusIndicator();
        }

