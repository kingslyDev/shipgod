@model List<ShipmentFinishGood.DTOs.ScanSessionSummaryDto>
@{
    ViewData["Title"] = "Scanner Dashboard";
}
@section Styles {<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">
            <i class="fas fa-barcode me-2"></i>Scanner Dashboard
        </h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="refreshSessions()">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
            <a asp-action="History" class="btn btn-outline-info">
                <i class="fas fa-history me-1"></i>Scan History
            </a>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    <form id="afToken" class="d-none">@Html.AntiForgeryToken()</form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Scanning Input -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-qrcode me-2"></i>Smart Scanner
                        </h5>
                        <button class="btn btn-outline-light btn-sm" onclick="manualRefreshSessions()" title="Refresh QR data">
                            <i class="fas fa-sync-alt me-1"></i>Refresh QR Data
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">
                                    <i class="fas fa-crosshairs"></i>
                                </span>
                                <input type="text" 
                                       id="mainScanInput" 
                                       class="form-control form-control-lg" 
                                       placeholder="📱 Scan QR Identity or Box Barcode here..." 
                                       autocomplete="off" 
                                       spellcheck="false"
                                       inputmode="text"
                                       aria-label="Scan input for QR Identity or Box Barcode"
                                       aria-describedby="scanHelp"
                                       autofocus>
                                <button class="btn btn-primary btn-lg" type="button" onclick="processScan()" aria-label="Scan input">
                                    <i class="fas fa-check me-1"></i>Scan
                                </button>
                            </div>
                            <div id="scanHelp" class="form-text">
                                <strong>Instructions:</strong> 
                                First scan QR Identity to lock session, then scan box barcodes.
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div id="scanStatus" class="text-center" role="status" aria-live="polite">
                                <div class="h6 mb-1">Status</div>
                                <span class="badge bg-secondary fs-6 px-3 py-2" id="statusBadge">Ready to Scan</span>
                                <div class="small text-muted mt-2" id="statusDetail">
                                    Scan QR Identity to begin
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Any() == true)
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count</div>
                                <div class="small">Available Sessions</div>
                            </div>
                            <i class="fas fa-layer-group fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count(s => s.Status == "Ready")</div>
                                <div class="small">Ready to Scan</div>
                            </div>
                            <i class="fas fa-play-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count(s => s.Status == "In Progress")</div>
                                <div class="small">In Progress</div>
                            </div>
                            <i class="fas fa-spinner fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Sum(s => s.TotalBoxes)</div>
                                <div class="small">Total Boxes</div>
                            </div>
                            <i class="fas fa-boxes fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Guide (replaces per-session list) -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-qrcode text-primary fa-3x me-3" aria-hidden="true"></i>
                        <div>
                            <div class="h5 mb-1">Step 1 — Scan QR Identity</div>
                            <div class="text-muted">Lock to a session by scanning the printed QR Identity.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex align-items-center">
                        <i class="fas fa-box-open text-success fa-3x me-3" aria-hidden="true"></i>
                        <div>
                            <div class="h5 mb-1">Step 2 — Scan Box Barcodes</div>
                            <div class="text-muted">Scan each box barcode. Progress updates automatically.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-center py-5">
                            <i class="fas fa-barcode fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Sessions Available</h4>
                            <p class="text-muted">There are no scanning sessions available at the moment. Please check for sessions that need QR generation.</p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <button class="btn btn-primary" onclick="checkForValidatedSessions()">
                                    <i class="fas fa-search me-2"></i>Check for Sessions
                                </button>
                                <a asp-controller="PO" asp-action="Index" class="btn btn-outline-primary">
                                    <i class="fas fa-upload me-2"></i>Upload New PO
                                </a>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-home me-2"></i>Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        let currentUserLock = null;
        let activeSessions = [];

        // Initialize on page load
        $(document).ready(function() {
            // Focus on main scan input
            $('#mainScanInput').focus();
            
            // Enter key support
            $('#mainScanInput').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    processScan();
                }
            });

            // Check user lock status on load
            checkUserLockStatus();
            
            // Load available sessions for reference
            loadAvailableSessions();
            
            // Auto-refresh sessions every 30 seconds to keep data current
            setInterval(function() {
                console.log('🔄 Auto-refreshing sessions (30s interval)...');
                refreshSessions();
            }, 30000);
        });

        // Main scanning function
        function processScan() {
            const input = $('#mainScanInput');
            const scannedValue = input.val().trim();
            
            if (!scannedValue) {
                showAlert('Please enter or scan a value', 'warning');
                input.focus();
                return;
            }

            // Enhanced debug logging
            console.log('=== SCAN ATTEMPT ===');
            console.log('Scanned value:', scannedValue);
            console.log('Scanned value length:', scannedValue.length);
            console.log('Starts with QR_:', scannedValue.startsWith('QR_'));
            console.log('Active sessions count:', activeSessions.length);
            console.log('Available QR identities:', activeSessions.map(s => s.qrIdentity));
            
            // Check for exact matches
            const exactMatch = activeSessions.find(s => s.qrIdentity === scannedValue);
            console.log('Exact match found:', !!exactMatch);
            if (exactMatch) {
                console.log('Matched session:', exactMatch);
            }
            
            // Check for partial matches
            const partialMatches = activeSessions.filter(s => 
                scannedValue.includes(s.qrIdentity) || s.qrIdentity.includes(scannedValue)
            );
            console.log('Partial matches:', partialMatches);
            
            console.log('Is Master QR:', isMasterQR(scannedValue));
            console.log('Is Box Barcode:', isBoxBarcode(scannedValue));
            console.log('=== END SCAN ATTEMPT ===');

            // Determine scan type and process
            if (isMasterQR(scannedValue)) {
                processMasterQR(scannedValue);
            } else if (isBoxBarcode(scannedValue)) {
                processBoxBarcode(scannedValue);
            } else {
                // If not recognized, try refreshing sessions first
                console.log('⚠️ QR/Barcode not recognized, refreshing sessions...');
                showAlert('QR not recognized, refreshing data...', 'info');
                
                refreshSessions().then(() => {
                    console.log('🔄 Retrying validation after refresh...');
                    console.log('Updated sessions count:', activeSessions.length);
                    console.log('Updated QR identities:', activeSessions.map(s => s.qrIdentity));
                    
                    // Try again after refresh
                    if (isMasterQR(scannedValue)) {
                        console.log('✅ Master QR recognized after refresh');
                        processMasterQR(scannedValue);
                    } else if (isBoxBarcode(scannedValue)) {
                        console.log('✅ Box Barcode recognized after refresh');
                        processBoxBarcode(scannedValue);
                    } else {
                        console.log('❌ Still not recognized after refresh');
                        showAlert('Invalid QR/Barcode format. Please scan a valid QR Identity or Box Barcode.', 'danger');
                        input.focus();
                    }
                });
                return;
            }

            // Clear input after processing
            input.val('').focus();
        }

        // Check if scanned value is Master QR
        function isMasterQR(value) {
            // Master QR format: QR_sessionId_timestamp (exact match with available sessions)
            // Also check if it's a valid QR format that starts with QR_
            if (!value.startsWith('QR_')) return false;
            
            return activeSessions.some(session => session.qrIdentity === value);
        }

        // Check if scanned value is Box Barcode
        function isBoxBarcode(value) {
            // Box barcode format: QR_sessionId_timestamp_BOX_model_number
            if (!value.includes('_BOX_')) return false;
            
            return activeSessions.some(session => 
                value.startsWith(session.qrIdentity + '_BOX_'));
        }

        // Process Master QR scan
        function processMasterQR(qrCode) {
            const session = activeSessions.find(s => s.qrIdentity === qrCode);
            if (!session) {
                showAlert('QR Identity not found in available sessions', 'danger');
                return;
            }

            // Check if user is already locked to different session
            if (currentUserLock && currentUserLock !== qrCode) {
                showAlert(`You are already locked to session: ${currentUserLock}. Complete that session first.`, 'warning');
                return;
            }

            // Call backend to scan Master QR
            $.ajax({
                url: '@Url.Action("ScanMasterQR", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    qrCode: qrCode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        currentUserLock = qrCode;
                        updateScanStatus('locked', `Locked to: ${session.fileName}`, 'success');
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Clear input and focus for box scanning
                        $('#mainScanInput').val('').focus();
                        
                        // Update UI to show locked state
                        updateUIForLockedState(session);
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                    }
                },
                error: function() {
                    showAlert('Error scanning Master QR. Please try again.', 'danger');
                }
            });
        }

        // Process Box Barcode scan
        function processBoxBarcode(barcode) {
            if (!currentUserLock) {
                showAlert('Please scan Master QR first to lock to a session', 'warning');
                return;
            }

            // Find which session this barcode belongs to
            const session = activeSessions.find(s => barcode.startsWith(s.qrIdentity + '_BOX_'));
            if (!session) {
                showAlert('Invalid barcode format', 'danger');
                return;
            }

            // Verify user is locked to this session
            if (currentUserLock !== session.qrIdentity) {
                showAlert(`This barcode belongs to a different session. You are locked to: ${currentUserLock}`, 'warning');
                return;
            }

            // Call backend to scan box barcode
            $.ajax({
                url: '@Url.Action("ScanBoxBarcode", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    barcode: barcode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Clear input and focus for next scan
                        $('#mainScanInput').val('').focus();
                        
                        // Update progress if available
                        if (response.data) {
                            updateScanProgress(response.data);
                        }
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                        
                        // Show debug info if available
                        if (response.debug) {
                            console.log('Debug info:', response.debug);
                        }
                    }
                },
                error: function() {
                    showAlert('Error scanning box barcode. Please try again.', 'danger');
                }
            });
        }

        // Check user lock status
        function checkUserLockStatus() {
            $.ajax({
                url: '@Url.Action("CheckUserLock", "Scan")',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.isLocked) {
                        currentUserLock = response.lockedSession;
                        const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                        if (session) {
                            updateScanStatus('locked', `Locked to: ${session.fileName}`, 'warning');
                            updateUIForLockedState(session);
                        } else {
                            updateScanStatus('locked', `Locked to: ${currentUserLock}`, 'warning');
                        }
                        
                        // Show info message
                        showAlert(`You are currently locked to session: ${currentUserLock}. Continue scanning boxes or complete the session.`, 'info');
                    }
                }
            });
        }

        // Load available sessions for reference
        function loadAvailableSessions() {
            // Get sessions from Model (already loaded in page)
            activeSessions = [
                @if (Model?.Any() == true)
                {
                    @foreach (var session in Model)
                    {
                        @:{
                        @:    sessionId: @session.SessionId,
                        @:    fileName: '@Html.Raw(session.FileName.Replace("'", "\\'"))',
                        @:    qrIdentity: '@session.QRIdentity'
                        @:},
                    }
                }
            ];
            
            // Enhanced debug logging
            console.log('=== LOADED ACTIVE SESSIONS ===');
            console.log('Total sessions:', activeSessions.length);
            activeSessions.forEach((session, index) => {
                console.log(`Session ${index + 1}:`, {
                    sessionId: session.sessionId,
                    fileName: session.fileName,
                    qrIdentity: session.qrIdentity
                });
            });
            console.log('=== END ACTIVE SESSIONS ===');
        }

        // Update scan status display
        function updateScanStatus(status, message, badgeClass) {
            const statusBadge = $('#statusBadge');
            const statusDetail = $('#statusDetail');
            
            statusBadge.removeClass('bg-secondary bg-success bg-warning bg-danger')
                      .addClass(`bg-${badgeClass}`);
            
            switch(status) {
                case 'ready':
                    statusBadge.text('Ready to Scan');
                    statusDetail.text('Scan QR Identity to begin');
                    break;
                case 'locked':
                    statusBadge.text('Session Locked');
                    statusDetail.text(message);
                    break;
                case 'scanning':
                    statusBadge.text('Scanning Boxes');
                    statusDetail.text(message);
                    break;
            }
        }

        // Update UI for locked state
        function updateUIForLockedState(session) {
            // Update placeholder text
            $('#mainScanInput').attr('placeholder', `📦 Scan box barcodes for: ${session.fileName}`);
            
            // Update status
            updateScanStatus('scanning', `Ready to scan boxes`, 'success');
        }

        // Update scan progress
        function updateScanProgress(progressData) {
            if (progressData.progressPercentage !== undefined) {
                const message = `Progress: ${progressData.scannedCount}/${progressData.totalBarcodes} (${progressData.progressPercentage.toFixed(1)}%)`;
                updateScanStatus('scanning', message, 'success');
            }
        }

        // Existing utility functions
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showAlert('QR Identity copied to clipboard! 📋', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function refreshSessions() {
            return new Promise((resolve) => {
                console.log('🔄 Refreshing sessions...');
                
                // Instead of full page reload, fetch fresh session data
                fetch(window.location.pathname, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    // Parse the response to extract new session data
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Re-evaluate the session loading script
                    const scripts = doc.querySelectorAll('script');
                    scripts.forEach(script => {
                        if (script.textContent.includes('activeSessions = [')) {
                            // Extract and execute session loading code
                            const sessionCode = script.textContent.match(/activeSessions = \[([\s\S]*?)\];/);
                            if (sessionCode) {
                                try {
                                    eval('activeSessions = [' + sessionCode[1] + '];');
                                    console.log('✅ Sessions refreshed successfully');
                                    console.log('New sessions count:', activeSessions.length);
                                    activeSessions.forEach((session, index) => {
                                        console.log(`Refreshed Session ${index + 1}:`, {
                                            sessionId: session.sessionId,
                                            qrIdentity: session.qrIdentity
                                        });
                                    });
                                } catch (e) {
                                    console.error('Error parsing refreshed sessions:', e);
                                }
                            }
                        }
                    });
                    
                    resolve();
                })
                .catch(error => {
                    console.error('Error refreshing sessions:', error);
                    resolve();
                });
            });
        }
                .then(html => {
                    // Parse the HTML to extract session data
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Extract the script content that contains activeSessions
                    const scripts = doc.querySelectorAll('script');
                    for (let script of scripts) {
                        if (script.textContent.includes('activeSessions = [')) {
                            // Extract and evaluate the activeSessions part
                            const match = script.textContent.match(/activeSessions = \[([\s\S]*?)\];/);
                            if (match) {
                                try {
                                    // Safely evaluate the sessions array
                                    eval('activeSessions = [' + match[1] + '];');
                                    console.log('Sessions refreshed:', activeSessions);
                                } catch (e) {
                                    console.error('Error parsing sessions:', e);
                                }
                            }
                            break;
                        }
                    }
                    resolve();
                })
                .catch(error => {
                    console.error('Error refreshing sessions:', error);
                    // Fallback to page reload
                    location.reload();
                });
            });
        }

        function checkForValidatedSessions() {
            showAlert('Checking for available sessions and generating QR codes if needed...', 'info');
            
            // Force refresh to trigger the auto QR generation logic
            setTimeout(() => {
                location.reload();
            }, 2000);
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 5000);
        }

        // Manual refresh function for the button
        function manualRefreshSessions() {
            showAlert('🔄 Refreshing QR data...', 'info');
            refreshSessions().then(() => {
                showAlert('✅ QR data refreshed successfully!', 'success');
            });
        }

        // Debug function for testing QR format
        function testQRFormat(testValue) {
            console.log('=== QR FORMAT TEST ===');
            console.log('Test value:', testValue);
            console.log('Available sessions:', activeSessions.length);
            console.log('QR identities:', activeSessions.map(s => s.qrIdentity));
            console.log('Exact match:', activeSessions.some(s => s.qrIdentity === testValue));
            console.log('Is Master QR:', isMasterQR(testValue));
            console.log('=== END TEST ===');
        }

        // Make testQRFormat available globally for debugging
        window.testQRFormat = testQRFormat;

        // Auto-refresh every 30 seconds (only if not locked)
        setInterval(function() {
            if (!currentUserLock) {
                refreshSessions();
            }
        }, 30000);
    </script>
}

@* Removed per-session color helper as the session list UI was removed *@
