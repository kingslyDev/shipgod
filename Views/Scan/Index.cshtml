@model List<ShipmentFinishGood.DTOs.ScanSessionSummaryDto>
@{
    ViewData["Title"] = "Scanner Dashboard";
}
@section Styles {
<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/recent-scans.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">
            <i class="fas fa-barcode me-2"></i>Scanner Dashboard
        </h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="refreshSessions()">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
            <a asp-action="History" class="btn btn-outline-info">
                <i class="fas fa-history me-1"></i>Scan History
            </a>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    <form id="afToken" class="d-none">@Html.AntiForgeryToken()</form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Scanning Input -->
    <div class="row mb-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white py-1">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="mb-0 fw-bold">
                        <i class="fas fa-qrcode me-1"></i>Smart Scanner
                    </small>
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-light btn-sm px-2 py-1" onclick="manualRefreshSessions()" title="Refresh QR data">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button class="btn btn-outline-light btn-sm px-2 py-1" onclick="debugScanSystem()" title="Debug scan system">
                            <i class="fas fa-bug"></i>
                        </button>
                        <button class="btn btn-outline-warning btn-sm px-2 py-1" onclick="emergencyUnlock()" title="Emergency unlock if stuck in session" 
                                style="display: none;" id="emergencyUnlockBtn">
                            <i class="fas fa-unlock"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text py-1">
                                <i class="fas fa-crosshairs"></i>
                            </span>
                            <input type="text" 
                                   id="mainScanInput" 
                                   class="form-control form-control-sm py-1" 
                                   placeholder="📱 Scan QR or barcode here..." 
                                   autocomplete="off" 
                                   spellcheck="false"
                                   inputmode="text"
                                   aria-label="Scan input"
                                   aria-describedby="scanHelp"
                                   autofocus>
                            <button class="btn btn-primary btn-sm py-1 px-2" type="button" onclick="processScan()" aria-label="Scan input">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                        <div id="scanHelp" class="form-text" style="font-size: 0.7rem; margin-top: 0.2rem;">
                            First scan QR Identity, then scan Box, Pallet, or PCS barcodes.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="scanStatus" class="text-center" role="status" aria-live="polite">
                            <div style="font-size: 0.7rem; font-weight: 600; margin-bottom: 0.2rem;">Status</div>
                            <span class="badge bg-secondary px-2 py-1" id="statusBadge" style="font-size: 0.7rem;">Ready to Scan</span>
                            <div class="text-muted mt-1" id="statusDetail" style="font-size: 0.65rem;">
                                Scan QR Identity to begin
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    <!-- Recent Scans Container - Shows when locked to session -->
    <div id="recent-scans-container" class="recent-scans-container" style="display: none;">
        <!-- Content will be populated by JavaScript -->
    </div>

    @if (Model?.Any() == true)
    {

    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-center py-5">
                            <i class="fas fa-barcode fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Sessions Available</h4>
                            <p class="text-muted">There are no scanning sessions available at the moment. Please check for sessions that need QR generation.</p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <button class="btn btn-primary" onclick="checkForValidatedSessions()">
                                    <i class="fas fa-search me-2"></i>Check for Sessions
                                </button>
                                <a asp-controller="PO" asp-action="Index" class="btn btn-outline-primary">
                                    <i class="fas fa-upload me-2"></i>Upload New PO
                                </a>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-home me-2"></i>Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/recent-scans.js" asp-append-version="true"></script>
    <script>
        let currentUserLock = null;
        let activeSessions = [];
        let resolvedBarcodes = new Map(); // Cache for resolved barcodes
        let signalRConnection = null; // SignalR connection
        let currentSessionGroup = null; // Track current session group
        let recentScansManager = null; // Recent scans manager

        // Initialize SignalR connection
        function initializeSignalR() {
            signalRConnection = new signalR.HubConnectionBuilder()
                .withUrl("/progressHub")
                .build();

            // Set up event handlers
            setupSignalREventHandlers();

            // Make SignalR connection available globally for recent scans
            window.signalRConnection = signalRConnection;

            // Start connection
            signalRConnection.start().then(function () {
                console.log('✅ SignalR connected successfully');
                
                // Join session group if user is locked to a session
                if (currentUserLock) {
                    const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                    if (session) {
                        joinSessionGroup(session.sessionId);
                    }
                }
            }).catch(function (err) {
                console.error('❌ SignalR connection failed:', err);
            });

            // Reconnection logic
            signalRConnection.onreconnecting(() => {
                console.log('🔄 SignalR reconnecting...');
            });

            signalRConnection.onreconnected(() => {
                console.log('✅ SignalR reconnected');
                // Rejoin session group if needed
                if (currentSessionGroup) {
                    joinSessionGroup(currentSessionGroup);
                }
            });
        }

        function setupSignalREventHandlers() {
            // Session locked event
            signalRConnection.on("SessionLocked", function (data) {
                console.log('🔒 Session locked:', data);
                
                // Update UI if this affects current user
                if (data.lockedBy !== getCurrentUserName()) {
                    showAlert(`Session locked by ${data.lockedBy}`, 'info');
                }
                
                // Sync session data
                syncSessionDataFromServer();
            });

            // Barcode scanned event
            signalRConnection.on("BarcodeScanned", function (data) {
                console.log('📦 Barcode scanned:', data);
                
                // Update cache to include this barcode
                if (!resolvedBarcodes.has(data.barcode)) {
                    const session = activeSessions.find(s => s.sessionId === data.sessionId);
                    if (session) {
                        resolvedBarcodes.set(data.barcode, {
                            sessionId: data.sessionId,
                            qrIdentity: session.qrIdentity,
                            fileName: session.fileName
                        });
                    }
                }
                
                // Show notification if scanned by other user
                if (data.scannedBy !== getCurrentUserName()) {
                    showAlert(`📦 ${data.barcode} scanned by ${data.scannedBy}`, 'info');
                }
            });

            // Barcode state changed event
            signalRConnection.on("BarcodeStateChanged", function (data) {
                console.log('🔄 Barcode state changed:', data);
                
                // Update local cache based on action
                if (data.action === 'scanned') {
                    // Mark barcode as scanned in cache
                    if (resolvedBarcodes.has(data.barcode)) {
                        const cached = resolvedBarcodes.get(data.barcode);
                        cached.scannedBy = data.by;
                        cached.scannedAt = data.timestamp;
                        cached.status = 'SCANNED';
                        resolvedBarcodes.set(data.barcode, cached);
                    }
                }
            });

            // Progress updated event
            signalRConnection.on("ProgressUpdated", function (progressData) {
                console.log('📊 Progress updated:', progressData);
                updateEnhancedProgress(progressData);
            });

            // Force session sync event
            signalRConnection.on("ForceSessionSync", function (sessionId) {
                console.log('🔄 Force session sync for:', sessionId);
                syncSessionDataFromServer();
            });

            // Session unlocked event
            signalRConnection.on("SessionUnlocked", function (data) {
                console.log('🔓 Session unlocked:', data);
                
                // Clear user lock if it's current user
                if (data.unlockedBy === getCurrentUserName() || data.sessionId === currentSessionGroup) {
                    // Leave the SignalR session group
                    if (currentSessionGroup) {
                        leaveSessionGroup(currentSessionGroup);
                    }
                    
                    // Clear session storage
                    clearUserLockState();
                    
                    currentUserLock = null;
                    currentSessionGroup = null;
                    updateScanStatus('ready', 'Session completed - Ready for new scan', 'success');
                }
                
                showAlert(`Session unlocked by ${data.unlockedBy}`, 'success');
            });

            // User joined/left session events
            signalRConnection.on("UserJoinedSession", function (userName) {
                if (userName !== getCurrentUserName()) {
                    console.log(`👤 ${userName} joined the session`);
                }
            });

            signalRConnection.on("UserLeftSession", function (userName) {
                if (userName !== getCurrentUserName()) {
                    console.log(`👤 ${userName} left the session`);
                }
            });

            // Session state changed (for overview)
            signalRConnection.on("SessionStateChanged", function (data) {
                console.log('🔄 Session state changed:', data);
                // Refresh sessions overview
                lightweightRefreshSessions();
            });
        }

        function joinSessionGroup(sessionId) {
            if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                currentSessionGroup = sessionId;
                signalRConnection.invoke("JoinSessionGroup", sessionId.toString())
                    .then(() => {
                        console.log(`✅ Joined session group: ${sessionId}`);
                    })
                    .catch(err => {
                        console.error('❌ Failed to join session group:', err);
                    });
            }
        }

        function leaveSessionGroup(sessionId) {
            if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                signalRConnection.invoke("LeaveSessionGroup", sessionId.toString())
                    .then(() => {
                        console.log(`✅ Left session group: ${sessionId}`);
                        currentSessionGroup = null;
                    })
                    .catch(err => {
                        console.error('❌ Failed to leave session group:', err);
                    });
            }
        }

        function getCurrentUserName() {
            // Get current user name from server-side
            return '@(User.Identity?.Name ?? "Unknown")';
        }

        function syncSessionDataFromServer() {
            // Lightweight sync without full page refresh
            $.ajax({
                url: '@Url.Action("GetActiveSessionsJson", "Scan")', // We need to add this endpoint
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        activeSessions = response.data;
                        console.log('✅ Sessions synced from server');
                    }
                },
                error: function() {
                    console.log('⚠️ Failed to sync sessions, using local cache');
                }
            });
        }

        function lightweightRefreshSessions() {
            // Non-blocking refresh that doesn't interfere with current scanning
            if (!currentUserLock) {
                syncSessionDataFromServer();
            }
        }

        // Initialize on page load
        $(document).ready(function() {
            // Initialize Recent Scans Manager - Simplified
            recentScansManager = new RecentScansManager({
                containerId: '#recent-scans-container',
                maxItems: 8
            });
            
            // Make recent scans manager available globally
            window.recentScansManager = recentScansManager;
            
            // Load available sessions first (needed for session restoration)
            loadAvailableSessions();
            
            // Try to restore session immediately for fast UX
            const wasRestored = restoreUserLockState();
            
            // Initialize SignalR connection
            initializeSignalR();
            
            // Focus on main scan input
            $('#mainScanInput').focus();
            
            // Enter key support
            $('#mainScanInput').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    processScan();
                }
            });

            // Verify lock status with server (after trying local restore)
            checkUserLockStatus();
            
            // Professional session monitoring with smart intervals
            setInterval(function() {
                if (!currentUserLock) { 
                    // Only refresh sessions when not actively scanning
                    console.log('🔄 Auto-refreshing sessions (60s interval)...');
                    refreshSessions();
                } else {
                    // When locked to session, monitor completion status
                    console.log('🔍 Monitoring active session completion status...');
                    synchronizeSessionState();
                }
            }, 30000); // 30 seconds for active monitoring
            
            // Additional completion check on focus return (user comes back to tab)
            $(window).on('focus', function() {
                if (currentUserLock && currentSessionGroup) {
                    console.log('👀 Window focused, checking session completion status...');
                    setTimeout(() => {
                        validateSessionCompletionStatus(currentSessionGroup);
                    }, 1000);
                }
            });
        });

        // Main scanning function
        function processScan() {
            const input = $('#mainScanInput');
            const scannedValue = input.val().trim();
            
            if (!scannedValue) {
                showAlert('Please enter or scan a value', 'warning');
                input.focus();
                return;
            }

            // Enhanced debug logging
            console.log('=== SCAN ATTEMPT ===');
            console.log('Scanned value:', scannedValue);
            console.log('Scanned value length:', scannedValue.length);
            console.log('Starts with QR_:', scannedValue.startsWith('QR_'));
            console.log('Contains _BOX_:', scannedValue.includes('_BOX_'));
            console.log('Active sessions count:', activeSessions.length);
            console.log('Available QR identities:', activeSessions.map(s => s.qrIdentity));
            console.log('Current user lock:', currentUserLock);
            
            // Check for exact matches
            const exactMatch = activeSessions.find(s => s.qrIdentity === scannedValue);
            console.log('Exact match found:', !!exactMatch);
            if (exactMatch) {
                console.log('Matched session:', exactMatch);
            }
            
            // Check for partial matches
            const partialMatches = activeSessions.filter(s => 
                scannedValue.includes(s.qrIdentity) || s.qrIdentity.includes(scannedValue)
            );
            console.log('Partial matches:', partialMatches);
            
            console.log('Is Master QR:', isMasterQR(scannedValue));
            console.log('Is Box Barcode:', isBoxBarcode(scannedValue));
            console.log('Is Item Barcode:', isItemBarcode(scannedValue));
            console.log('=== END SCAN ATTEMPT ===');

            // Determine scan type and process
            if (isMasterQR(scannedValue)) {
                processMasterQR(scannedValue);
            } else if (isItemBarcode(scannedValue)) {
                processItemBarcode(scannedValue);
            } else {
                // Always try server resolution first for unrecognized barcodes
                console.log('❓ Barcode not recognized locally, resolving on server...');
                resolveAndProcess(scannedValue, input);
                return;
            }

            // Clear input after processing
            input.val('').focus();
        }

        // Check if scanned value is Master QR (simplified)
        function isMasterQR(value) {
            // Basic format check: starts with QR_ and doesn't contain item indicators
            if (!value.startsWith('QR_')) return false;
            if (value.includes('_BOX_') || value.includes('PALLET') || value.includes('PCS')) return false;
            
            // If we have activeSessions loaded, try exact match
            if (activeSessions.length > 0) {
                const exactMatch = activeSessions.some(session => session.qrIdentity === value);
                console.log('Master QR exact match in activeSessions:', exactMatch);
                if (exactMatch) return true;
            }
            
            // If cache has it, it's valid
            if (resolvedBarcodes.has(value)) {
                console.log('Master QR found in cache');
                return true;
            }
            
            // If it looks like a master QR format, treat it as such
            // Let the backend validate the actual existence
            console.log('Master QR format detected, treating as Master QR');
            return true; // Changed from false to true
        }

        // Check if scanned value is Box Barcode (simplified)
        function isBoxBarcode(value) {
            // Basic format check
            if (!value.includes('_BOX_')) return false;
            
            // If cache has it, it's valid
            if (resolvedBarcodes.has(value)) {
                console.log('Box barcode found in cache');
                return true;
            }
            
            // If user is locked and barcode starts with locked QR, it's likely valid
            if (currentUserLock && value.startsWith(currentUserLock + '_BOX_')) {
                console.log('Box barcode matches current lock');
                return true;
            }
            
            // Check against activeSessions if available
            if (activeSessions.length > 0) {
                const isValid = activeSessions.some(session => {
                    return value.startsWith(session.qrIdentity + '_BOX_');
                });
                console.log('Box barcode validation against activeSessions:', isValid);
                if (isValid) return true;
            }
            
            console.log('Box barcode needs server validation');
            return false; // Let it go to server resolution
        }

        // Check if scanned value is an item barcode (simplified)
        function isItemBarcode(value) {
            if (!value) return false;
            
            const upperValue = value.toUpperCase();
            
            // Basic format checks
            const hasItemType = upperValue.includes('BOX') || 
                               upperValue.includes('PALLET') || 
                               upperValue.includes('PCS');
            
            if (!hasItemType) return false;
            
            // Check cache first - most reliable
            if (resolvedBarcodes.has(value)) {
                console.log('✅ Item barcode found in cache');
                return true;
            }
            
            // For BOX items, check if matches current lock
            if (upperValue.includes('BOX') && currentUserLock && value.startsWith(currentUserLock + '_BOX_')) {
                console.log('✅ BOX barcode matches current session lock');
                return true;
            }
            
            // For PALLET and PCS, allow if user is locked to a session
            if ((upperValue.includes('PALLET') || upperValue.includes('PCS')) && currentUserLock) {
                console.log('✅ PALLET/PCS barcode and user has active session');
                return true;
            }
            
            // Check against activeSessions as backup
            if (activeSessions.length > 0 && upperValue.includes('BOX')) {
                const startsWithQR = activeSessions.some(session => {
                    return value.startsWith(session.qrIdentity + '_BOX_');
                });
                if (startsWithQR) {
                    console.log('✅ BOX barcode matches activeSessions');
                    return true;
                }
            }
            
            console.log('❓ Item barcode needs server validation');
            return false; // Let it go to server resolution
        }        // Process Master QR scan
        function processMasterQR(qrCode) {
            const session = activeSessions.find(s => s.qrIdentity === qrCode);
            if (!session) {
                console.log('⚠️ QR not found in local activeSessions, trying server resolution...');
                
                // Try server resolution as fallback
                resolveAndProcess(qrCode, $('#mainScanInput'));
                return;
            }

            // Check if user is already locked to different session
            if (currentUserLock && currentUserLock !== qrCode) {
                showAlert(`You are already locked to session: ${currentUserLock}. Complete that session first.`, 'warning');
                return;
            }

            // Call backend to scan Master QR
            $.ajax({
                url: '@Url.Action("ScanMasterQR", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    qrCode: qrCode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        currentUserLock = qrCode;
                        currentSessionGroup = session.sessionId;
                        
                        // Save to session storage for persistence across refreshes
                        saveUserLockState(qrCode, session);
                        
                        // Join SignalR session group
                        joinSessionGroup(session.sessionId);
                        
                        // Clear barcode cache when switching sessions
                        resolvedBarcodes.clear();
                        console.log('🗑️ Cleared barcode cache for new session');
                        
                        updateScanStatus('locked', `Locked to: ${session.fileName}`, 'success');
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Clear input and focus for box scanning
                        $('#mainScanInput').val('').focus();
                        
                        // Update UI to show locked state
                        updateUIForLockedState(session);
                        
                        // Show emergency unlock button
                        updateUILockState(true, session.fileName);
                        
                        // Show recent scans for this session
                        if (recentScansManager) {
                            recentScansManager.show(session.sessionId);
                        }
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                    }
                },
                error: function() {
                    showAlert('Error scanning Master QR. Please try again.', 'danger');
                }
            });
        }

        // Process Box Barcode scan
        function processBoxBarcode(barcode) {
            if (!currentUserLock) {
                showAlert('Please scan Master QR first to lock to a session', 'warning');
                return;
            }

            // Find which session this barcode belongs to
            const session = activeSessions.find(s => barcode.startsWith(s.qrIdentity + '_BOX_'));
            if (!session) {
                showAlert('Invalid barcode format', 'danger');
                return;
            }

            // Verify user is locked to this session
            if (currentUserLock !== session.qrIdentity) {
                showAlert(`This barcode belongs to a different session. You are locked to: ${currentUserLock}`, 'warning');
                return;
            }

            // Call backend to scan box barcode
            $.ajax({
                url: '@Url.Action("ScanBoxBarcode", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    barcode: barcode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Clear input and focus for next scan
                        $('#mainScanInput').val('').focus();
                        
                        // Update progress if available
                        if (response.data) {
                            updateScanProgress(response.data);
                        }
                        
                        // No need to refresh - cache and local state are sufficient
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                        
                        // Show debug info if available
                        if (response.debug) {
                            console.log('Debug info:', response.debug);
                        }
                    }
                },
                error: function() {
                    showAlert('Error scanning box barcode. Please try again.', 'danger');
                }
            });
        }

        // Process Item Barcode scan (Universal: Box, Pallet, or PCS)
        function processItemBarcode(barcode) {
            if (!currentUserLock) {
                showAlert('Please scan Master QR first to lock to a session', 'warning');
                return;
            }

            const upperBarcode = barcode.toUpperCase();
            const itemType = upperBarcode.includes('PALLET') ? 'PALLET' : 
                           upperBarcode.includes('PCS') ? 'PCS' : 
                           upperBarcode.includes('BOX') ? 'BOX' : 'ITEM';

            // Find which session this barcode belongs to
            let session = null;
            
            if (itemType === 'BOX') {
                // For BOX barcodes, find by QR identity prefix
                session = activeSessions.find(s => barcode.startsWith(s.qrIdentity + '_BOX_'));
                if (session && currentUserLock !== session.qrIdentity) {
                    showAlert(`This barcode belongs to a different session. You are locked to: ${currentUserLock}`, 'warning');
                    return;
                }
            } else {
                // For PALLET and PCS, use the currently locked session
                session = activeSessions.find(s => s.qrIdentity === currentUserLock);
            }

            if (!session) {
                showAlert(`Invalid ${itemType.toLowerCase()} barcode format or session not found`, 'danger');
                return;
            }

            // Call universal scan endpoint
            $.ajax({
                url: '@Url.Action("ScanItem", "Scan")',
                type: 'POST',
                data: {
                    sessionId: session.sessionId,
                    barcode: barcode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Clear input and focus for next scan
                        $('#mainScanInput').val('').focus();
                        
                        // Update enhanced progress display
                        if (response.data) {
                            updateEnhancedProgress(response.data);
                            
                            // Check if all items are complete and session can be unlocked
                            if (response.data.isAllComplete) {
                                const session = activeSessions.find(s => s.sessionId === currentSessionGroup);
                                const sessionName = session ? session.fileName : `Session ${currentSessionGroup}`;
                                
                                console.log('🎯 All items complete, triggering professional completion');
                                completeSessionAutomatically(currentSessionGroup, sessionName);
                            }
                        }
                        
                        // No need to refresh - direct resolution handles sync
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                        
                        // Show debug info if available
                        if (response.debug) {
                            console.log('Debug info:', response.debug);
                        }
                    }
                },
                error: function() {
                    showAlert(`Error scanning ${itemType.toLowerCase()}. Please try again.`, 'danger');
                }
            });
        }

        // Resolve barcode on server and process accordingly
        function resolveAndProcess(scannedValue, inputElement) {
            // Check cache first
            if (resolvedBarcodes.has(scannedValue)) {
                const cached = resolvedBarcodes.get(scannedValue);
                console.log('✅ Using cached resolution:', cached);
                processResolvedBarcode(scannedValue, cached, inputElement);
                return;
            }

            console.log('🔍 Resolving barcode on server:', scannedValue);
            showAlert('Validating barcode...', 'info');
            
            $.ajax({
                url: '@Url.Action("ResolveSessionByBarcode", "Scan")',
                type: 'GET',
                data: { barcode: scannedValue },
                success: function(resp) {
                    if (resp.success && resp.data) {
                        console.log('✅ Server resolved session:', resp.data);
                        const resolved = resp.data;
                        
                        // Cache the resolution
                        resolvedBarcodes.set(scannedValue, resolved);
                        
                        // Update local session data
                        updateActiveSessions(resolved);
                        
                        // Process the resolved barcode
                        processResolvedBarcode(scannedValue, resolved, inputElement);
                    } else {
                        console.log('❌ Barcode not found on server');
                        showAlert('Invalid QR/Barcode format. Please scan a valid QR Identity or Box Barcode.', 'danger');
                        inputElement.focus();
                    }
                },
                error: function() {
                    console.error('❌ Server error during barcode resolution');
                    showAlert('Error validating barcode. Please try again.', 'danger');
                    inputElement.focus();
                }
            });
        }

        // Process a resolved barcode
        function processResolvedBarcode(scannedValue, resolved, inputElement) {
            // Clear input first
            inputElement.val('').focus();
            
            // Determine action based on barcode type
            if (scannedValue === resolved.qrIdentity) {
                // This is a Master QR
                console.log('🔓 Processing as Master QR');
                processMasterQRDirect(resolved.sessionId, resolved.qrIdentity, resolved.fileName);
            } else if (scannedValue.includes('_BOX_') || scannedValue.includes('BOX') || 
                       scannedValue.includes('PALLET') || scannedValue.includes('PCS')) {
                // This is an item barcode
                console.log('📦 Processing as item barcode');
                processItemBarcodeDirect(resolved.sessionId, scannedValue);
            } else {
                console.log('❓ Unknown barcode type after resolution');
                showAlert('Unable to determine barcode type', 'warning');
            }
        }

        // Process Master QR directly with known session data
        function processMasterQRDirect(sessionId, qrIdentity, fileName) {
            // Check if user is already locked to different session
            if (currentUserLock && currentUserLock !== qrIdentity) {
                showAlert(`You are already locked to session: ${currentUserLock}. Complete that session first.`, 'warning');
                return;
            }

            // Call backend to scan Master QR
            $.ajax({
                url: '@Url.Action("ScanMasterQR", "Scan")',
                type: 'POST',
                data: {
                    sessionId: sessionId,
                    qrCode: qrIdentity
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        currentUserLock = qrIdentity;
                        currentSessionGroup = sessionId;
                        
                        // Save to session storage for persistence
                        const sessionData = { sessionId, fileName, qrIdentity };
                        saveUserLockState(qrIdentity, sessionData);
                        
                        // Join SignalR session group
                        joinSessionGroup(sessionId);
                        
                        // Clear barcode cache when switching sessions
                        resolvedBarcodes.clear();
                        console.log('🗑️ Cleared barcode cache for new session');
                        
                        updateScanStatus('locked', `Locked to: ${fileName}`, 'success');
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Update UI to show locked state
                        updateUIForLockedState({ sessionId, fileName, qrIdentity });
                        
                        // Show emergency unlock button
                        updateUILockState(true, fileName);
                        
                        // Show recent scans for this session
                        if (recentScansManager) {
                            recentScansManager.show(sessionId);
                        }
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                    }
                },
                error: function() {
                    showAlert('Error scanning Master QR. Please try again.', 'danger');
                }
            });
        }

        // Process Item Barcode directly with known session
        function processItemBarcodeDirect(sessionId, barcode) {
            if (!currentUserLock) {
                showAlert('Please scan Master QR first to lock to a session', 'warning');
                return;
            }

            // Call universal scan endpoint
            $.ajax({
                url: '@Url.Action("ScanItem", "Scan")',
                type: 'POST',
                data: {
                    sessionId: sessionId,
                    barcode: barcode
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showAlert(`✅ ${response.message}`, 'success');
                        
                        // Update enhanced progress display
                        if (response.data) {
                            updateEnhancedProgress(response.data);
                            
                            // Check if all items are complete
                            if (response.data.isAllComplete) {
                                const session = activeSessions.find(s => s.sessionId === currentSessionGroup);
                                const sessionName = session ? session.fileName : `Session ${currentSessionGroup}`;
                                
                                console.log('🎯 All items complete, triggering professional completion');
                                completeSessionAutomatically(currentSessionGroup, sessionName);
                            }
                        }
                    } else {
                        showAlert(`❌ ${response.message}`, 'danger');
                        
                        // Show debug info if available
                        if (response.debug) {
                            console.log('Debug info:', response.debug);
                        }
                    }
                },
                error: function() {
                    showAlert('Error scanning item. Please try again.', 'danger');
                }
            });
        }

        // Lightweight session update - only update if we have current lock context
        function lightweightUpdateSession() {
            if (currentUserLock) {
                // If we know the current session, just make sure it exists in activeSessions
                const hasCurrentSession = activeSessions.some(s => s.qrIdentity === currentUserLock);
                if (!hasCurrentSession) {
                    console.log('🔄 Current session not in list, triggering full refresh...');
                    refreshSessions();
                } else {
                    console.log('✅ Session data already current, skipping refresh');
                }
            } else {
                // If no current lock, we might need fresh data for next scan
                console.log('🔄 No current lock, refreshing sessions for next scan...');
                refreshSessions();
            }
        }

        // Update activeSessions with new session data if not already present
        function updateActiveSessions(sessionData) {
            if (!sessionData || !sessionData.qrIdentity) return;
            
            // Check if session already exists
            const existingIndex = activeSessions.findIndex(s => s.sessionId === sessionData.sessionId);
            
            if (existingIndex >= 0) {
                // Update existing session
                activeSessions[existingIndex] = {
                    sessionId: sessionData.sessionId,
                    fileName: sessionData.fileName || activeSessions[existingIndex].fileName,
                    qrIdentity: sessionData.qrIdentity
                };
            } else {
                // Add new session
                activeSessions.push({
                    sessionId: sessionData.sessionId,
                    fileName: sessionData.fileName || 'Unknown',
                    qrIdentity: sessionData.qrIdentity
                });
            }
            
            console.log('✅ Active sessions updated:', activeSessions.length, 'sessions');
        }

        // Check user lock status
        // ==================== PROFESSIONAL SESSION MANAGEMENT ====================
        
        /**
         * Complete scanning session automatically when all items are scanned
         * Best Practice: Automatic completion with proper cleanup and notifications
         */
        function completeSessionAutomatically(sessionId, sessionName) {
            console.log('🎯 Auto-completing session:', sessionId, sessionName);
            showAlert('🔄 Completing session automatically...', 'info');
            
            $.ajax({
                url: '@Url.Action("CompleteScan", "Scan")',
                type: 'POST',
                data: { sessionId: sessionId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        console.log('✅ Session completed successfully on server');
                        
                        // Professional cleanup sequence
                        performSessionCleanup(sessionName, true);
                        
                        // Show professional success message
                        showAlert(`🎉 Session "${sessionName}" completed successfully! Ready for next session.`, 'success');
                        
                        // Auto-focus for next session
                        setTimeout(() => {
                            $('#mainScanInput').focus();
                        }, 1000);
                        
                    } else {
                        console.error('❌ Failed to complete session:', response.message);
                        showAlert(`⚠️ Session completion failed: ${response.message}`, 'warning');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ Error completing session:', error);
                    showAlert('🔧 Error completing session. Please try manual completion.', 'danger');
                }
            });
        }

        /**
         * Perform comprehensive session cleanup
         * Best Practice: Centralized cleanup with proper state management
         */
        function performSessionCleanup(sessionName, isCompleted = false) {
            console.log('🧹 Performing session cleanup for:', sessionName);
            
            // Leave SignalR session group
            if (currentSessionGroup) {
                leaveSessionGroup(currentSessionGroup);
                console.log('📡 Left SignalR group:', currentSessionGroup);
            }
            
            // Clear session storage
            clearUserLockState();
            console.log('💾 Cleared session storage');
            
            // Reset state variables
            currentUserLock = null;
            currentSessionGroup = null;
            resolvedBarcodes.clear();
            console.log('🗑️ Cleared runtime state');
            
            // Update UI professionally
            if (isCompleted) {
                updateScanStatus('completed', `✅ Session "${sessionName}" completed successfully`, 'success');
            } else {
                updateScanStatus('ready', '🚀 Ready to scan new QR Identity', 'info');
            }
            
            // Reset input placeholder
            $('#mainScanInput').attr('placeholder', '📱 Scan QR Identity to start new session...');
            $('#mainScanInput').val('').removeClass('is-invalid is-valid');
            
            // Update UI lock state
            updateUILockState(false);
            
            // Hide recent scans
            if (recentScansManager) {
                recentScansManager.hide();
            }
            
            console.log('✨ Session cleanup completed');
        }

        /**
         * Check if current session should be auto-completed
         * Best Practice: Proactive session state validation
         */
        function validateSessionCompletionStatus(sessionId) {
            if (!sessionId || !currentUserLock) return;
            
            console.log('🔍 Validating session completion status:', sessionId);
            
            $.ajax({
                url: '@Url.Action("GetScanProgress", "Scan")',
                type: 'GET',
                data: { sessionId: sessionId },
                success: function(response) {
                    if (response.success && response.data) {
                        const progress = response.data;
                        console.log('📊 Session progress:', progress);
                        
                        // Check if session should be completed
                        if (progress.isComplete && currentUserLock) {
                            console.log('🎯 Session is complete, triggering auto-completion');
                            const session = activeSessions.find(s => s.sessionId === sessionId);
                            const sessionName = session ? session.fileName : `Session ${sessionId}`;
                            completeSessionAutomatically(sessionId, sessionName);
                        }
                        
                        // Update progress display
                        updateEnhancedProgress(progress);
                    }
                },
                error: function() {
                    console.warn('⚠️ Failed to validate session completion status');
                }
            });
        }

        /**
         * Professional session state synchronization
         * Best Practice: Periodic validation with smart refresh intervals
         */
        function synchronizeSessionState() {
            if (!currentUserLock || !currentSessionGroup) return;
            
            console.log('🔄 Synchronizing session state...');
            validateSessionCompletionStatus(currentSessionGroup);
        }

        /**
         * Emergency unlock function for stuck sessions
         * Best Practice: Emergency fallback with user confirmation
         */
        function emergencyUnlock() {
            if (!currentUserLock) {
                showAlert('⚠️ No active session to unlock', 'warning');
                return;
            }
            
            const sessionName = activeSessions.find(s => s.qrIdentity === currentUserLock)?.fileName || currentUserLock;
            
            if (!confirm(`🚨 Emergency Unlock\n\nAre you sure you want to force unlock from "${sessionName}"?\n\nThis should only be used if the session is stuck or completed but not auto-unlocked.\n\nClick OK to proceed.`)) {
                return;
            }
            
            console.log('🚨 Emergency unlock triggered for:', sessionName);
            showAlert('🔧 Performing emergency unlock...', 'warning');
            
            // Try server-side unlock first
            $.ajax({
                url: '@Url.Action("UnlockUser", "Scan")',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        console.log('✅ Server unlock successful');
                        performSessionCleanup(sessionName, false);
                        showAlert(`✅ Emergency unlock successful! You are now free to start a new session.`, 'success');
                    } else {
                        console.warn('⚠️ Server unlock failed, performing local cleanup');
                        performSessionCleanup(sessionName, false);
                        showAlert(`⚠️ Server unlock failed, but local state cleared. You can try scanning again.`, 'warning');
                    }
                },
                error: function() {
                    console.warn('❌ Server unlock error, performing local cleanup');
                    performSessionCleanup(sessionName, false);
                    showAlert(`🔧 Emergency unlock completed with local cleanup. Try scanning again.`, 'info');
                }
            });
        }

        /**
         * Update UI state based on lock status
         * Best Practice: Centralized UI state management
         */
        function updateUILockState(isLocked, sessionName = '') {
            const emergencyBtn = $('#emergencyUnlockBtn');
            
            if (isLocked) {
                emergencyBtn.show().attr('title', `Emergency unlock from: ${sessionName}`);
            } else {
                emergencyBtn.hide();
            }
        }

        // ==================== END PROFESSIONAL SESSION MANAGEMENT ====================
        // Session storage keys
        const SESSION_KEYS = {
            USER_LOCK: 'scannerUserLock',
            CURRENT_SESSION: 'scannerCurrentSession',
            LOCKED_SESSION_DATA: 'scannerLockedSessionData'
        };

        // Save user lock state to session storage
        function saveUserLockState(qrIdentity, sessionData) {
            try {
                sessionStorage.setItem(SESSION_KEYS.USER_LOCK, qrIdentity);
                sessionStorage.setItem('lockTimestamp', Date.now().toString());
                if (sessionData) {
                    sessionStorage.setItem(SESSION_KEYS.LOCKED_SESSION_DATA, JSON.stringify(sessionData));
                    sessionStorage.setItem(SESSION_KEYS.CURRENT_SESSION, sessionData.sessionId.toString());
                }
                console.log('💾 Saved user lock state:', qrIdentity);
            } catch (error) {
                console.warn('Failed to save user lock state:', error);
            }
        }

        // Restore user lock state from session storage
        function restoreUserLockState() {
            try {
                const savedLock = sessionStorage.getItem(SESSION_KEYS.USER_LOCK);
                const savedSessionData = sessionStorage.getItem(SESSION_KEYS.LOCKED_SESSION_DATA);
                const savedSessionId = sessionStorage.getItem(SESSION_KEYS.CURRENT_SESSION);
                
                if (savedLock && savedSessionData) {
                    const sessionData = JSON.parse(savedSessionData);
                    console.log('🔄 Restoring user lock state:', savedLock, sessionData);
                    
                    // Restore state
                    currentUserLock = savedLock;
                    currentSessionGroup = parseInt(savedSessionId);
                    
                    // Update UI immediately for fast response
                    updateScanStatus('locked', `Locked to: ${sessionData.fileName}`, 'success');
                    updateUIForLockedState(sessionData);
                    
                    // Show recent scans for restored session
                    if (recentScansManager) {
                        recentScansManager.show(sessionData.sessionId);
                    }
                    
                    // Rejoin SignalR group
                    if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                        joinSessionGroup(sessionData.sessionId);
                    }
                    
                    // Show restoration message
                    showAlert(`✅ Session restored: ${sessionData.fileName}. Continue scanning boxes.`, 'success');
                    
                    return true; // State was restored
                }
                
                return false; // No state to restore
            } catch (error) {
                console.warn('Failed to restore user lock state:', error);
                clearUserLockState();
                return false;
            }
        }

        // Clear user lock state from session storage
        function clearUserLockState() {
            try {
                sessionStorage.removeItem(SESSION_KEYS.USER_LOCK);
                sessionStorage.removeItem(SESSION_KEYS.LOCKED_SESSION_DATA);
                sessionStorage.removeItem(SESSION_KEYS.CURRENT_SESSION);
                sessionStorage.removeItem('lockTimestamp');
                console.log('🗑️ Cleared user lock state from storage');
            } catch (error) {
                console.warn('Failed to clear user lock state:', error);
            }
        }

        // ==================== END SESSION PERSISTENCE ====================

        // ==================== SMART SCAN VALIDATION ====================
        
        /**
         * Validate scan environment before processing
         * Best Practice: Proactive validation to prevent issues
         */
        function validateScanEnvironment() {
            const issues = [];
            
            // Check SignalR connection
            if (!signalRConnection || signalRConnection.state !== signalR.HubConnectionState.Connected) {
                issues.push('SignalR connection not active - real-time updates may not work');
            }
            
            // Check session data availability
            if (!activeSessions || activeSessions.length === 0) {
                issues.push('No active sessions loaded - session resolution may fail');
            }
            
            // Check for stuck states
            if (currentUserLock && currentSessionGroup) {
                const lockTimestamp = sessionStorage.getItem('lockTimestamp');
                if (lockTimestamp) {
                    const lockAge = Date.now() - parseInt(lockTimestamp);
                    if (lockAge > 3600000) { // 1 hour
                        issues.push('Session lock is very old (>1 hour) - consider emergency unlock');
                    }
                }
            }
            
            return issues;
        }

        /**
         * Smart barcode preprocessing
         * Best Practice: Clean and validate input before processing
         */
        function preprocessBarcode(rawBarcode) {
            if (!rawBarcode) return null;
            
            // Clean the barcode
            let cleaned = rawBarcode.toString().trim();
            
            // Remove common scanner artifacts
            cleaned = cleaned.replace(/[\r\n\t]/g, '');
            
            // Validate minimum length
            if (cleaned.length < 5) {
                console.warn('⚠️ Barcode too short:', cleaned);
                return null;
            }
            
            // Basic QR format validation
            if (cleaned.startsWith('QR_') && !cleaned.match(/^QR_\d+_\d+/)) {
                console.warn('⚠️ Invalid QR format:', cleaned);
                return null;
            }
            
            return cleaned;
        }

        /**
         * Enhanced main scan processing
         * Best Practice: Add validation layer to existing processScan
         */
        function processEnhancedScan() {
            // Pre-validation
            const issues = validateScanEnvironment();
            if (issues.length > 0) {
                console.warn('🔍 Scan environment issues:', issues);
                // Show warning for critical issues
                if (issues.some(issue => issue.includes('emergency unlock'))) {
                    $('#emergencyUnlockBtn').addClass('btn-warning').removeClass('btn-outline-warning');
                    showAlert('⚠️ Your session may be stuck. Consider using Emergency Unlock if needed.', 'warning');
                }
            }
            
            // Proceed with normal processing
            processScan();
        }

        // ==================== END SMART SCAN VALIDATION ====================

        // Complete scanning session on server
        function completeScanningSession(sessionId) {
            if (!sessionId) {
                console.error('No sessionId provided for completion');
                return;
            }

            $.ajax({
                url: '@Url.Action("CompleteScan", "Scan")',
                type: 'POST',
                data: { sessionId: sessionId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        console.log('✅ Session completed on server');
                        
                        // Now do the UI cleanup
                        performSessionCleanup();
                        
                        showAlert('🎉 Session completed successfully! Ready for new scan.', 'success');
                        
                        // Send SignalR notification to other users
                        if (signalRConnection && signalRConnection.state === signalR.HubConnectionState.Connected) {
                            signalRConnection.invoke("NotifySessionUnlocked", sessionId, getCurrentUserName())
                                .catch(err => console.error('Failed to notify session unlock:', err));
                        }
                    } else {
                        console.error('Failed to complete session:', response.message);
                        showAlert(`❌ Failed to complete session: ${response.message}`, 'danger');
                        
                        // Even if server completion fails, do UI cleanup to prevent getting stuck
                        performSessionCleanup();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error completing session:', error);
                    showAlert('❌ Error completing session. Please try again.', 'danger');
                    
                    // Even if request fails, do UI cleanup to prevent getting stuck
                    performSessionCleanup();
                }
            });
        }

        // Perform UI and state cleanup after session completion
        function performSessionCleanup() {
            console.log('🧹 Performing session cleanup...');
            
            // Leave SignalR session group
            if (currentSessionGroup) {
                leaveSessionGroup(currentSessionGroup);
            }
            
            // Clear session storage
            clearUserLockState();
            
            // Clear state variables
            currentUserLock = null;
            currentSessionGroup = null;
            
            // Clear barcode cache
            resolvedBarcodes.clear();
            
            // Update UI
            updateScanStatus('ready', 'Ready to scan QR Identity', 'success');
            $('#mainScanInput').attr('placeholder', '📱 Scan QR Identity or Item Barcode here...')
                .val('')
                .focus();
            
            // Clear any locked state UI
            $('.locked-session-info').hide();
        }

        function checkUserLockStatus() {
            // Try to restore from session storage first for immediate response
            const wasRestored = restoreUserLockState();
            
            // Always verify with server, but don't block UI if session storage worked
            $.ajax({
                url: '@Url.Action("CheckUserLock", "Scan")',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.isLocked) {
                        const serverLock = response.lockedSession;
                        
                        // If server state differs from local storage, use server state
                        if (currentUserLock !== serverLock) {
                            console.log('🔄 Server lock differs from local storage, syncing...');
                            currentUserLock = serverLock;
                            
                            const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                            if (session) {
                                // Update local storage with server state
                                saveUserLockState(currentUserLock, session);
                                updateScanStatus('locked', `Locked to: ${session.fileName}`, 'success');
                                updateUIForLockedState(session);
                                
                                // Show recent scans
                                if (recentScansManager) {
                                    recentScansManager.show(session.sessionId);
                                }
                                
                                // Join SignalR group if not already
                                if (currentSessionGroup !== session.sessionId) {
                                    joinSessionGroup(session.sessionId);
                                    currentSessionGroup = session.sessionId;
                                }
                            } else {
                                updateScanStatus('locked', `Locked to: ${currentUserLock}`, 'warning');
                            }
                        } else if (!wasRestored) {
                            // Server confirms lock but we didn't restore from storage
                            const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                            if (session) {
                                saveUserLockState(currentUserLock, session);
                                updateScanStatus('locked', `Locked to: ${session.fileName}`, 'success');
                                updateUIForLockedState(session);
                                
                                // Show recent scans
                                if (recentScansManager) {
                                    recentScansManager.show(session.sessionId);
                                }
                                
                                joinSessionGroup(session.sessionId);
                                currentSessionGroup = session.sessionId;
                            }
                        }
                        
                        // Don't show alert if we already restored from session storage
                        if (!wasRestored) {
                            showAlert(`You are currently locked to session: ${currentUserLock}. Continue scanning boxes.`, 'info');
                        }
                    } else if (currentUserLock && !response.isLocked) {
                        // Server says not locked, but we have local state - clear it
                        console.log('🧹 Server says not locked, clearing local state');
                        clearUserLockState();
                        currentUserLock = null;
                        currentSessionGroup = null;
                        updateScanStatus('ready', 'Ready to scan QR Identity', 'info');
                    }
                },
                error: function() {
                    // If server check fails but we restored from storage, that's okay
                    if (!wasRestored) {
                        console.warn('Failed to check server lock status');
                    }
                }
            });
        }

        // Load available sessions for reference
        function loadAvailableSessions() {
            // Get sessions from Model (already loaded in page)
            activeSessions = [
                @if (Model?.Any() == true)
                {
                    @foreach (var session in Model)
                    {
                        @:{
                        @:    sessionId: @session.SessionId,
                        @:    fileName: '@Html.Raw(session.FileName.Replace("'", "\\'"))',
                        @:    qrIdentity: '@Html.Raw((session.QRIdentity ?? string.Empty).Replace("'", "\\'"))'
                        @:},
                    }
                }
            ];
            
            // Enhanced debug logging
            console.log('=== LOADED ACTIVE SESSIONS ===');
            console.log('Total sessions:', activeSessions.length);
            console.log('Raw activeSessions array:', activeSessions);
            activeSessions.forEach((session, index) => {
                console.log(`Session ${index + 1}:`, {
                    sessionId: session.sessionId,
                    fileName: session.fileName,
                    qrIdentity: session.qrIdentity
                });
            });
            console.log('QR Identities available:', activeSessions.map(s => s.qrIdentity));
            console.log('=== END SESSION LOADING ===');
            console.log('=== END ACTIVE SESSIONS ===');
        }

        // Update scan status display
        function updateScanStatus(status, message, badgeClass) {
            const statusBadge = $('#statusBadge');
            const statusDetail = $('#statusDetail');
            
            statusBadge.removeClass('bg-secondary bg-success bg-warning bg-danger')
                      .addClass(`bg-${badgeClass}`);
            
            switch(status) {
                case 'ready':
                    statusBadge.text('Ready to Scan');
                    statusDetail.text('Scan QR Identity to begin');
                    break;
                case 'locked':
                    statusBadge.text('Session Locked');
                    statusDetail.text(message);
                    break;
                case 'scanning':
                    statusBadge.text('Scanning Items');
                    statusDetail.text(message);
                    break;
            }
        }

        // Update UI for locked state
        function updateUIForLockedState(session) {
            // Update placeholder text
            $('#mainScanInput').attr('placeholder', `📦 Scan Box, Pallet, or PCS barcodes for: ${session.fileName}`);
            
            // Update status
            updateScanStatus('scanning', `Ready to scan items`, 'success');
        }

        // Update scan progress
        function updateScanProgress(progressData) {
            if (progressData.progressPercentage !== undefined) {
                const message = `Progress: ${progressData.scannedCount}/${progressData.totalBarcodes} (${progressData.progressPercentage.toFixed(1)}%)`;
                updateScanStatus('scanning', message, 'success');
            }
        }

        // Update enhanced scan progress with individual item type tracking
        function updateEnhancedProgress(progressData) {
            // Update legacy progress
            if (progressData.progressPercentage !== undefined) {
                const message = `Progress: ${progressData.scannedCount}/${progressData.totalBarcodes} (${progressData.progressPercentage.toFixed(1)}%)`;
                updateScanStatus('scanning', message, 'success');
            }

            // Create or update enhanced progress display
            let progressContainer = $('#enhanced-progress-display');
            if (progressContainer.length === 0) {
                // Create enhanced progress display
                const progressHtml = `
                    <div id="enhanced-progress-display" class="mt-3">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card border-info">
                                    <div class="card-body text-center p-2">
                                        <h6 class="card-title text-info mb-1">📦 Boxes</h6>
                                        <div id="box-progress" class="progress mb-1" style="height: 15px;">
                                            <div class="progress-bar bg-info" role="progressbar"></div>
                                        </div>
                                        <small id="box-stats" class="text-muted">0/0 (0%)</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-warning">
                                    <div class="card-body text-center p-2">
                                        <h6 class="card-title text-warning mb-1">🚚 Pallets</h6>
                                        <div id="pallet-progress" class="progress mb-1" style="height: 15px;">
                                            <div class="progress-bar bg-warning" role="progressbar"></div>
                                        </div>
                                        <small id="pallet-stats" class="text-muted">0/0 (0%)</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success">
                                    <div class="card-body text-center p-2">
                                        <h6 class="card-title text-success mb-1">📋 PCS</h6>
                                        <div id="pcs-progress" class="progress mb-1" style="height: 15px;">
                                            <div class="progress-bar bg-success" role="progressbar"></div>
                                        </div>
                                        <small id="pcs-stats" class="text-muted">0/0 (0%)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>`;
                
                $('#statusDetail').parent().after(progressHtml);
                progressContainer = $('#enhanced-progress-display');
            }

            // Update individual progress bars
            if (progressData.boxProgress) {
                const boxProgress = progressData.boxProgress;
                $('#box-progress .progress-bar').css('width', `${boxProgress.percentage}%`);
                $('#box-stats').text(`${boxProgress.scanned}/${boxProgress.total} (${boxProgress.percentage.toFixed(1)}%)`);
                
                if (boxProgress.complete) {
                    $('#box-progress .progress-bar').removeClass('bg-info').addClass('bg-success');
                }
            }

            if (progressData.palletProgress) {
                const palletProgress = progressData.palletProgress;
                $('#pallet-progress .progress-bar').css('width', `${palletProgress.percentage}%`);
                $('#pallet-stats').text(`${palletProgress.scanned}/${palletProgress.total} (${palletProgress.percentage.toFixed(1)}%)`);
                
                if (palletProgress.complete) {
                    $('#pallet-progress .progress-bar').removeClass('bg-warning').addClass('bg-success');
                }
            }

            if (progressData.pcsProgress) {
                const pcsProgress = progressData.pcsProgress;
                $('#pcs-progress .progress-bar').css('width', `${pcsProgress.percentage}%`);
                $('#pcs-stats').text(`${pcsProgress.scanned}/${pcsProgress.total} (${pcsProgress.percentage.toFixed(1)}%)`);
                
                if (pcsProgress.complete) {
                    $('#pcs-progress .progress-bar').removeClass('bg-success').addClass('bg-success');
                }
            }
        }

        // Existing utility functions
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showAlert('QR Identity copied to clipboard! 📋', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function refreshSessions() {
            return new Promise((resolve) => {
                console.log('🔄 Refreshing sessions...');
                
                // Instead of full page reload, fetch fresh session data
                fetch(window.location.pathname, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    // Parse the response to extract new session data
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Re-evaluate the session loading script
                    const scripts = doc.querySelectorAll('script');
                    scripts.forEach(script => {
                        if (script.textContent.includes('activeSessions = [')) {
                            // Extract and execute session loading code
                            const sessionCode = script.textContent.match(/activeSessions = \[([\s\S]*?)\];/);
                            if (sessionCode) {
                                try {
                                    eval('activeSessions = [' + sessionCode[1] + '];');
                                    console.log('✅ Sessions refreshed successfully');
                                    console.log('New sessions count:', activeSessions.length);
                                    activeSessions.forEach((session, index) => {
                                        console.log(`Refreshed Session ${index + 1}:`, {
                                            sessionId: session.sessionId,
                                            qrIdentity: session.qrIdentity
                                        });
                                    });
                                } catch (e) {
                                    console.error('Error parsing refreshed sessions:', e);
                                }
                            }
                        }
                    });
                    
                    resolve();
                })
                .catch(error => {
                    console.error('Error refreshing sessions:', error);
                    resolve();
                });
            });
        }

        function checkForValidatedSessions() {
            showAlert('Checking for available sessions and generating QR codes if needed...', 'info');
            
            // Force refresh to trigger the auto QR generation logic
            setTimeout(() => {
                location.reload();
            }, 2000);
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 5000);
        }

        // Manual refresh function for the button
        function manualRefreshSessions() {
            showAlert('🔄 Refreshing QR data...', 'info');
            refreshSessions().then(() => {
                showAlert('✅ QR data refreshed successfully!', 'success');
            });
        }

        // Debug function for testing entire scan system
        function debugScanSystem() {
            console.log('=== SCAN SYSTEM DEBUG ===');
            console.log('Current User Lock:', currentUserLock);
            console.log('Active Sessions Count:', activeSessions.length);
            console.log('Active Sessions:', activeSessions);
            
            if (activeSessions.length > 0) {
                console.log('Testing with first session:', activeSessions[0]);
                const testQR = activeSessions[0].qrIdentity;
                const testBoxBarcode = testQR + '_BOX_TEST_001';
                
                console.log('Test Master QR:', testQR);
                console.log('Test Box Barcode:', testBoxBarcode);
                console.log('Is Master QR valid:', isMasterQR(testQR));
                console.log('Is Box Barcode valid:', isBoxBarcode(testBoxBarcode));
                
                // Test backend connectivity
                $.ajax({
                    url: '@Url.Action("DebugSession", "Scan")',
                    type: 'GET',
                    data: { sessionId: activeSessions[0].sessionId },
                    success: function(response) {
                        console.log('Backend session debug:', response);
                    },
                    error: function(xhr, status, error) {
                        console.error('Backend connectivity error:', error);
                    }
                });
            } else {
                console.log('No active sessions found');
                // Try to generate QR codes
                console.log('Attempting to check for validated sessions...');
                checkForValidatedSessions();
            }
            
            console.log('=== END DEBUG ===');
            showAlert('Debug information logged to console. Press F12 to view.', 'info');
        }

        // Debug function for testing QR format
        function testQRFormat(testValue) {
            console.log('=== QR FORMAT TEST ===');
            console.log('Test value:', testValue);
            console.log('Available sessions:', activeSessions.length);
            console.log('QR identities:', activeSessions.map(s => s.qrIdentity));
            console.log('Exact match:', activeSessions.some(s => s.qrIdentity === testValue));
            console.log('Is Master QR:', isMasterQR(testValue));
            console.log('=== END TEST ===');
        }

        // Make testQRFormat available globally for debugging
        window.testQRFormat = testQRFormat;

        // Auto-refresh every 30 seconds (only if not locked)
        setInterval(function() {
            if (!currentUserLock) {
                refreshSessions();
            }
        }, 30000);
    </script>
}

