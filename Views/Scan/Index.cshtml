        // Scanner Card Interactions
        function initializeScannerCardInteractions() {
            console.log('🎨 Initializing scanner card interactions...');
            
            const scannerCard = $('#scannerCard');
            const scanInput = $('#mainScanInput');
            const scanButton = $('.scan-submit-btn');
            
            // Detect if device is tablet
            const isTablet = window.innerWidth >= 768 && window.innerWidth <= 1024;
            
            // Initialize tooltips
            if (typeof bootstrap !== 'undefined') {
                $('[data-bs-toggle="tooltip"]').each(function() {
                    new bootstrap.Tooltip(this);
                });
            }
            
            // Enhanced tablet interactions
            if (isTablet) {
                initializeTabletEnhancements();
            }
            
            // Scanner input interactions
            scanInput.on('input', function() {
                const value = $(this).val().trim();
                updateScannerCardState(value.length > 0 ? 'typing' : 'ready');
                
                // Auto-process if looks like a complete barcode
                if (value.length > 8 && /^[A-Z0-9]+$/.test(value)) {
                    setTimeout(() => {
                        if ($(this).val().trim() === value) { // Still the same value
                            updateScannerCardState('auto-scanning');
                            setTimeout(() => processScan(), 300);
                        }
                    }, 800); // Auto-scan after 800ms of no changes
                }
            });
            
            scanInput.on('focus', function() {
                scannerCard.addClass('focused');
                updateScanHelpText('focused');
            });
            
            scanInput.on('blur', function() {
                scannerCard.removeClass('focused');
                updateScanHelpText('normal');
            });
            
            // Scanner button interactions
            scanButton.on('mouseenter', function() {
                $(this).addClass('hover-effect');
            }).on('mouseleave', function() {
                $(this).removeClass('hover-effect');
            });
            
            // Keyboard shortcuts
            $(document).on('keydown', function(e) {
                // Ctrl/Cmd + Enter for quick scan
                if ((e.ctrlKey || e.metaKey) && e.which === 13) {
                    e.preventDefault();
                    processScan();
                }
                
                // ESC to clear and focus
                if (e.which === 27) {
                    e.preventDefault();
                    scanInput.val('').focus();
                    updateScannerCardState('ready');
                }
            });
            
            // Periodic status update
            setInterval(updateScannerStatusLine, 5000);
            
            console.log('✅ Scanner card interactions initialized');
        }

        function initializeTabletEnhancements() {
            console.log('📱 Initializing tablet-specific enhancements...');
            
            // Enhanced touch interactions for tablet
            $('.scanner-status-panel').on('touchstart', function() {
                $(this).addClass('tablet-touch-active');
            }).on('touchend', function() {
                $(this).removeClass('tablet-touch-active');
            });
            
            // Enhance recent scans visibility on tablet
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('tablet-visible');
                    }
                });
            });
            
            // Observe recent scans container
            const recentScansContainer = document.getElementById('recent-scans-container');
            if (recentScansContainer) {
                observer.observe(recentScansContainer);
            }
            
            // Add tablet-specific status updates
            setInterval(updateTabletStatusEnhancements, 3000);
            
            console.log('✅ Tablet enhancements initialized');
        }

        function updateTabletStatusEnhancements() {
            const isTablet = window.innerWidth >= 768 && window.innerWidth <= 1024;
            if (!isTablet) return;
            
            const statusPanel = $('.scanner-status-panel.tablet-enhanced');
            if (statusPanel.length === 0) return;
            
            // Add subtle animation to status icon when locked
            if (currentUserLock) {
                statusPanel.addClass('tablet-locked-state');
            } else {
                statusPanel.removeClass('tablet-locked-state');
            }
            
            // Ensure recent scans are visible and prominent
            const recentScansContainer = $('#recent-scans-container');
            if (recentScansContainer.is(':visible')) {
                recentScansContainer.addClass('tablet-prominent');
            }
        }

        function updateScannerCardState(state) {
            const scannerCard = $('#scannerCard');
            const scanInput = $('#mainScanInput');
            const statusLine = $('#scannerStatusLine');
            
            // Remove previous state classes
            scannerCard.removeClass('ready typing auto-scanning scanning locked loading error');
            
            switch(state) {
                case 'ready':
                    scannerCard.addClass('ready');
                    scanInput.removeClass('is-valid is-invalid');
                    break;
                case 'typing':
                    scannerCard.addClass('typing');
                    statusLine.text('Typing...');
                    break;
                case 'auto-scanning':
                    scannerCard.addClass('auto-scanning');
                    statusLine.text('Auto-processing...');
                    break;
                case 'scanning':
                    scannerCard.addClass('scanning');
                    statusLine.text('Processing scan...');
                    break;
                case 'locked':
                    scannerCard.addClass('locked');
                    statusLine.text('Session locked');
                    break;
                case 'loading':
                    scannerCard.addClass('loading');
                    statusLine.text('Loading...');
                    break;
                case 'error':
                    scannerCard.addClass('error');
                    statusLine.text('Error occurred');
                    scanInput.addClass('is-invalid');
                    break;
                case 'success':
                    scanInput.addClass('is-valid');
                    statusLine.text('Scan successful');
                    setTimeout(() => {
                        scanInput.removeClass('is-valid');
                        updateScannerCardState('ready');
                    }, 2000);
                    break;
            }
        }

        function updateScanHelpText(context) {
            const helpText = $('#scanHelpText');
            const helpContainer = $('#scanHelp');
            
            switch(context) {
                case 'focused':
                    helpText.html('💡 <strong>Tips:</strong> Use Ctrl+Enter for quick scan, ESC to clear');
                    helpContainer.addClass('focused');
                    break;
                case 'locked':
                    if (currentUserLock) {
                        const session = activeSessions.find(s => s.qrIdentity === currentUserLock);
                        const sessionName = session ? session.fileName : currentUserLock;
                        helpText.html(`🔒 Locked to session: <strong>${sessionName}</strong> - Scan boxes, pallets, or PCS items`);
                    }
                    break;
                case 'error':
                    helpText.html('❌ Please check your input and try again');
                    helpContainer.addClass('error');
                    setTimeout(() => {
                        helpContainer.removeClass('error');
                        updateScanHelpText('normal');
                    }, 3000);
                    break;
                default:
                    helpText.text('First scan QR Identity, then scan Box, Pallet, or PCS barcodes.');
