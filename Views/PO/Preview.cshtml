        // ===== HOLD STATE MANAGEMENT =====
        
        // Update UI to show row in HOLD state
        function updateUIForHoldState(fromCountry, toCountry, rowIndex, moveId, isNewCountry) {
            // Mark the row as moved in source country
            const sourceRow = document.querySelector(`tr[data-country="${fromCountry}"][data-row-index="${rowIndex}"]`);
            if (sourceRow) {
                sourceRow.classList.add('row-moved');
                sourceRow.setAttribute('data-move-id', moveId);
                
                // Add indicator to first cell
                const firstCell = sourceRow.querySelector('td:first-child');
                if (firstCell && !firstCell.querySelector('.move-indicator')) {
                    const indicator = document.createElement('span');
                    indicator.className = 'move-indicator';
                    indicator.innerHTML = `→ ${toCountry}`;
                    firstCell.appendChild(indicator);
                }
                
                // Disable editing for moved row
                const editableFields = sourceRow.querySelectorAll('.editable-field');
                editableFields.forEach(field => {
                    field.disabled = true;
                    field.style.backgroundColor = '#f8f9fa';
                });
                
                // Disable buttons
                const buttons = sourceRow.querySelectorAll('button');
                buttons.forEach(btn => {
                    btn.disabled = true;
                    btn.style.opacity = '0.5';
                });
            }
            
            // Show hold state info
            showHoldStateInfo();
        }
        
