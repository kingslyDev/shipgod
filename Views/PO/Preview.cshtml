        // Toggle auto mode functionality
        function toggleAutoMode() {
            const autoLooseMode = document.getElementById('autoLooseMode').checked;
            const autoModeStatus = document.getElementById('autoModeStatus');
            
            if (autoLooseMode) {
                if (autoModeStatus) {
                    autoModeStatus.textContent = 'Auto LOOSE Mode: ENABLED';
                    autoModeStatus.className = 'badge bg-success';
                }
                
                // Show toast notification
                showToast('✨ Auto LOOSE Mode enabled! Next countries will auto-set to LOOSE and calculate automatically.', 'success');
            } else {
                if (autoModeStatus) {
                    autoModeStatus.textContent = 'Auto LOOSE Mode: DISABLED';
                    autoModeStatus.className = 'badge bg-secondary';
                }
                
                showToast('Auto LOOSE Mode disabled. You will need to manually select shipment type for next countries.', 'info');
            }
