        // Populate existing countries in modal
        function populateExistingCountries(excludeCountry) {
            const container = document.getElementById('existingCountries');
            container.innerHTML = '';

            // Get all countries except current one
            const availableCountries = Object.keys(currentData).filter(country => country !== excludeCountry);
            
            // Add submitted countries as well
            const allAvailableCountries = [...new Set([...availableCountries, ...submittedCountries])];

            if (allAvailableCountries.length === 0) {
                container.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        No other countries available. Create a new country below.
                    </div>
                `;
                return;
            }

            allAvailableCountries.forEach(country => {
                const itemCount = currentData[country] ? currentData[country].length : 0;
                const isSubmitted = submittedCountries.includes(country);
                
                const countryOption = document.createElement('div');
                countryOption.className = 'country-option';
                countryOption.setAttribute('data-country', country);
                countryOption.onclick = () => selectCountryOption(countryOption, country, false);
                
                countryOption.innerHTML = `
                    <div class="country-info">
                        <div>
                            <div class="country-name">
                                <i class="fas fa-flag me-2"></i>
                                ${country}
                                ${isSubmitted ? '<span class="badge bg-success ms-2">Submitted</span>' : ''}
                            </div>
                            <small class="text-muted">${itemCount} items currently</small>
                        </div>
                        <div class="country-count">${itemCount}</div>
                    </div>
                `;
                
                container.appendChild(countryOption);
            });
        }

        // Handle country option selection
        function selectCountryOption(element, country, isNew) {
            // Clear previous selections
            document.querySelectorAll('.country-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.getElementById('newCountryName').value = '';

            // Select this option
            element.classList.add('selected');
            currentMoveContext.selectedCountry = country;
            currentMoveContext.isNewCountry = isNew;

            updateMoveButton();
        }

        // Handle new country input
        function handleNewCountryInput(input) {
            const value = input.value.trim();
            
            // Clear existing country selections
            document.querySelectorAll('.country-option').forEach(opt => {
                opt.classList.remove('selected');
            });

            if (value) {
                currentMoveContext.selectedCountry = value;
                currentMoveContext.isNewCountry = true;
            } else {
                currentMoveContext.selectedCountry = null;
                currentMoveContext.isNewCountry = false;
            }

            updateMoveButton();

            // Handle Enter key
            if (event.key === 'Enter' && value) {
                confirmCountryMove();
            }
        }

        // Update move button state
        function updateMoveButton() {
            const btn = document.getElementById('confirmMoveBtn');
            const previewBtn = document.getElementById('previewMoveBtn');
            const hasSelection = currentMoveContext.selectedCountry !== null;
            
            btn.disabled = !hasSelection;
            previewBtn.disabled = !hasSelection;
            
            if (hasSelection) {
                if (currentMoveContext.isNewCountry) {
                    btn.innerHTML = '<i class="fas fa-plus me-2"></i>Create & Move';
                } else {
                    btn.innerHTML = '<i class="fas fa-exchange-alt me-2"></i>Move Row';
                }
            } else {
                btn.innerHTML = '<i class="fas fa-exchange-alt me-2"></i>Move Row';
            }
        }

        // Preview move (non-persistent)
        async function previewCountryMove() {
            if (!currentMoveContext.selectedCountry) return;

            const btn = document.getElementById('previewMoveBtn');
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Previewing...';

            try {
                const fromCountry = currentMoveContext.fromCountry;
                const toCountry = currentMoveContext.selectedCountry;
                const rowIndex = currentMoveContext.rowIndex;
                const shipmentType = document.querySelector('input[name="shipmentType"]:checked')?.value || 'LOOSE';

                // Build request
                const request = {
                    sessionId: parseInt(sessionId),
                    fromCountry,
                    toCountry,
                    rowIndex,
                    rowData: currentData[fromCountry][rowIndex],
                    isNewCountry: currentMoveContext.isNewCountry,
                    shipmentType: shipmentType
                };

                const resp = await fetch('/PO/PreviewMoveRow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(request)
                });

                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const result = await resp.json();
                if (!result.success) throw new Error(result.message || 'Preview failed');

                // Render Stats
                renderPreviewStats(result.beforeStats, result.afterStats);
                document.getElementById('previewResults').style.display = 'block';

                showToast('👀 Preview generated. Review changes before moving.', 'success');
            } catch (e) {
                showToast('❌ Preview failed: ' + e.message, 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }

        function renderPreviewStats(beforeStats, afterStats) {
            const beforeEl = document.getElementById('beforeStats');
            const afterEl = document.getElementById('afterStats');
            beforeEl.innerHTML = '';
            afterEl.innerHTML = '';

            const render = (stats, container) => {
                Object.keys(stats).forEach(country => {
                    const s = stats[country];
                    const card = document.createElement('div');
                    card.className = 'mb-2 p-2 border rounded';
                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-flag me-1"></i>${country}</strong>
                            <span class="badge bg-secondary">Items: ${s.totalItems}</span>
                        </div>
                        <div class="mt-1 small text-muted">
                            <span class="me-3"><i class="fas fa-pallet me-1"></i>Pallets: ${s.totalPallets}</span>
                            <span class="me-3"><i class="fas fa-box me-1"></i>Boxes: ${s.totalBoxes}</span>
                            <span><i class="fas fa-cube me-1"></i>PCS: ${s.totalPCS}</span>
                        </div>
                    `;
                    container.appendChild(card);
                });
            };

            render(beforeStats, beforeEl);
            render(afterStats, afterEl);
        }

        // Confirm country move
        async function confirmCountryMove() {
            if (!currentMoveContext.selectedCountry) {
                showToast('❌ Please select a destination country', 'error');
                return;
            }

            const btn = document.getElementById('confirmMoveBtn');
            const originalText = btn.innerHTML;
            
            try {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

                await moveRowToCountry(
                    currentMoveContext.fromCountry,
                    currentMoveContext.rowIndex,
                    currentMoveContext.selectedCountry,
                    currentMoveContext.isNewCountry
                );

                // Close modal
                bootstrap.Modal.getInstance(document.getElementById('countryMoveModal')).hide();

            } catch (error) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                showToast('❌ Error: ' + error.message, 'error');
            }
        }

        // Main function to move row to country (HOLD STATE - tidak persist ke DB)
        async function moveRowToCountry(fromCountry, rowIndex, toCountry, isNewCountry) {
            try {
                showLoadingState('Moving row to hold state...');

                // Get row data
                const rowData = currentData[fromCountry][rowIndex];
                
                // Generate unique move ID
                const moveId = `move_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                
                // Simulate the move untuk recalculation preview
                const requestData = {
                    sessionId: parseInt(sessionId),
                    fromCountry: fromCountry,
                    toCountry: toCountry,
                    rowIndex: rowIndex,
                    rowData: rowData,
                    isNewCountry: isNewCountry,
                    shipmentType: document.querySelector('input[name="shipmentType"]:checked')?.value || 'LOOSE'
                };

                const response = await fetch('/PO/PreviewMoveRow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(requestData)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    // Add to hold state
                    holdState.movedRows.push({
                        moveId: moveId,
                        fromCountry: fromCountry,
                        toCountry: toCountry,
                        rowIndex: rowIndex,
                        rowData: { ...rowData },
                        isNewCountry: isNewCountry,
                        timestamp: new Date().toISOString()
                    });

                    // Store recalculated data and refresh UI for affected countries
                    Object.keys(result.afterDataByCountry).forEach(country => {
                        holdState.pendingRecalculations[country] = result.afterDataByCountry[country];
                        createCountryTableIfNeeded(country);
                        updateTableDisplay(country);
                        updateStats(country);
                        refreshCountryCounts(country);
                    });

                    // Update UI to show HOLD state
                    updateUIForHoldState(fromCountry, toCountry, rowIndex, moveId, isNewCountry);

                    // Show success message
                    const action = isNewCountry ? 'moved to new country (HOLD)' : 'moved to existing country (HOLD)';
                    showToast(`✅ Row ${action} "${toCountry}". Will be applied when you submit the country!`, 'success');

                    // If new country was created, update dropdowns
                    if (isNewCountry) {
                        await updateUIForNewCountry(toCountry);
                    }

                } else {
                    throw new Error(result.message || 'Failed to move row');
                }

            } catch (error) {
                console.error('Error moving row:', error);
                throw error;
            } finally {
                hideLoadingState();
            }
        }

