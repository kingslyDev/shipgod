    async function updateUIForNewCountry(newCountry) {
            // Add to country dropdown if it doesn't exist
            const dropdown = document.getElementById('countryDropdown');
            if (dropdown && !Array.from(dropdown.options).some(opt => opt.value === newCountry)) {
                const option = document.createElement('option');
                option.value = newCountry;
        const cnt = getCountryDataForDisplay(newCountry).length;
        option.textContent = `${newCountry} (${cnt} items)`;
                dropdown.appendChild(option);
            }

            // Add to pending countries display
            const pendingContainer = document.querySelector('.d-flex.flex-wrap');
            if (pendingContainer && !pendingContainer.querySelector(`[data-country="${newCountry}"]`)) {
                const badge = document.createElement('span');
                badge.className = 'pending-badge';
                badge.setAttribute('data-country', newCountry);
                const cnt = getCountryDataForDisplay(newCountry).length;
                badge.innerHTML = `
                    <i class="fas fa-clock"></i>
                    ${newCountry} (${cnt} items)
                `;
                pendingContainer.appendChild(badge);
            }

            // Create new country table if it doesn't exist and refresh its content
            await createCountryTableIfNeeded(newCountry);
            updateTableDisplay(newCountry);
            updateStats(newCountry);
            refreshCountryCounts(newCountry);
        }

        // Handle when source country becomes empty
        async function handleEmptyCountry(emptyCountry) {
        // Remove from dropdown
            const dropdown = document.getElementById('countryDropdown');
            if (dropdown) {
                const option = dropdown.querySelector(`option[value="${emptyCountry}"]`);
                if (option) {
            option.remove();
                }
                
                // Switch to another country if this was selected
                if (dropdown.value === emptyCountry) {
                    dropdown.selectedIndex = dropdown.options.length > 1 ? 1 : 0;
                    switchCountry();
                }
            }

            // Remove from pending countries display
            const pendingBadge = document.querySelector(`.pending-badge[data-country="${emptyCountry}"]`);
            if (pendingBadge) {
                pendingBadge.classList.add('fade-out');
                setTimeout(() => pendingBadge.remove(), 200);
            }

            // Hide the country table
            const countryTable = document.querySelector(`[data-country="${emptyCountry}"]`);
            if (countryTable) {
                countryTable.classList.add('fade-out');
                setTimeout(() => countryTable.style.display = 'none', 220);
            }
        }

        function removeCountryUIIfEmpty(country) {
            const data = getCountryDataForDisplay(country);
            if (data && data.length > 0) return;
            // If no pending recalcs and no current data, remove UI traces
            const dropdown = document.getElementById('countryDropdown');
            const opt = dropdown?.querySelector(`option[value="${country}"]`);
            if (opt) opt.remove();
            const badge = document.querySelector(`.pending-badge[data-country="${country}"]`);
            if (badge) { badge.classList.add('fade-out'); setTimeout(() => badge.remove(), 200); }
            const table = document.querySelector(`[data-country="${country}"]`);
            if (table) { table.classList.add('fade-out'); setTimeout(() => table.remove(), 220); }
        }

