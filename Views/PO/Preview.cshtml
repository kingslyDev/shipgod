@section Scripts {
    <script>
        // Accessibility Mode Toggle
        (function setupAccessibilityToggle() {
            const checkbox = document.getElementById('accessibilityMode');
            if (checkbox) {
                // Load preference from localStorage
                const isAccessible = localStorage.getItem('accessibleMode') === 'true';
                checkbox.checked = isAccessible;
                toggleAccessibleMode(isAccessible);
                
                // Handle toggle changes
                checkbox.addEventListener('change', function() {
                    toggleAccessibleMode(this.checked);
                });
            }
            
            function toggleAccessibleMode(enable) {
                if (enable) {
                    document.body.classList.add('accessible-view');
                } else {
                    document.body.classList.remove('accessible-view');
                }
                localStorage.setItem('accessibleMode', enable);
            }
        })();
        
        let currentData = @Html.Raw(Json.Serialize(Model.ProcessedDataByCountry));
        let submittedCountries = @Html.Raw(Json.Serialize(Model.SubmittedCountries));
        let sessionId = '@Model.SessionId';

        // Switch country view
        function switchCountry() {
            const dropdown = document.getElementById('countryDropdown');
            const selectedCountry = dropdown.value;
            
            // Hide all tables
            document.querySelectorAll('.country-table').forEach(table => {
                table.classList.remove('active');
            });
            
            if (selectedCountry) {
                // Show selected table
                const targetTable = document.querySelector(`[data-country="${selectedCountry}"]`);
                if (targetTable) {
                    targetTable.classList.add('active');
                }
                
                // Show settings panel and stats
                document.getElementById('settingsPanel').style.display = 'block';
                document.getElementById('statsRow').style.display = 'block';
                
                // Update stats
                updateStats(selectedCountry);
            } else {
                // Hide panels
                document.getElementById('settingsPanel').style.display = 'none';
                document.getElementById('statsRow').style.display = 'none';
            }
        }

        // Update mode - Fixed to recalculate data
        async function updateMode() {
            const selectedCountry = document.getElementById('countryDropdown').value;
            const shipmentType = document.querySelector('input[name="shipmentType"]:checked')?.value;
            
            console.log('UpdateMode called:', { selectedCountry, shipmentType, sessionId });
            
            if (!selectedCountry || !shipmentType) {
                console.warn('Missing required data for updateMode');
                return;
            }
            
            try {
                showLoadingState('Recalculating...');
                
                const requestBody = {
                    sessionId: parseInt(sessionId),
                    shipmentType: shipmentType
                };
                
                console.log('Sending request:', requestBody);
                
                const response = await fetch('/PO/UpdateMode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(requestBody)
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const result = await response.json();
                console.log('UpdateMode response:', result);
                
                if (result.success && result.dataByCountry) {
                    // Update all country data
                    Object.keys(result.dataByCountry).forEach(country => {
                        updateCurrentDataForCountry(country, result.dataByCountry[country]);
                    });
                    
                    // Update display for current country
                    updateTableDisplay(selectedCountry);
                    updateStats(selectedCountry);
                    showToast('✅ Calculation updated successfully!', 'success');
                } else {
                    throw new Error(result.message || 'Failed to update calculation');
                }
            } catch (error) {
                console.error('Error updating mode:', error);
                showToast('❌ Error updating calculation: ' + error.message, 'error');
            } finally {
                hideLoadingState();
            }
        }

        // Update statistics
        function updateStats(country) {
            const data = currentData[country];
            if (!data) return;

            let totalItems = data.length;
            let totalPallets = 0;
            let totalBoxes = 0;
            let totalPCS = 0;

            data.forEach(item => {
                totalPallets += item.QtyPallet || 0;
                totalBoxes += item.QtyBox || 0;
                totalPCS += item.QtyPcs || 0;
            });

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('totalPallets').textContent = totalPallets;
            document.getElementById('totalBoxes').textContent = totalBoxes;
            document.getElementById('totalPCS').textContent = totalPCS;
        }

        // Helper function to update current data for specific country
        function updateCurrentDataForCountry(country, newData) {
            // Transform backend data to match frontend structure
            currentData[country] = newData.map(item => ({
                NoPO: item.noPO || item.NoPO,
                Model: item.model || item.Model,
                TotalQty: item.totalQty || item.TotalQty,
                QtyPallet: item.qtyPallet || item.QtyPallet || 0,
                QtyBox: item.qtyBox || item.QtyBox || 0,
                QtyPcs: item.qtyPcs || item.QtyPcs || 0,
                Country: country,
                Container: item.container || item.Container || '',
                NoInvoice: item.noInvoice || item.NoInvoice || '',
                ShipmentDetail: item.shipmentDetail || item.ShipmentDetail || ''
            }));
        }

        // Helper function to update table display
        function updateTableDisplay(country) {
            const tableBody = document.querySelector(`#table_${country.replace(/ /g, '_')} tbody`);
            if (!tableBody) return;
            
            const data = currentData[country];
            if (!data) return;
            
            tableBody.innerHTML = '';
            
            data.forEach((item, index) => {
                const row = document.createElement('tr');
                row.setAttribute('data-row-index', index);
                row.setAttribute('data-country', country);
                row.className = 'row-locked';
                
                row.innerHTML = `
                    <td>
                        <button type="button" 
                                class="btn btn-sm btn-outline-warning row-lock-btn" 
                                data-locked="true"
                                onclick="toggleRowLock(this, '${country}', ${index})">
                            <i class="fas fa-lock"></i>
                        </button>
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm editable-field" 
                               name="po_${country.replace(/ /g, '_')}_${index}" 
                               value="${item.NoPO}" 
                               data-original-value="${item.NoPO}"
                               readonly />
                    </td>
                    <td>
                        <span class="badge bg-primary">
                            <i class="fas fa-tag me-1"></i>
                            ${item.Model}
                        </span>
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm editable-field" 
                               name="qty_${country.replace(/ /g, '_')}_${index}" 
                               value="${item.TotalQty}" 
                               data-original-value="${item.TotalQty}"
                               readonly />
                    </td>
                    <td>
                        <span class="badge bg-success fs-6 qty-display" data-type="pallet">
                            ${item.QtyPallet}
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-warning fs-6 qty-display" data-type="box">
                            ${item.QtyBox}
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-info fs-6 qty-display" data-type="pcs">
                            ${item.QtyPcs}
                        </span>
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">
                                <i class="fas fa-file-invoice text-muted"></i>
                            </span>
                            <input type="text" class="form-control editable-field" 
                                   name="invoice_${country.replace(/ /g, '_')}_${index}" 
                                   placeholder="Invoice number..." 
                                   value="${item.NoInvoice || ''}" 
                                   data-original-value="${item.NoInvoice || ''}"
                                   readonly />
                        </div>
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">
                                <i class="fas fa-shipping-fast text-muted"></i>
                            </span>
                            <input type="text" class="form-control editable-field" 
                                   name="container_${country.replace(/ /g, '_')}_${index}" 
                                   placeholder="Container ID..." 
                                   value="${item.Container || ''}" 
                                   data-original-value="${item.Container || ''}"
                                   readonly />
                        </div>
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">
                                <i class="fas fa-info-circle text-muted"></i>
                            </span>
                            <input type="text" class="form-control editable-field" 
                                   name="detail_${country.replace(/ /g, '_')}_${index}" 
                                   placeholder="Additional details..." 
                                   value="${item.ShipmentDetail || ''}" 
                                   data-original-value="${item.ShipmentDetail || ''}"
                                   readonly />
                        </div>
                    </td>
                `;
                
                tableBody.appendChild(row);
                
                // Add event listeners for change detection
                const editableFields = row.querySelectorAll('.editable-field');
                editableFields.forEach(field => {
                    field.addEventListener('input', function() {
                        markRowAsModified(row);
                    });
                });
            });
        }

        // Loading state helpers
        function showLoadingState(message = 'Loading...') {
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'loadingOverlay';
            loadingDiv.className = 'loading-overlay';
            loadingDiv.innerHTML = `
                <div class="loading-content">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">${message}</p>
                </div>
            `;
            document.body.appendChild(loadingDiv);
        }

        function hideLoadingState() {
            const loadingDiv = document.getElementById('loadingOverlay');
            if (loadingDiv) {
                loadingDiv.remove();
            }
        }

        // Submit country
        // New function to handle button click safely
        async function submitCountryByButton(button) {
            const country = button.getAttribute('data-country');
            await submitCountry(country);
        }

        async function submitCountry(country) {
            const button = event.target;
            const originalText = button.innerHTML;
            
            // Get form data
            const shipmentType = document.querySelector('input[name="shipmentType"]:checked').value;
            const shipmentDate = document.getElementById('shipmentDate').value;

            if (!shipmentDate) {
                alert('Please select shipment date!');
                return;
            }

            // Update button state
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

            try {
                // Collect row data for this country
                const tableRows = document.querySelectorAll(`#table_${country.replace(/ /g, '_')} tbody tr`);
                const countryData = [];
                
                tableRows.forEach((row, index) => {
                    const cells = row.querySelectorAll('td');
                    const invoice = row.querySelector(`input[name="invoice_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const container = row.querySelector(`input[name="container_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const detail = row.querySelector(`input[name="detail_${country.replace(/ /g, '_')}_${index}"]`).value;
                    
                    // Get data from currentData (which includes updated calculations)
                    const currentRowData = currentData[country][index];
                    
                    // Get current values from UI (in case they were updated but not yet saved)
                    const currentPO = row.querySelector(`input[name="po_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const currentQty = parseInt(row.querySelector(`input[name="qty_${country.replace(/ /g, '_')}_${index}"]`).value);
                    
                    // Get current calculated quantities from UI display
                    const currentPallet = parseInt(row.querySelector('.qty-display[data-type="pallet"]').textContent) || 0;
                    const currentBox = parseInt(row.querySelector('.qty-display[data-type="box"]').textContent) || 0;
                    const currentPcs = parseInt(row.querySelector('.qty-display[data-type="pcs"]').textContent) || 0;
                    
                    countryData.push({
                        NoPO: currentPO || currentRowData.NoPO,
                        Model: currentRowData.Model,
                        TotalQty: currentQty || currentRowData.TotalQty,
                        QtyPallet: currentPallet,
                        QtyBox: currentBox,
                        QtyPcs: currentPcs,
                        NoInvoice: invoice,
                        Container: container,
                        ShipmentDetail: detail,
                        Country: country
                    });
                });

                const requestData = {
                    SessionId: parseInt(sessionId),
                    Country: country,
                    ShipmentType: shipmentType,
                    ShipmentDate: shipmentDate,
                    ProcessedData: countryData
                };

                const response = await fetch('/PO/SubmitCountry', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(requestData)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    // Success feedback
                    button.innerHTML = '<i class="fas fa-check me-2"></i>Submitted ✅';
                    button.classList.remove('btn-submit-country');
                    button.classList.add('btn-secondary');
                    
                    // Remove from dropdown
                    const dropdown = document.getElementById('countryDropdown');
                    const option = dropdown.querySelector(`option[value="${country}"]`);
                    if (option) option.remove();
                    
                    // Update pending badges - Fix selector issue
                    const pendingBadges = document.querySelectorAll('.pending-badge');
                    pendingBadges.forEach(badge => {
                        if (badge.textContent.includes(country)) {
                            badge.className = 'submitted-badge';
                            badge.innerHTML = `<i class="fas fa-check"></i> ${country}`;
                        }
                    });
                    
                    // Hide current table
                    document.querySelector(`[data-country="${country}"]`).style.display = 'none';
                    
                    // Check if all countries are submitted
                    if (dropdown.options.length <= 1) { // Only default option left
                        document.getElementById('settingsPanel').style.display = 'none';
                        document.getElementById('statsRow').style.display = 'none';
                        document.getElementById('countryTables').style.display = 'none';
                        document.getElementById('allDoneMessage').style.display = 'block';
                    } else {
                        // Auto-select next country
                        if (dropdown.options.length > 1) {
                            dropdown.selectedIndex = 1;
                            switchCountry();
                        }
                    }
                    
                    // Show success message
                    showToast(`✅ ${country} submitted successfully!`, 'success');
                    
                } else {
                    throw new Error(result.message || 'Submission failed');
                }

            } catch (error) {
                console.error('Error:', error);
                button.disabled = false;
                button.innerHTML = originalText;
                showToast(`❌ Error: ${error.message}`, 'error');
            }
        }

        // Enhanced Toast notification
        function showToast(message, type) {
            // Remove existing toasts
            const existingToasts = document.querySelectorAll('.custom-toast');
            existingToasts.forEach(toast => toast.remove());
            
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed custom-toast`;
            toast.style.cssText = `
                top: 20px; 
                right: 20px; 
                z-index: 9999; 
                min-width: 350px; 
                max-width: 500px;
                box-shadow: var(--shadow-lg);
                border-radius: var(--radius-lg);
                animation: slideInRight 0.3s ease-out;
            `;
            
            toast.innerHTML = `
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'} fa-lg"></i>
                    </div>
                    <div class="flex-grow-1">${message}</div>
                    <button type="button" class="btn-close ms-2" onclick="this.parentElement.parentElement.remove()"></button>
                </div>
            `;
            
            document.body.appendChild(toast);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.style.animation = 'slideOutRight 0.3s ease-in';
                    setTimeout(() => toast.remove(), 300);
                }
            }, 5000);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-select first country if available
            const dropdown = document.getElementById('countryDropdown');
            if (dropdown && dropdown.options.length > 1) {
                dropdown.selectedIndex = 1;
                switchCountry();
                
                // Automatically trigger calculations on page load
                setTimeout(() => {
                    updateMode(); // This will calculate quantities without requiring manual radio button click
                }, 300); // Small delay to ensure country switch is complete
            }

            // Initialize all rows as locked
            initializeRowStates();
            
            // Ensure accessibility mode is applied based on saved preference
            const isAccessible = localStorage.getItem('accessibleMode') === 'true';
            document.getElementById('accessibilityMode').checked = isAccessible;
            if (isAccessible) {
                document.body.classList.add('accessible-view');
            }
        });

        // Initialize row states
        function initializeRowStates() {
            document.querySelectorAll('tr[data-row-index]').forEach(row => {
                row.classList.add('row-locked');
                
                // Store original values for comparison
                const editableFields = row.querySelectorAll('.editable-field');
                editableFields.forEach(field => {
                    field.setAttribute('data-original-value', field.value);
                    
                    // Add change event listener
                    field.addEventListener('input', function() {
                        markRowAsModified(row);
                    });
                });
            });
        }

        // Toggle row lock/unlock
        async function toggleRowLock(button, country, rowIndex) {
            const row = button.closest('tr');
            const isCurrentlyLocked = button.getAttribute('data-locked') === 'true';
            
            if (isCurrentlyLocked) {
                // Unlock row
                unlockRow(button, row);
            } else {
                // Lock row - check for changes first
                await lockRow(button, row, country, rowIndex);
            }
        }

        // Unlock row
        function unlockRow(button, row) {
            button.setAttribute('data-locked', 'false');
            button.innerHTML = '<i class="fas fa-unlock"></i>';
            button.className = 'btn btn-sm btn-outline-success row-lock-btn';
            
            row.classList.remove('row-locked');
            row.classList.add('row-unlocked');
            
            // Enable editing
            const editableFields = row.querySelectorAll('.editable-field');
            editableFields.forEach(field => {
                field.removeAttribute('readonly');
            });
            
            showToast('🔓 Row unlocked - You can now edit this data', 'success');
        }

        // Lock row
        async function lockRow(button, row, country, rowIndex) {
            // Check if data has been modified
            const hasChanges = checkRowChanges(row);
            
            if (hasChanges) {
                // Show confirmation dialog
                const confirmed = await showConfirmationDialog(
                    'Data Changes Detected',
                    'You have made changes to this row. Do you want to save the changes and recalculate quantities?',
                    'Save & Lock',
                    'Cancel'
                );
                
                if (!confirmed) {
                    return; // User cancelled
                }
                
                // Save changes and recalculate
                try {
                    await saveRowChanges(row, country, rowIndex);
                    
                    // Success - lock the row
                    performRowLock(button, row);
                    showToast('✅ Changes saved and quantities recalculated', 'success');
                    
                } catch (error) {
                    showToast('❌ Error saving changes: ' + error.message, 'error');
                    return;
                }
            } else {
                // No changes, just lock
                performRowLock(button, row);
                showToast('🔒 Row locked', 'success');
            }
        }

        // Perform the actual row locking
        function performRowLock(button, row) {
            button.setAttribute('data-locked', 'true');
            button.innerHTML = '<i class="fas fa-lock"></i>';
            button.className = 'btn btn-sm btn-outline-warning row-lock-btn';
            
            row.classList.remove('row-unlocked', 'row-modified');
            row.classList.add('row-locked');
            
            // Disable editing
            const editableFields = row.querySelectorAll('.editable-field');
            editableFields.forEach(field => {
                field.setAttribute('readonly', 'readonly');
                // Update original value after save
                field.setAttribute('data-original-value', field.value);
            });
        }

        // Check if row has changes
        function checkRowChanges(row) {
            const editableFields = row.querySelectorAll('.editable-field');
            for (let field of editableFields) {
                const originalValue = field.getAttribute('data-original-value') || '';
                const currentValue = field.value || '';
                if (originalValue !== currentValue) {
                    return true;
                }
            }
            return false;
        }

        // Mark row as modified
        function markRowAsModified(row) {
            if (!row.classList.contains('row-locked')) {
                row.classList.add('row-modified');
            }
        }

        // Save row changes and recalculate
        async function saveRowChanges(row, country, rowIndex) {
            // Get core data (PO and Qty) for recalculation
            const coreData = {
                rowIndex: parseInt(rowIndex),
                country: country,
                noPO: row.querySelector(`input[name="po_${country.replace(/ /g, '_')}_${rowIndex}"]`).value,
                totalQty: parseInt(row.querySelector(`input[name="qty_${country.replace(/ /g, '_')}_${rowIndex}"]`).value) || 0
            };

            // Get metadata (invoice, container, detail) for local storage
            const metadata = {
                noInvoice: row.querySelector(`input[name="invoice_${country.replace(/ /g, '_')}_${rowIndex}"]`).value,
                container: row.querySelector(`input[name="container_${country.replace(/ /g, '_')}_${rowIndex}"]`).value,
                shipmentDetail: row.querySelector(`input[name="detail_${country.replace(/ /g, '_')}_${rowIndex}"]`).value
            };

            const requestData = {
                sessionId: parseInt(sessionId),
                country: country,
                rowIndex: rowIndex,
                rowData: coreData,
                shipmentType: document.querySelector('input[name="shipmentType"]:checked')?.value || 'LOOSE'
            };

            const response = await fetch('/PO/UpdateRowData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(requestData)
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const result = await response.json();
            
            if (!result.success) {
                throw new Error(result.message || 'Failed to save changes');
            }

            // Update the row with new calculated values
            if (result.updatedRowData) {
                // Update core calculated data
                updateRowDisplay(row, result.updatedRowData);
                
                // Update currentData with both core and metadata
                if (currentData[country] && currentData[country][rowIndex]) {
                    Object.assign(currentData[country][rowIndex], {
                        ...result.updatedRowData,
                        ...metadata // Include metadata in local data
                    });
                }
                
                // Update stats for current country
                updateStats(country);
            }
        }

        // Update row display with new data
        function updateRowDisplay(row, newData) {
            // Update quantity displays
            const palletDisplay = row.querySelector('.qty-display[data-type="pallet"]');
            const boxDisplay = row.querySelector('.qty-display[data-type="box"]');
            const pcsDisplay = row.querySelector('.qty-display[data-type="pcs"]');
            
            if (palletDisplay) palletDisplay.textContent = newData.qtyPallet || 0;
            if (boxDisplay) boxDisplay.textContent = newData.qtyBox || 0;
            if (pcsDisplay) pcsDisplay.textContent = newData.qtyPcs || 0;
        }

        // Enhanced confirmation dialog
        function showConfirmationDialog(title, message, confirmText = 'Confirm', cancelText = 'Cancel') {
            return new Promise((resolve) => {
                // Remove existing modal if any
                const existingModal = document.getElementById('confirmationModal');
                if (existingModal) {
                    existingModal.remove();
                }

                const modal = document.createElement('div');
                modal.id = 'confirmationModal';
                modal.className = 'modal fade';
                modal.innerHTML = `
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-warning text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    ${title}
                                </h5>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">${message}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-2"></i>
                                    ${cancelText}
                                </button>
                                <button type="button" class="btn btn-warning" id="confirmBtn">
                                    <i class="fas fa-check me-2"></i>
                                    ${confirmText}
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                document.body.appendChild(modal);

                // Initialize Bootstrap modal
                const bsModal = new bootstrap.Modal(modal);
                
                // Handle confirm
                modal.querySelector('#confirmBtn').addEventListener('click', () => {
                    resolve(true);
                    bsModal.hide();
                });

                // Handle cancel/close
                modal.addEventListener('hidden.bs.modal', () => {
                    resolve(false);
                    modal.remove();
                });

                bsModal.show();
            });
        }
    </script>
}
