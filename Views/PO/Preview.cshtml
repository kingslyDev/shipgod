        // ===== COUNTRY MOVE FUNCTIONALITY =====
        let currentMoveContext = {
            fromCountry: null,
            rowIndex: null,
            selectedCountry: null,
            isNewCountry: false
        };

        // Show country move modal
        function showCountryMoveModal(fromCountry, rowIndex) {
            currentMoveContext = {
                fromCountry: fromCountry,
                rowIndex: parseInt(rowIndex),
                selectedCountry: null,
                isNewCountry: false
            };

            // Get row data for display
            const rowData = currentData[fromCountry][rowIndex];
