                                                <td>${new Date(move.timestamp).toLocaleTimeString()}</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="undoMove('${move.moveId}')">
                                                        <i class="fas fa-undo"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-warning" onclick="undoAllMoves()">
                                <i class="fas fa-undo me-2"></i>
                                Undo All Moves
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            
            modal.addEventListener('hidden.bs.modal', () => {
                modal.remove();
            });
        }
        
        // Undo specific move
    function undoMove(moveId) {
            const moveIndex = holdState.movedRows.findIndex(m => m.moveId === moveId);
            if (moveIndex === -1) return;
            
            const move = holdState.movedRows[moveIndex];
            
            // Remove from hold state
            holdState.movedRows.splice(moveIndex, 1);
            
            // Restore UI
            const row = document.querySelector(`tr[data-move-id="${moveId}"]`);
            if (row) {
                row.classList.remove('row-moved');
                row.removeAttribute('data-move-id');
                
                // Remove indicator
                const indicator = row.querySelector('.move-indicator');
                if (indicator) indicator.remove();
                
                // Re-enable editing
                const editableFields = row.querySelectorAll('.editable-field');
                editableFields.forEach(field => {
                    field.disabled = false;
                    field.style.backgroundColor = '';
                });
                
                // Re-enable buttons
                const buttons = row.querySelectorAll('button');
                buttons.forEach(btn => {
                    btn.disabled = false;
                    btn.style.opacity = '';
                });
            }
            
            // If destination country becomes empty (e.g., it was just created for this move), clear its pending data and UI
            const affectedCountries = [move.fromCountry, move.toCountry];
            affectedCountries.forEach(cty => {
                // If no more moves affect this country, try to restore or clear recalcs
                const stillAffected = holdState.movedRows.some(m => m.fromCountry === cty || m.toCountry === cty);
                if (!stillAffected) {
                    // Remove recalculated snapshot to fall back to currentData
                    delete holdState.pendingRecalculations[cty];
                    updateTableDisplay(cty);
                    updateStats(cty);
                    refreshCountryCounts(cty);
                    removeCountryUIIfEmpty(cty);
                } else {
                    // Just refresh counts
                    refreshCountryCounts(cty);
                }
            });

            // Update hold state info
            if (holdState.movedRows.length === 0) {
                const holdInfo = document.getElementById('holdStateInfo');
                if (holdInfo) holdInfo.remove();
            } else {
                showHoldStateInfo();
            }
            
            showToast(`✅ Move undone: ${move.rowData.NoPO} back to ${move.fromCountry}`, 'success');
            
            // Close modal and refresh if needed
            const modal = document.querySelector('.modal.show');
            if (modal) {
                bootstrap.Modal.getInstance(modal).hide();
            }
        }
        
        // Undo all moves
        function undoAllMoves() {
            const moveIds = holdState.movedRows.map(m => m.moveId);
            moveIds.forEach(id => undoMove(id));
            
            showToast(`✅ All ${moveIds.length} moves undone`, 'success');
        }
    </script>
}
