        // Submit country
        // New function to handle button click safely
        async function submitCountryByButton(button) {
            const country = button.getAttribute('data-country');
            await submitCountry(country);
        }

        async function submitCountry(country) {
            const button = event.target;
            const originalText = button.innerHTML;
            
            // Get form data
            const shipmentType = document.querySelector('input[name="shipmentType"]:checked').value;
            const shipmentDate = document.getElementById('shipmentDate').value;

            if (!shipmentDate) {
                alert('Please select shipment date!');
                return;
            }

            // Update button state
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

            try {
                // Collect row data for this country INCLUDING HOLD STATE MOVES
                const tableRows = document.querySelectorAll(`#table_${country.replace(/ /g, '_')} tbody tr`);
                const countryData = [];
                
                // Get current data from UI (may have been modified)
                tableRows.forEach((row, index) => {
                    // Skip moved rows (they are visually there but logically moved)
                    if (row.classList.contains('row-moved')) {
                        return;
                    }
                    
                    const cells = row.querySelectorAll('td');
                    const invoice = row.querySelector(`input[name="invoice_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const container = row.querySelector(`input[name="container_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const detail = row.querySelector(`input[name="detail_${country.replace(/ /g, '_')}_${index}"]`).value;
                    
                    // Get data from currentData or holdState
                    let currentRowData;
                    if (holdState.pendingRecalculations[country] && holdState.pendingRecalculations[country][index]) {
                        currentRowData = holdState.pendingRecalculations[country][index];
                    } else {
                        currentRowData = currentData[country][index];
                    }
                    
                    // Get current values from UI (in case they were updated)
                    const currentPO = row.querySelector(`input[name="po_${country.replace(/ /g, '_')}_${index}"]`).value;
                    const currentQty = parseInt(row.querySelector(`input[name="qty_${country.replace(/ /g, '_')}_${index}"]`).value);
                    
                    // Get quantities from recalculated data or UI display
                    let currentPallet, currentBox, currentPcs;
                    if (holdState.pendingRecalculations[country] && holdState.pendingRecalculations[country][index]) {
                        const recalcData = holdState.pendingRecalculations[country][index];
                        currentPallet = recalcData.QtyPallet || recalcData.qtyPallet || 0;
                        currentBox = recalcData.QtyBox || recalcData.qtyBox || 0;
                        currentPcs = recalcData.QtyPcs || recalcData.qtyPcs || 0;
                    } else {
                        currentPallet = parseInt(row.querySelector('.qty-display[data-type="pallet"]').textContent) || 0;
                        currentBox = parseInt(row.querySelector('.qty-display[data-type="box"]').textContent) || 0;
                        currentPcs = parseInt(row.querySelector('.qty-display[data-type="pcs"]').textContent) || 0;
                    }
                    
                    countryData.push({
                        NoPO: currentPO || currentRowData.NoPO,
                        Model: currentRowData.Model,
                        TotalQty: currentQty || currentRowData.TotalQty,
                        QtyPallet: currentPallet,
                        QtyBox: currentBox,
                        QtyPcs: currentPcs,
                        NoInvoice: invoice,
                        Container: container,
                        ShipmentDetail: detail,
                        Country: country
                    });
                });

                // ADD moved-in rows from hold state for this country
                const movedInRows = holdState.movedRows.filter(m => m.toCountry === country);
                movedInRows.forEach(move => {
                    // Get recalculated data for this moved row
                    const recalcData = holdState.pendingRecalculations[country];
                    if (recalcData) {
                        // Find the row in recalculated data that matches this move
                        const matchingRecalc = recalcData.find(r => r.Model === move.rowData.Model && r.NoPO === move.rowData.NoPO);
                        if (matchingRecalc) {
                            countryData.push({
                                NoPO: matchingRecalc.NoPO,
                                Model: matchingRecalc.Model,
                                TotalQty: matchingRecalc.TotalQty,
                                QtyPallet: matchingRecalc.QtyPallet || matchingRecalc.qtyPallet || 0,
                                QtyBox: matchingRecalc.QtyBox || matchingRecalc.qtyBox || 0,
                                QtyPcs: matchingRecalc.QtyPcs || matchingRecalc.qtyPcs || 0,
                                NoInvoice: move.rowData.NoInvoice || '',
                                Container: move.rowData.Container || '',
                                ShipmentDetail: move.rowData.ShipmentDetail || '',
                                Country: country
                            });
                        }
                    }
                });

                const requestData = {
                    SessionId: parseInt(sessionId),
                    Country: country,
                    ShipmentType: shipmentType,
                    ShipmentDate: shipmentDate,
                    ProcessedData: countryData,
                    // INCLUDE HOLD STATE MOVES for server processing
                    HoldStateMoves: holdState.movedRows.filter(m => m.fromCountry === country || m.toCountry === country)
                };

                const response = await fetch('/PO/SubmitCountry', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(requestData)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    // SUCCESS: Clear hold state for this country
                    clearHoldStateForCountry(country);
                    
                    // Success feedback
                    button.innerHTML = '<i class="fas fa-check me-2"></i>Submitted ✅';
                    button.classList.remove('btn-submit-country');
                    button.classList.add('btn-secondary');
                    
                    // Remove from dropdown
                    const dropdown = document.getElementById('countryDropdown');
                    const option = dropdown.querySelector(`option[value="${country}"]`);
                    if (option) option.remove();
                    
                    // Update pending badges
                    const pendingBadges = document.querySelectorAll('.pending-badge');
                    pendingBadges.forEach(badge => {
                        if (badge.textContent.includes(country)) {
                            badge.className = 'submitted-badge';
                            badge.innerHTML = `<i class="fas fa-check"></i> ${country}`;
                        }
                    });
                    
                    // Hide current table
                    document.querySelector(`[data-country="${country}"]`).style.display = 'none';
                    
                    // Check if all countries are submitted
                    if (dropdown.options.length <= 1) { // Only default option left
                        document.getElementById('settingsPanel').style.display = 'none';
                        document.getElementById('statsRow').style.display = 'none';
                        document.getElementById('countryTables').style.display = 'none';
                        document.getElementById('allDoneMessage').style.display = 'block';
                        
                        // Clear all hold state
                        holdState.movedRows = [];
                        holdState.pendingRecalculations = {};
                        const holdInfo = document.getElementById('holdStateInfo');
                        if (holdInfo) holdInfo.remove();
                    } else {
                        // Auto-select next country
                        if (dropdown.options.length > 1) {
                            dropdown.selectedIndex = 1;
                            switchCountry();
                            
                            // Show auto-mode notification if enabled
                            const autoLooseMode = document.getElementById('autoLooseMode')?.checked;
                            if (autoLooseMode) {
                                setTimeout(() => {
                                    showToast(`🚀 Auto LOOSE Mode: Next country automatically set to LOOSE and calculated!`, 'success');
                                }, 500);
                            }
                        }
                    }
                    
                    // Show success message
                    showToast(`✅ ${country} submitted successfully with all moves applied!`, 'success');

                    // Auto-download Barcode PDF for the newly created session (country-specific)
                    if (result.newSessionId) {
                        autoDownloadCountryPdf(result.newSessionId);
                    }
                    
                } else {
                    throw new Error(result.message || 'Submission failed');
                }

            } catch (error) {
                console.error('Error:', error);
                button.disabled = false;
                button.innerHTML = originalText;
                showToast(`❌ Error: ${error.message}`, 'error');
            }
        }
        
        // Clear hold state for submitted country
        function clearHoldStateForCountry(country) {
            // Remove moves related to this country
            holdState.movedRows = holdState.movedRows.filter(m => 
                m.fromCountry !== country && m.toCountry !== country
            );
            
            // Remove pending recalculations for this country
            delete holdState.pendingRecalculations[country];
            
            // Update hold state info
            if (holdState.movedRows.length === 0) {
                const holdInfo = document.getElementById('holdStateInfo');
                if (holdInfo) holdInfo.remove();
            } else {
                showHoldStateInfo();
            }
        }

        // Enhanced Toast notification
        function showToast(message, type) {
            // Remove existing toasts
            const existingToasts = document.querySelectorAll('.custom-toast');
            existingToasts.forEach(toast => toast.remove());
            
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed custom-toast`;
            toast.style.cssText = `
                top: 20px; 
                right: 20px; 
                z-index: 9999; 
                min-width: 350px; 
                max-width: 500px;
                box-shadow: var(--shadow-lg);
                border-radius: var(--radius-lg);
                animation: slideInRight 0.3s ease-out;
            `;
            
            toast.innerHTML = `
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'} fa-lg"></i>
                    </div>
                    <div class="flex-grow-1">${message}</div>
                    <button type="button" class="btn-close ms-2" onclick="this.parentElement.parentElement.remove()"></button>
                </div>
            `;
            
            document.body.appendChild(toast);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.style.animation = 'slideOutRight 0.3s ease-in';
                    setTimeout(() => toast.remove(), 300);
                }
            }, 5000);
        }

