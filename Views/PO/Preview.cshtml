@model ShipmentFinishGood.DTOs.UploadPreviewDto
@{
    ViewData["Title"] = "Periksa Data PO";
}

@section Styles {
    <link rel="stylesheet" href="~/css/po.css" asp-append-version="true" />
}

<div class="main-container">
    <!-- Enhanced Header -->
    <div class="page-header">
        <h1>
            <i class="fas fa-clipboard-check"></i>
            Periksa Data Sebelum Disimpan
        </h1>
        <p class="subtitle">
            📁 File: <strong>@Model.FileName</strong> | Pastikan semua data sudah benar sebelum melanjutkan
        </p>
    </div>

    <!-- Enhanced Breadcrumb -->
    <nav class="breadcrumb-enhanced" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Home")">🏠 Beranda</a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "PO")">📋 Daftar PO</a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Create", "PO")">📤 Upload Data</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">👀 Periksa Data</li>
        </ol>
    </nav>

    <!-- Progress Wizard -->
    <div class="progress-wizard">
        <div class="progress-step completed">
            <div class="step-circle">✓</div>
            <div class="step-label">Upload File</div>
        </div>
        <div class="progress-step active">
            <div class="step-circle">2</div>
            <div class="step-label">Periksa Data</div>
        </div>
        <div class="progress-step">
            <div class="step-circle">3</div>
            <div class="step-label">Selesai</div>
        </div>
    </div>

    <form id="submitForm" asp-action="Submit" method="post">
        <input type="hidden" name="SessionId" value="@Model.SessionId" />
        
        <!-- Settings Section -->
        <div class="row">
            <div class="col-lg-6">
                <div class="settings-card">
                    <div class="card-header-enhanced">
                        <i class="fas fa-cogs me-2"></i>Pengaturan Shipment
                    </div>
                    <div class="card-body-enhanced">
                        <div class="mb-4">
                            <label class="form-label-enhanced">Mode Shipment</label>
                            <div class="radio-option" onclick="selectRadio('modeLoose')">
                                <input class="form-check-input" type="radio" name="ShipmentType" id="modeLoose" value="LOOSE" checked>
                                <label for="modeLoose">
                                    <i class="fas fa-boxes me-2"></i>LOOSE (Gabung per Model)
                                    <br><small class="text-muted">Menggabungkan produk berdasarkan model yang sama</small>
                                </label>
                            </div>
                            <div class="radio-option" onclick="selectRadio('modePallet')">
                                <input class="form-check-input" type="radio" name="ShipmentType" id="modePallet" value="PALLET">
                                <label for="modePallet">
                                    <i class="fas fa-pallet me-2"></i>PALLET (Gabung per PO + Model)
                                    <br><small class="text-muted">Menggabungkan berdasarkan PO dan model</small>
                                </label>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-enhanced" for="shipmentDate">Tanggal Shipment</label>
                                <input type="date" id="shipmentDate" name="ShipmentDate" class="form-control-enhanced" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label-enhanced" for="palletPrefix">Prefix Pallet</label>
                                <input type="text" id="palletPrefix" name="PalletPrefix" class="form-control-enhanced" placeholder="Contoh: AA" maxlength="5">
                                <small class="text-muted">Prefix untuk barcode pallet (opsional)</small>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-enhanced" for="pcsPrefix">Prefix PCS</label>
                                <input type="text" id="pcsPrefix" name="PcsPrefix" class="form-control-enhanced" placeholder="Contoh: AB" maxlength="5">
                                <small class="text-muted">Prefix untuk barcode PCS (opsional)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <!-- Statistics -->
                <div class="stats-container">
                    <div class="stat-card">
                        <div class="stat-number" id="totalRows">@Model.RawData.Count</div>
                        <div class="stat-label">Total Baris Excel</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="processedRows">@Model.ProcessedData.Count</div>
                        <div class="stat-label">Baris Diproses</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="totalBoxes">0</div>
                        <div class="stat-label">Total BOX</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-container">
            <div class="table-header">
                <i class="fas fa-table me-2"></i>Data Setelah Diproses
            </div>
            <div class="table-responsive">
                <table class="table-enhanced" id="previewTable">
                    <thead>
                        <tr>
                            <th>No PO</th>
                            <th>Model</th>
                            <th>Total Qty</th>
                            <th>Pallet</th>
                            <th>Box</th>
                            <th>PCS</th>
                            <th>Invoice</th>
                            <th>Container</th>
                            <th>Shipment Detail</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="previewTableBody">
                        @for (int i = 0; i < Model.ProcessedData.Count; i++)
                        {
                            <tr data-index="@i">
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].NoPO" value="@Model.ProcessedData[i].NoPO" />
                                    <strong>@Model.ProcessedData[i].NoPO</strong>
                                </td>
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].Model" value="@Model.ProcessedData[i].Model" />
                                    <span class="badge-enhanced" style="background: var(--primary-color); color: white;">@Model.ProcessedData[i].Model</span>
                                </td>
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].TotalQty" value="@Model.ProcessedData[i].TotalQty" />
                                    <strong style="color: var(--primary-color);">@Model.ProcessedData[i].TotalQty.ToString("N0")</strong>
                                </td>
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].QtyPallet" value="@Model.ProcessedData[i].QtyPallet" />
                                    <span class="badge-enhanced" style="background: var(--success-color); color: white;">@Model.ProcessedData[i].QtyPallet</span>
                                </td>
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].QtyBox" value="@Model.ProcessedData[i].QtyBox" />
                                    <span class="badge-enhanced" style="background: var(--warning-color); color: white;">@Model.ProcessedData[i].QtyBox</span>
                                </td>
                                <td>
                                    <input type="hidden" name="ProcessedData[@i].QtyPcs" value="@Model.ProcessedData[i].QtyPcs" />
                                    <span class="badge-enhanced" style="background: var(--primary-light); color: white;">@Model.ProcessedData[i].QtyPcs</span>
                                </td>
                                <td>
                                    <input type="text" name="ProcessedData[@i].NoInvoice" class="form-control-enhanced" style="font-size: 0.9rem; padding: 8px;" placeholder="Invoice..." value="@Model.ProcessedData[i].NoInvoice" />
                                </td>
                                <td>
                                    <input type="text" name="ProcessedData[@i].Container" class="form-control-enhanced" style="font-size: 0.9rem; padding: 8px;" placeholder="Container..." value="@Model.ProcessedData[i].Container" />
                                </td>
                                <td>
                                    <input type="text" name="ProcessedData[@i].ShipmentDetail" class="form-control-enhanced" style="font-size: 0.9rem; padding: 8px;" placeholder="Detail..." value="@Model.ProcessedData[i].ShipmentDetail" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm" style="background: var(--primary-light); color: white; border: none; padding: 8px 12px; border-radius: var(--border-radius);" onclick="editRow(@i)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button type="submit" class="btn-large btn-primary-large">
                <i class="fas fa-calculator me-2"></i>Submit & Calculate
            </button>
            <a asp-action="Create" class="btn-large btn-secondary-large">
                <i class="fas fa-arrow-left me-2"></i>Upload Ulang
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/po.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            if (window.PO && PO.initPreview) PO.initPreview(@Model.SessionId);
        });
    </script>
}