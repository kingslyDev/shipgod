@model List<ShipmentFinishGood.DTOs.POSessionSummaryDto>
@{
    ViewData["Title"] = "Purchase Orders Management";
}
@section Styles {
    <link rel="stylesheet" href="~/css/po.css" asp-append-version="true" />
    <style>
        .filter-card { background: #f8f9fa; border-radius: 10px; }
        .session-card { transition: transform 0.2s; }
        .session-card:hover { transform: translateY(-2px); }
        .progress-ring { width: 60px; height: 60px; }
        .qr-badge { font-family: 'Courier New', monospace; font-size: 0.75rem; }
        .pagination-container { background: white; border-radius: 10px; }
    </style>
}

<div class="container-fluid py-4">
    <!-- Header Section - Professional for Baby Boomers & Millennials -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2 text-primary fw-bold" style="font-size: 2.2rem;">
                <i class="fas fa-shipping-fast me-3"></i>Purchase Orders Management
            </h1>
            <p class="text-muted mb-0 fs-5">Manage and monitor PO sessions with comprehensive tracking</p>
        </div>
        <div class="col-md-4 text-end d-flex align-items-center justify-content-end">
            <a asp-action="Create" class="btn btn-success btn-lg shadow" style="padding: 12px 24px; font-size: 1.1rem;">
                <i class="fas fa-plus me-2"></i>Create New PO
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Professional Filters Section -->
    <div class="card filter-card shadow mb-4">
        <div class="card-body py-4">
            <div class="row g-4 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">
                        <i class="fas fa-calendar-alt me-1 text-primary"></i>Shipment Date Range
                    </label>
                    <select id="dateFilter" class="form-select form-select-lg">
                        <option value="">All Dates</option>
                        <option value="today">Today</option>
                        <option value="week" selected>This Week</option>
                        <option value="month">This Month</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">
                        <i class="fas fa-boxes me-1 text-primary"></i>Shipment Type
                    </label>
                    <select id="typeFilter" class="form-select form-select-lg">
                        <option value="">All Types</option>
                        <option value="LOOSE">LOOSE</option>
                        <option value="PALLET">PALLET</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">
                        <i class="fas fa-globe me-1 text-primary"></i>Country
                    </label>
                    <select id="countryFilter" class="form-select form-select-lg">
                        <option value="">All Countries</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="applyFilters" class="btn btn-primary btn-lg w-100" style="padding: 12px;">
                        <i class="fas fa-search me-2"></i>Apply Filters
                    </button>
                </div>
            </div>
            <div class="row mt-4" id="customDateRange" style="display: none;">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark">Start Date</label>
                    <input type="date" id="startDate" class="form-control form-control-lg">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark">End Date</label>
                    <input type="date" id="endDate" class="form-control form-control-lg">
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" id="summaryCards">
        <div class="col-md-3">
            <div class="card bg-gradient-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h4 mb-0" id="totalSessions">0</div>
                            <div class="small opacity-75">Total Sessions</div>
                        </div>
                        <i class="fas fa-layer-group fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-gradient-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h4 mb-0" id="totalPOs">0</div>
                            <div class="small opacity-75">Total PCS</div>
                        </div>
                        <i class="fas fa-file-alt fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-gradient-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h4 mb-0" id="totalBoxes">0</div>
                            <div class="small opacity-75">Total Boxes</div>
                        </div>
                        <i class="fas fa-boxes fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-gradient-info text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h4 mb-0" id="completedSessions">0</div>
                            <div class="small opacity-75">Completed</div>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading PO sessions...</p>
    </div>

    <!-- Sessions List -->
    <div id="sessionsList">
        <!-- Sessions will be loaded here dynamically -->
    </div>

    <!-- Pagination -->
    <div class="card pagination-container shadow-sm mt-4" id="paginationContainer" style="display: none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Showing <span id="showingStart">0</span> to <span id="showingEnd">0</span> of <span id="totalItems">0</span> entries
                </div>
                <nav>
                    <ul class="pagination mb-0" id="paginationList">
                        <!-- Pagination items will be generated here -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="card shadow-sm" style="display: none;">
        <div class="card-body text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No PO Sessions Found</h4>
            <p class="text-muted">Start by uploading an Excel file to create your first PO session.</p>
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="fas fa-upload me-2"></i>Upload Excel File
            </a>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Global variables
        let currentPage = 1;
        let pageSize = 12;
        let totalPages = 1;
        let currentFilters = {};
        let allCountries = [];

        // Initialize page
        $(document).ready(function() {
            initializeFilters();
            loadCountries();
            loadPOSessions(1);
            setupEventHandlers();
            
            // Set default date to today
            $('#endDate').val(new Date().toISOString().split('T')[0]);
            let lastWeek = new Date();
            lastWeek.setDate(lastWeek.getDate() - 7);
            $('#startDate').val(lastWeek.toISOString().split('T')[0]);
        });

        // Event handlers
        function setupEventHandlers() {
            $('#dateFilter').change(function() {
                if ($(this).val() === 'custom') {
                    $('#customDateRange').show();
                } else {
                    $('#customDateRange').hide();
                }
            });

            $('#applyFilters').click(function() {
                applyFilters();
            });

            // Auto-apply filters on change (optional)
            $('#typeFilter, #countryFilter').change(function() {
                if ($(this).val() !== '') {
                    applyFilters();
                }
            });
        }

        // Load countries for filter
        async function loadCountries() {
            try {
                const response = await fetch('/PO/GetCountries');
                if (response.ok) {
                    const countries = await response.json();
                    const countrySelect = $('#countryFilter');
                    countries.forEach(country => {
                        countrySelect.append(`<option value="${country}">${country}</option>`);
                    });
                }
            } catch (error) {
                console.log('Could not load countries:', error);
            }
        }

        // Initialize filters with defaults
        function initializeFilters() {
            currentFilters = {
                dateRange: 'week',
                shipmentType: '',
                country: ''
            };
        }

        // Apply filters
        function applyFilters() {
            const dateFilter = $('#dateFilter').val();
            const typeFilter = $('#typeFilter').val();
            const countryFilter = $('#countryFilter').val();
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            currentFilters = {
                dateRange: dateFilter,
                shipmentType: typeFilter,
                country: countryFilter,
                startDate: startDate,
                endDate: endDate
            };

            currentPage = 1;
            loadPOSessions(1);
        }

        // Load PO sessions with pagination and filtering
        async function loadPOSessions(page) {
            showLoading(true);
            
            try {
                const queryParams = new URLSearchParams({
                    page: page,
                    pageSize: pageSize,
                    ...currentFilters
                });

                const response = await fetch(`/PO/GetPaginatedSessions?${queryParams}`);
                if (!response.ok) {
                    throw new Error('Failed to load sessions');
                }

                const data = await response.json();
                currentPage = page;
                totalPages = data.totalPages;

                renderSessions(data.sessions);
                renderPagination(data);
                updateSummaryCards(data.summary);
                
                showLoading(false);
                
            } catch (error) {
                console.error('Error loading sessions:', error);
                showError('Failed to load PO sessions. Please try again.');
                showLoading(false);
            }
        }

        // Render sessions list
        function renderSessions(sessions) {
            const container = $('#sessionsList');
            
            if (!sessions || sessions.length === 0) {
                $('#emptyState').show();
                $('#paginationContainer').hide();
                container.empty();
                return;
            }

            // Filter out sessions without country data (additional frontend validation)
            const validSessions = sessions.filter(session => {
                return session.country && session.country.trim() !== '';
            });

            if (validSessions.length === 0) {
                $('#emptyState').show();
                $('#paginationContainer').hide();
                container.empty();
                return;
            }

            $('#emptyState').hide();
            $('#paginationContainer').show();
            
            let html = '<div class="row">';
            
            validSessions.forEach(session => {
                html += renderSessionCard(session);
            });
            
            html += '</div>';
            container.html(html);

            // Load QR identities dynamically
            validSessions.forEach(session => {
                loadQRIdentity(session.sessionId);
            });
        }

        // Render individual session card
        function renderSessionCard(session) {
            // Skip sessions without country data
            if (!session.country || session.country.trim() === '') {
                return '';
            }

            const progressClass = session.scanProgress >= 100 ? 'bg-success' : 
                                session.scanProgress >= 50 ? 'bg-warning' : 'bg-danger';
            
            const statusBadge = session.scanProgress >= 100 ? 
                '<span class="badge bg-success">Completed</span>' :
                '<span class="badge bg-primary">In Progress</span>';

            // Only show shipment type if it's not null/empty
            const shipmentTypeRow = session.shipmentType && session.shipmentType.trim() !== '' ? `
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Type:</span>
                        <span class="badge bg-secondary">${session.shipmentType}</span>
                    </div>
                </div>
            ` : '';

            return `
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card session-card shadow-sm h-100 fade-in">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0 text-truncate text-white">
                                    <i class="fas fa-file-excel me-2"></i>
                                    ${session.fileName}
                                </h6>
                                ${statusBadge}
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-8">
                                    <div class="small text-muted fw-semibold mb-2">QR Identity</div>
                                    <div class="qr-badge" id="qr-${session.sessionId}">
                                        <i class="fas fa-spinner fa-spin"></i> Loading...
                                    </div>
                                </div>
                                <div class="col-4 text-center">
                                    <div class="progress-ring position-relative d-inline-block">
                                        <div class="progress">
                                            <div class="progress-bar ${progressClass}" 
                                                 style="width: ${session.scanProgress}%;">
                                            </div>
                                        </div>
                                        <div class="position-absolute top-50 start-50 translate-middle">
                                            <small class="fw-bold">${Math.round(session.scanProgress)}%</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="fw-bold text-primary">${session.totalPcs.toLocaleString()}</div>
                                    <small class="text-muted">PCS</small>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold text-success">${session.totalBoxes.toLocaleString()}</div>
                                    <small class="text-muted">Boxes</small>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold text-info">${session.totalPallets}</div>
                                    <small class="text-muted">Pallets</small>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small"><i class="fas fa-globe me-1"></i>Country:</span>
                                    <span class="badge bg-info">${session.country}</span>
                                </div>
                            </div>
                            ${shipmentTypeRow}
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Shipment Date:</span>
                                    <span class="small fw-semibold">${new Date(session.shipmentDate).toLocaleDateString('id-ID')}</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Created:</span>
                                    <span class="small">${new Date(session.createdDate).toLocaleDateString('id-ID')} ${new Date(session.createdDate).toLocaleTimeString('id-ID', {hour: '2-digit', minute: '2-digit'})}</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2">
                                <a href="/Final/Index/${session.sessionId}" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="fas fa-table me-1"></i>View Detail
                                </a>
                                <a href="/Scan/Index?sessionId=${session.sessionId}" class="btn btn-primary btn-sm flex-fill">
                                    <i class="fas fa-qrcode me-1"></i>Scan
                                </a>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="deleteSession(${session.sessionId})">
                                            <i class="fas fa-trash me-2"></i>Delete
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Load QR identity dynamically (similar to QR/Manage)
        async function loadQRIdentity(sessionId) {
            try {
                const response = await fetch(`/QR/GetQRIdentity?sessionId=${sessionId}`);
                if (response.ok) {
                    const data = await response.json();
                    $(`#qr-${sessionId}`).html(data.qrIdentity || 'Not Generated');
                } else {
                    $(`#qr-${sessionId}`).html('Not Available');
                }
            } catch (error) {
                $(`#qr-${sessionId}`).html('Error Loading');
            }
        }

        // Render pagination
        function renderPagination(data) {
            if (data.totalPages <= 1) {
                $('#paginationContainer').hide();
                return;
            }

            $('#paginationContainer').show();
            
            // Update showing text
            const start = ((currentPage - 1) * pageSize) + 1;
            const end = Math.min(currentPage * pageSize, data.totalItems);
            $('#showingStart').text(start);
            $('#showingEnd').text(end);
            $('#totalItems').text(data.totalItems);

            // Generate pagination items
            let paginationHtml = '';
            
            // Previous button
            if (currentPage > 1) {
                paginationHtml += `<li class="page-item"><a class="page-link" href="#" onclick="loadPOSessions(${currentPage - 1})">Previous</a></li>`;
            } else {
                paginationHtml += '<li class="page-item disabled"><span class="page-link">Previous</span></li>';
            }

            // Page numbers
            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            
            if (endPage - startPage < maxVisible - 1) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                const activeClass = i === currentPage ? 'active' : '';
                paginationHtml += `<li class="page-item ${activeClass}"><a class="page-link" href="#" onclick="loadPOSessions(${i})">${i}</a></li>`;
            }

            // Next button
            if (currentPage < totalPages) {
                paginationHtml += `<li class="page-item"><a class="page-link" href="#" onclick="loadPOSessions(${currentPage + 1})">Next</a></li>`;
            } else {
                paginationHtml += '<li class="page-item disabled"><span class="page-link">Next</span></li>';
            }

            $('#paginationList').html(paginationHtml);
        }

        // Update summary cards
        function updateSummaryCards(summary) {
            if (summary) {
                $('#totalSessions').text(summary.totalSessions || 0);
                $('#totalPOs').text((summary.totalPcs || 0).toLocaleString());
                $('#totalBoxes').text((summary.totalBoxes || 0).toLocaleString());
                $('#completedSessions').text(summary.completedSessions || 0);
            }
        }

        // Show/hide loading state
        function showLoading(show) {
            if (show) {
                $('#loadingState').show();
                $('#sessionsList').hide();
                $('#paginationContainer').hide();
                $('#emptyState').hide();
            } else {
                $('#loadingState').hide();
                $('#sessionsList').show();
            }
        }

        // Show error message
        function showError(message) {
            const alertHtml = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.container-fluid').prepend(alertHtml);
        }

        // Delete session
        function deleteSession(sessionId) {
            if (confirm('Are you sure you want to delete this session? This action cannot be undone.')) {
                fetch(`/PO/Delete/${sessionId}`, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            loadPOSessions(currentPage);
                        } else {
                            showError('Failed to delete session');
                        }
                    })
                    .catch(error => {
                        showError('Error deleting session');
                    });
            }
        }

        // Real-time updates for scanning progress (if using SignalR)
        function setupSignalR() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/progressHub")
                .build();

            connection.start().then(function () {
                console.log("SignalR Connected");
            }).catch(function (err) {
                console.error(err.toString());
            });

            connection.on("ScanProgressUpdated", function (sessionId, progress) {
                // Update progress bar dynamically
                const progressBar = $(`.card[data-session-id="${sessionId}"] .progress-bar`);
                const progressText = $(`.card[data-session-id="${sessionId}"] .progress-text`);
                
                if (progressBar.length) {
                    progressBar.css('width', progress + '%');
                    progressText.text(Math.round(progress) + '%');
                    
                    // Update progress bar color
                    progressBar.removeClass('bg-danger bg-warning bg-success');
                    if (progress >= 100) {
                        progressBar.addClass('bg-success');
                    } else if (progress >= 50) {
                        progressBar.addClass('bg-warning');
                    } else {
                        progressBar.addClass('bg-danger');
                    }
                }
            });
        }

        // Call setupSignalR if available
        if (typeof signalR !== 'undefined') {
            setupSignalR();
        }
    </script>
}

            
