@{
    ViewData["Title"] = "Kelola Purchase Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">
            <i class="fas fa-shipping-fast me-2"></i>Kelola Purchase Orders
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Input PO Baru
        </a>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Daftar PO</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Halaman ini akan menampilkan daftar semua Purchase Order yang telah diproses.
                        Gunakan tombol "Input PO Baru" untuk menambahkan data PO dari file Excel.
                    </div>
                    
                    <div class="text-center py-5">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">Belum ada data PO</h4>
                        <p class="text-muted">Mulai dengan mengupload file Excel untuk membuat PO baru.</p>
                        <a asp-action="Create" class="btn btn-primary btn-lg">
                            <i class="fas fa-upload me-2"></i>Upload Excel Sekarang
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
