@model List<ShipmentFinishGood.DTOs.POSessionSummaryDto>
@{
    ViewData["Title"] = "Kelola Purchase Orders";
}
@section Styles {<link rel="stylesheet" href="~/css/po.css" asp-append-version="true" />}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">
            <i class="fas fa-shipping-fast me-2"></i>Kelola Purchase Orders
        </h2>
        <a asp-action="Index" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Input PO Baru
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model?.Any() == true)
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count</div>
                                <div class="small">Total Sessions</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-layer-group fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Sum(s => s.TotalPOs)</div>
                                <div class="small">Total POs</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-file-alt fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Sum(s => s.TotalBoxes).ToString("N0")</div>
                                <div class="small">Total Boxes</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-boxes fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="h5 mb-0">@Model.Count(s => s.ScanProgress >= 100)</div>
                                <div class="small">Completed</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PO Sessions List -->
        <div class="row">
            @foreach (var session in Model)
            {
                <div class="col-lg-12 mb-4">
                    <div class="card shadow-sm border-left-primary">
                        <div class="card-header bg-light">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h5 class="mb-0 text-primary">
                                        <i class="fas fa-file-excel me-2"></i>@session.FileName
                                    </h5>
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>@session.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(session.CreatedBy))
                                        {
                                            <span class="ms-2">
                                                <i class="fas fa-user me-1"></i>@session.CreatedBy
                                            </span>
                                        }
                                    </small>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span class="badge bg-@(session.Status == "QR_GENERATED" ? "success" : session.Status == "PROCESSED" ? "warning" : "secondary") me-2">
                                        @session.Status
                                    </span>
                                    @if (session.HasQRCode)
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-qrcode me-1"></i>QR Ready
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Session Info -->
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <small class="text-muted">Shipment Type:</small>
                                    <div class="fw-bold">
                                        <span class="badge bg-primary">@(session.ShipmentType ?? "LOOSE")</span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Shipment Date:</small>
                                    <div class="fw-bold">@(session.ShipmentDate?.ToString("dd/MM/yyyy") ?? "Not set")</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Total POs:</small>
                                    <div class="fw-bold text-primary">@session.TotalPOs</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Total Qty:</small>
                                    <div class="fw-bold text-success">@session.TotalQty.ToString("N0")</div>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold">Scanning Progress:</span>
                                    <span class="badge bg-@(session.ScanProgress >= 100 ? "success" : session.ScanProgress > 0 ? "warning" : "secondary")">
                                        @session.ProgressStatus
                                    </span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-@(session.ScanProgress >= 100 ? "success" : session.ScanProgress > 0 ? "warning" : "secondary")" 
                                         role="progressbar" 
                                         style="width: @session.ScanProgress%" 
                                         aria-valuenow="@session.ScanProgress" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        @session.ScanProgress.ToString("F1")%
                                    </div>
                                </div>
                                <div class="small text-muted mt-1">
                                    @session.ScannedItems of @session.TotalItemsToScan items scanned
                                </div>
                            </div>

                            <!-- Breakdown Summary -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="text-center p-2 bg-light rounded">
                                        <div class="h6 mb-1 text-success">@session.TotalPallets</div>
                                        <div class="small text-muted">Pallets</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-center p-2 bg-light rounded">
                                        <div class="h6 mb-1 text-warning">@session.TotalBoxes</div>
                                        <div class="small text-muted">Boxes</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-center p-2 bg-light rounded">
                                        <div class="h6 mb-1 text-info">@session.POs.Sum(p => p.QtyPcs)</div>
                                        <div class="small text-muted">PCS</div>
                                    </div>
                                </div>
                            </div>

                            <!-- QR Identity -->
                            @if (session.HasQRCode)
                            {
                                <div class="mb-3">
                                    <small class="text-muted">QR Identity:</small>
                                    <div class="font-monospace small bg-light p-2 rounded">
                                        @session.QRIdentity
                                        <button class="btn btn-outline-secondary btn-sm ms-2" onclick="copyToClipboard('@session.QRIdentity')">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Actions -->
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-controller="Final" asp-action="Index" asp-route-id="@session.SessionId" 
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-table me-1"></i>Final Table
                                </a>
                                
                                @if (session.HasQRCode)
                                {
                                    <a asp-controller="QR" asp-action="Manage" asp-route-id="@session.SessionId" 
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-qrcode me-1"></i>Manage QR
                                    </a>
                                }

                                @if (session.CanStartScanning)
                                {
                                    <button class="btn btn-success btn-sm" onclick="startScanning(@session.SessionId)">
                                        <i class="fas fa-camera me-1"></i>Start Scanning
                                    </button>
                                }

                                <button class="btn btn-outline-secondary btn-sm" type="button" 
                                        data-bs-toggle="collapse" data-bs-target="#details-@session.SessionId">
                                    <i class="fas fa-eye me-1"></i>View Details
                                </button>
                            </div>

                            <!-- Collapsible Details -->
                            <div class="collapse mt-3" id="details-@session.SessionId">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>No PO</th>
                                                <th>Model</th>
                                                <th>Qty</th>
                                                <th>Pallet</th>
                                                <th>Box</th>
                                                <th>PCS</th>
                                                <th>Container</th>
                                                <th>Invoice</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var po in session.POs)
                                            {
                                                <tr>
                                                    <td class="fw-bold">@po.NoPO</td>
                                                    <td><span class="badge bg-primary">@po.ModelProduk</span></td>
                                                    <td class="text-end">@po.QtyTotal.ToString("N0")</td>
                                                    <td class="text-center"><span class="badge bg-success">@po.QtyPallet</span></td>
                                                    <td class="text-center"><span class="badge bg-warning text-dark">@po.QtyBox</span></td>
                                                    <td class="text-center"><span class="badge bg-info">@po.QtyPcs</span></td>
                                                    <td class="small">@po.Container</td>
                                                    <td class="small">@po.NoInvoice</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Daftar PO Sessions</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Belum ada data PO</h4>
                            <p class="text-muted">Mulai dengan mengupload file Excel untuk membuat PO baru.</p>
                            <a asp-action="Create" class="btn btn-primary btn-lg">
                                <i class="fas fa-upload me-2"></i>Upload Excel Sekarang
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/po.js" asp-append-version="true"></script>
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showAlert('QR Identity copied to clipboard!', 'success');
            }, function(err) {
                console.error('Could not copy text: ', err);
                showAlert('Failed to copy to clipboard', 'danger');
            });
        }

        function startScanning(sessionId) {
            // TODO: Implement scanning functionality
            // This could redirect to a scanning page or open a modal
            showAlert('Scanning feature will be implemented next', 'info');
        }

        function showAlert(message, type) {
            const alertContainer = document.querySelector('.container');
            const alertElement = document.createElement('div');

            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            alertElement.setAttribute('role', 'alert');
            alertElement.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-circle'} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            alertContainer.insertBefore(alertElement, alertContainer.children[1]);

            setTimeout(() => {
                alertElement.remove();
            }, 5000);
        }

        // Auto-refresh progress every 30 seconds
        setInterval(function() {
            // In production, you might want to refresh progress via AJAX
            console.log('Checking progress updates...');
        }, 30000);
    </script>
}
