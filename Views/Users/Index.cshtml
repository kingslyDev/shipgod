@model ShipmentFinishGood.ViewModels.PagedResultViewModel<ShipmentFinishGood.DTOs.UserDto>
@using ShipmentFinishGood.Domain;
@{
    ViewData["Title"] = "Manajemen User";
}
@section Styles {<link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />}

<div id="userPage" class="user-index">
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
    <div class="flex-grow-1" style="min-width:260px;">
        <h1 class="h4 fw-bold mb-1 text-primary"><i class="fas fa-users me-2"></i>Manajemen User</h1>
        <form method="get" class="position-relative" autocomplete="off">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input name="search" value="@Model.Search" class="form-control ps-5" placeholder="Cari username / nama / role" />
            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted"><i class="fas fa-search"></i></span>
        </form>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-primary" asp-action="Create"><i class="fas fa-user-plus me-2"></i>Tambah</a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">@Model.PageSize / Halaman</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach(var size in new[]{5,10,20,50}){
                    <li><a class="dropdown-item @(Model.PageSize==size?"active fw-bold":"")" href="?page=1&pageSize=@size&search=@Model.Search">@size</a></li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="table-responsive shadow-sm border rounded bg-white">
    <table class="table table-hover align-middle mb-0" id="usersTable">
        <thead class="table-light">
            <tr>
                <th scope="col">Username</th>
                <th scope="col">Nama</th>
                <th scope="col">Role</th>
                <th scope="col" class="text-nowrap">Dibuat</th>
                <th scope="col" class="text-end">Aksi</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var u in Model.Items)
        {
            <tr>
                <td class="fw-semibold">@u.Username</td>
                <td>@u.Name</td>
                <td>
                    <span class="badge rounded-pill bg-primary-light text-primary fw-semibold" style="font-size:.75rem;">
                        <i class="fas fa-key me-1"></i>@u.Role
                    </span>
                </td>
                <td class="text-muted small" data-value="@u.CreatedAt.ToString("O")">@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-sm btn-primary me-1" aria-label="Edit @u.Username"><i class="fas fa-edit"></i></a>
                    <a asp-action="Delete" asp-route-id="@u.UserId" class="btn btn-sm btn-danger" aria-label="Hapus @u.Username" onclick="return confirm('Yakin hapus user @u.Username ?');"><i class="fas fa-trash-alt"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if(!Model.Items.Any()){
    <div class="alert alert-info small mb-0 mt-3"><i class="fas fa-info-circle me-1"></i>Tidak ada data.</div>
}

<nav class="mt-3" aria-label="Navigasi halaman user">
    <ul class="pagination pagination-sm mb-0 flex-wrap">
        <li class="page-item @(Model.HasPrev?"":"disabled")">
            <a class="page-link" href="?page=@(Model.Page-1)&pageSize=@Model.PageSize&search=@Model.Search" aria-label="Sebelumnya">&laquo;</a>
        </li>
        @for(int i=1;i<=Model.TotalPages;i++){
            if(i==1 || i==Model.TotalPages || Math.Abs(i-Model.Page)<=2){
                <li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" href="?page=@i&pageSize=@Model.PageSize&search=@Model.Search">@i</a></li>
            } else if(Math.Abs(i-Model.Page)==3){
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
        }
        <li class="page-item @(Model.HasNext?"":"disabled")">
            <a class="page-link" href="?page=@(Model.Page+1)&pageSize=@Model.PageSize&search=@Model.Search" aria-label="Berikutnya">&raquo;</a>
        </li>
    </ul>
    <div class="small text-muted mt-2">Menampilkan @Model.Items.Count() dari @Model.Total user • Halaman @Model.Page / @Model.TotalPages</div>
</nav>

</div> <!-- /#userPage -->

@section Scripts { <script src="~/js/user.js" asp-append-version="true"></script> }
